def build_delaunay_graph_distances(coords: np.ndarray) -> tuple[np.ndarray, int, str]:
    """Return all-pairs shortest path lengths on a spatial neighborhood graph.

    A Delaunay triangulation is used as the cell-cell neighborhood network
    because the h5ad file does not contain a precomputed graph.  Edges are
    treated as unit graph steps, so D[j, k] is the topological path length.
    """
    n = coords.shape[0]
    if n < 2:
        return np.full((n, n), np.inf, dtype=float), 0, "none_single_cell"

    edges: set[tuple[int, int]] = set()
    graph_method = "delaunay"
    if n == 2:
        edges.add((0, 1))
        graph_method = "single_edge"
    else:
        try:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                tri = Delaunay(coords)
            for simplex in tri.simplices:
                for a, b in ((simplex[0], simplex[1]), (simplex[1], simplex[2]), (simplex[2], simplex[0])):
                    if a == b:
                        continue
                    if a > b:
                        a, b = b, a
                    edges.add((int(a), int(b)))
        except (QhullError, ValueError):
            

... [797 characters truncated] ...

aph, directed=False, unweighted=True)
    return distances, len(edges), graph_method


def spatial_weighted_expression(Y: np.ndarray, coords: np.ndarray) -> tuple[np.ndarray, dict[str, object]]:
    D, n_edges, graph_method = build_delaunay_graph_distances(coords)
    np.fill_diagonal(D, np.inf)
    with np.errstate(divide="ignore", invalid="ignore"):
        W = np.where(np.isfinite(D), 1.0 / D, 0.0)
    W[~np.isfinite(W)] = 0.0
    row_sums = W.sum(axis=1)
    nonzero_rows = row_sums > 0
    W[nonzero_rows, :] = W[nonzero_rows, :] / row_sums[nonzero_rows, None]
    S = W @ Y
    info = {
        "graph_method": graph_method,
        "n_edges": int(n_edges),
        "mean_degree": float(2 * n_edges / coords.shape[0]) if coords.shape[0] else np.nan,
        "n_zero_weight_rows": int((~nonzero_rows).sum()),
    }
    return S, info


def t_statistics_for_genes(Y: np.ndarray, S: np.ndarray, C: np.ndarray) -> tuple[np.ndarray, int]:
    """Vectorized t-statistics for beta_spatial in Y_g ~ S_g + C."""
    n, g = Y.shape
    if C.size:
        U, singular_values, _ = np.linalg.svd(C, full_matrices=False)
        rank = int((singular_values > (1e-10 * singular_values[0] if singular_values.size else 0.0)).sum())
        Q = U[:, :rank]
        Yr = Y - Q @ (Q.T @ Y)
        Sr = S - Q @ (Q.T @ S)
    else:
        rank = 0
        Yr = Y.copy()
        Sr = S.copy()

    df_residual = n - rank - 1
    if df_residual <= 0:
        return np.full(g, np.nan, dtype=float), df_residual



