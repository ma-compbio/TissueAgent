  1. {'name': 'write_file', 'args': {'file_path': '/project/outputs/scripts/measure_reference_and_inspect.py', 'content': '#!/usr/bin/env python3\nfrom pathlib import Path\nimport pandas as pd\nfrom PIL import Image\nimport numpy as np\n\nref_path = Path(\'project/uploads/reference_lohoff-2e.png\')\nimg = Image.open(ref_path).convert(\'RGB\')\narr = np.array(img)\nh,w = arr.shape[:2]\nprint(\'reference size:\', w,h)\n# identify dark horizontal/vertical axis line approximate\nmask_dark = (arr[:,:,0]<80)&(arr[:,:,1]<80)&(arr[:,:,2]<80)\n# count dark pixels per row/col, focusing not text? whole image, axis horizontal long row\nrow_counts = mask_dark.sum(axis=1)\ncol_counts = mask_dark.sum(axis=0)\nprint(\'top dark rows:\', sorted([(int(c),i) for i,c in enumerate(row_counts)], reverse=True)[:10])\nprint(\'top dark cols:\', sorted([(int(c),i) for i,c in enumerate(col_counts)], reverse=True)[:10])\n# try x axis row = row with many dark pixels in mid/right excluding labels\nfor y in np.argsort(row_counts)[-10:][::-1]:\n    xs=np.where(mask_dark[y])[0]\n    if len(xs): print(\'row\',int(y),\'n\',len(xs),\'span\',int(xs.min()),int(xs.max()))\nfor x in np.argsort(col_counts)[-10:][::-1]:\n    ys=np.where(mask_dark[:,x])[0]\n    if len(ys): print(\'col\',int(x),\'n\',len(ys),\'span\',int(ys.min()),int(ys.max()))\n\nlong = pd.read_csv(\'project/outputs/tables/lohoff_2e_t_statistics_long.csv\')\navg = pd.read_csv(\'project/outputs/tables/lohoff_2e_average_t_statistics.csv\')\nprint(\'long rows/cols:\', long.shape)\nprint(\'avg rows:\', avg.shape)\nprint(\'t range:\', long[\'t_statistic\'].min(), long[\'t_statistic\'].max())\nprint(\'sorted display categories:\')\nprint(\'\\n\'.join([f"{i+1}. {r.cell_type_display} avg={r.average_t_statistic:.3f}" for i,r in avg.sort_values(\'order_rank\').iterrows()]))\n\n# Target category order as read manually from reference, for sampling only.\ntarget_order = [\n    \'Forebrain/Midbrain/Hindbrain\',\'Gut tube\',\'Spinal cord\',\'Splanchnic mesoderm\',\'Neural crest\',\n    \'Surface ectoderm\',\'Lateral plate mesoderm\',\'Mesenchyme\',\'Endothelium\',\'Haematoendothelial progenitors\',\n    \'Dermomyotome\',\'Cranial mesoderm\',\'Cardiomyocytes\',\'Intermediate mesoderm\',\'Presomitic mesoderm\',\n    \'Anterior somitic tissues\',\'Sclerotome\',\'Erythroid\',\'Allantois\',\'NMP\',\'Definitive endoderm\',\'Blood progenitors\'\n]\n# axis estimates from line detection/visual read\nx_left, x_right = 229, 1269\nx_centers = np.linspace(x_left, x_right, len(target_order))\ny0,y1 = 45,323\n\ndef rgb_to_hex(rgb):\n    rgb = np.clip(np.round(rgb).astype(int),0,255)\n    return \'#%02x%02x%02x\' % tuple(rgb)\n\nmeasured=[]\nfor lab,xc in zip(target_order,x_centers):\n    xi=int(round(xc))\n    crop=arr[y0:y1, max(0,xi-19):min(w,xi+20), :]\n    # select colored non-background, avoiding black outlines/text and near-white\n    R,G,B = crop[:,:,0],crop[:,:,1],crop[:,:,2]\n    maxc=crop.max(axis=2); minc=crop.min(axis=2)\n    sat = maxc-minc\n    m = (maxc < 245) & (sat > 18) & (minc > 25)\n    pix = crop[m]\n    if pix.size == 0:\n        med = np.array([180,180,180])\n        n=0\n    else:\n        # robust center: use median, then trim far pixels and re-median\n        med0=np.median(pix,axis=0)\n        dist=np.linalg.norm(pix.astype(float)-med0,axis=1)\n        pix2=pix[dist <= np.percentile(dist,70)] if len(pix)>10 else pix\n        med=np.median(pix2,axis=0)\n        n=len(pix)\n    measured.append((lab, float(xc), rgb_to_hex(med), int(n)))\nprint(\'measured target colors:\')\nfor row in measured:\n    print(row)\n\n# map reference colors by label, with dataset display names\nref_palette={lab:hexv for lab,xc,hexv,n in measured}\n# report missing/mismatched\nplot_order=list(avg.sort_values(\'order_rank\')[\'cell_type_display\'])\nprint(\'palette labels missing for plot categories:\', [c for c in plot_order if c not in ref_palette])\nprint(\'reference labels absent from plot categories:\', [c for c in target_order if c not in plot_order])\n'}, 'id': 'call_25wRvRC2iNPyAt2cjfXGBysQ', 'type': 'tool_call'}

