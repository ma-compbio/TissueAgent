  1. {'name': 'execute', 'args': {'command': "python3 - <<'PY'\nimport anndata as ad, numpy as np, pandas as pd, re\nfrom scipy.spatial.distance import cdist\nadata=ad.read_h5ad('library/datasets/dataset_lohoff_et_al_seqfish.h5ad')\nX=adata.X.toarray().astype(np.float64) if hasattr(adata.X,'toarray') else np.asarray(adata.X,dtype=float)\ncoords=np.asarray(adata.obsm['spatial'],float)\nct=adata.obs['celltype_mapped_refined'].astype(str).values\nnames=adata.obs_names.astype(str)\nz=np.array([int(re.search(r'_z(\\d+)$', n).group(1)) for n in names])\npos=np.array([int(re.search(r'_Pos(\\d+)_', n).group(1)) for n in names])\n\ndef tstats(Y,S,C):\n    n,g=Y.shape\n    # drop constant/duplicate columns in C via QR pivot? np qr no pivot; use svd rank to get Q\n    U,s,Vt=np.linalg.svd(C, full_matrices=False)\n    rank=(s>1e-10*s[0]).sum() if len(s) else 0\n    Q=U[:,:rank]\n    Yr=Y-Q@(Q.T@Y) if rank else Y.copy()\n    Sr=S-Q@(Q.T@S) if rank else S.copy()\n    yc=Yr # already centered if intercept in C\n    sc=Sr\n    num=(yc*sc).sum(0)\n    yss=(yc*yc).sum(0); sss=(sc*sc).sum(0)\n    r=num/np.sqrt(yss*sss)\n    r=np.clip(r, -0.999999999, 0.999999999)\n    df=n-rank-1\n    t=r*np.sqrt(df/np.maximum(1-r*r,1e-15))\n    return t\n\ndef residual_cov(indices, include_pos=False):\n    cols=[np.ones(len(indices))]\n    zz=z[indices]\n    for val in sorted(set(zz))[1:]: cols.append((zz==val).astype(float))\n    if include_pos:\n        pp=pos[indices]\n        for val in sorted(set(pp))[1:]: cols.append((pp==val).astype(float))\n    return np.column_stack(cols)\n\ndef spatial_cov(indices, within_z=False, normalize=True):\n    n=len(indices); Y=X[indices]\n    S=np.zeros_like(Y)\n    if within_z:\n        for zv in sorted(set(z[indices])):\n            loc=np.where(z[indices]==zv)[0]\n            if len(loc)<2: continue\n            D=cdist(coords[indices][loc], coords[indices][loc])\n            np.fill_diagonal(D, np.inf)\n            W=1/np.maximum(D,1e-12); W[~np.isfinite(W)]=0\n            if normalize:\n                rs=W.sum(1); W=W/np.where(rs[:,None]>0, rs[:,None], 1)\n            S[loc]=W@Y[loc]\n    else:\n        D=cdist(coords[indices], coords[indices])\n        np.fill_diagonal(D, np.inf)\n        W=1/np.maximum(D,1e-12); W[~np.isfinite(W)]=0\n        if normalize:\n            rs=W.sum(1); W=W/np.where(rs[:,None]>0, rs[:,None], 1)\n        S=W@Y\n    return S\n\nvariants=[]\nfor within_z in [False, True]:\n  for include_pos in [False, True]:\n    av=[]; mins=[]; maxs=[]\n    for ctype in pd.Series(ct).value_counts().index:\n        idx=np.where(ct==ctype)[0]\n        if len(idx)<5: continue\n        Y=X[idx]\n        S=spatial_cov(idx,within_z=within_z,normalize=True)\n        C=residual_cov(idx, include_pos=include_pos)\n        t=tstats(Y,S,C)\n        av.append((ctype,np.nanmean(t),np.nanmedian(t),np.nanmax(t)))\n    df=pd.DataFrame(av,columns=['ct','mean','median','max']).sort_values('mean',ascending=False)\n    print('\\nVAR within_z',within_z,'include_pos',include_pos)\n    print(df.to_string(index=False, max_rows=25, float_format=lambda x:f'{x:.2f}'))\nPY", 'timeout': 300}, 'id': 'call_qm9jEIZQrdy05bDGYMwIDtN9', 'type': 'tool_call'}

