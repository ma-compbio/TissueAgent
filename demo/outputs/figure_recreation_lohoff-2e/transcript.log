[2] (function_call) {'type': 'function_call', 'name': 'execute', 'arguments': '{"command":"python3 - <<\'PY\'\\nimport anndata as ad, numpy as np, pandas as pd, re\\nfrom scipy.spatial import Delaunay\\nfrom scipy.sparse import coo_matrix\\nadata=ad.read_h5ad(\'library/datasets/dataset_lohoff_et_al_seqfish.h5ad\')\\nX=adata.X.toarray().astype(np.float64); coords=adata.obsm[\'spatial\']; ct=adata.obs[\'celltype_mapped_refined\'].astype(str).values; names=adata.obs_names.astype(str); z=np.array([int(re.search(r\'_z(\\\\d+)$\',n).group(1)) for n in names])\\nn=len(ct); row=[]; col=[]; data=[]; edges=set(); tri=Delaunay(coords)\\nfor simp in tri.simplices:\\n for a,b in [(simp[0],simp[1]),(simp[1],simp[2]),(simp[2],simp[0])]:\\n  if a>b: a,b=b,a\\n  edges.add((a,b))\\nfor a,b in edges:\\n d=np.linalg.norm(coords[a]-coords[b]); w=1/max(d,1e-12); row += [a,b]; col += [b,a]; data += [w,w]\\nW=coo_matrix((data,(row,col)), shape=(n,n)).tocsr(); rs=np.array(W.sum(1)).ravel(); W=W.multiply(1/np.where(rs>0,rs,1)[:,None]); S_all=W@X\\nprint(\'edges\',len(edges),\'avg degree\',2*len(edges)/n)\\ndef tstats(Y,S,C):\\n U,s,Vt=np.linalg.svd(C,full_matrices=False); rank=(s>1e-10*s[0]).sum(); Q=U[:,:rank]\\n Yr=Y-Q@(Q.T@Y); Sr=S-Q@(Q.T@S); num=(Yr*Sr).sum(0); yss=(Yr*Yr).sum(0); sss=(Sr*Sr).sum(0); r=num/np.sqrt(yss*sss); r=np.clip(r,-.999999999,.999999999); df=Y.shape[0]-rank-1; return r*np.sqrt(df/np.maximum(1-r*r,1e-15))\\nout=[]\\nfor c in pd.Series(ct).value_counts().index:\\n idx=np.where(ct==c)[0]; Y=X[idx]; S=S_all[idx]; cols=[np.ones(len(idx))]; zz=z[idx]\\n for val in sorted(set(zz))[1:]: cols.append((zz==val).astype(float))\\n t=tstats(Y,S,np.column_stack(cols)); out.append((c,np.nanmean(t),np.nanmedian(t),np.nanmax(t)))\\nprint(pd.DataFrame(out,columns=[\'ct\',\'mean\',\'median\',\'max\']).sort_values(\'mean\',ascending=False).to_string(index=False,float_format=lambda x:f\'{x:.2f}\'))\\nPY","timeout":300}', 'call_id': 'call_jeen6vsAfRpuM199bCFn1RYb', 'id': 'fc_08320d9520507