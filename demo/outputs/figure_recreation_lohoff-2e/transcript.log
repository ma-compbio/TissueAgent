361  DEFAULT_PALETTE = [   # Okabe-Ito (colorblind-safe) then tab10 -- only as tier 5
362      "#e69f00", "#56b4e9", "#009e73", "#f0e442", "#0072b2", "#d55e00", "#cc79a7",
363      "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#e377c2",
364      "#7f7f7f", "#bcbd22", "#17becf", "#aec7e8", "#ffbb78", "#98df8a",
365  ]
366  
367  
368  def _extra_distinct_colors(n: int, avoid: list) -> list:
369      """Generate *n* colors spaced away from those already in *avoid*.
370  
371      Walks the hue circle at an irrational-ish step so successive colors land far
372      apart, and skips any hue too close to a color already in use.
373      """
374      import colorsys
375  
376      def _far_enough(hexv: str) -> bool:
377          r1, g1, b1 = (int(hexv[i:i + 2], 16) for i in (1, 3, 5))
378          for o in avoid + out:
379              r2, g2, b2 = (int(o[i:i + 2], 16) for i in (1, 3, 5))
380              if (r1 - r2) ** 2 + (g1 - g2) ** 2 + (b1 - b2) ** 2 < 3000:
381                  return False
382          return True
383  
384      out: list = []
385      h = 0.0
386      for _ in range(n * 40):
387          if len(out) == n:
388              break
389          h = (h + 0.61803398875) % 1.0          # golden-ratio hue stepping
390          for s_, v_ in ((0.65, 0.85), (0.85, 0.60), (0.45, 0.95)):
391              cand = "#%02x%02x%02x" % tuple(
392                  int(255 * c) for c in colorsys.hsv_to_rgb(h, s_, v_))
393              if _far_enough(cand):
394                  out.append(cand)
395                  break
396      while len(out) < n:                        # last resort: never return short
397          out.append("#%02x%02x%02x" % (60 + 7 * len(out) % 180, 60, 120))
398      return out
399  
400  
401  def main() -> int:
402      ap = argparse.ArgumentParser(
403          description="Build one colormap.yaml from the most trustworthy source available.",
404          formatter_class=argparse.RawDescriptionHelpFormatter)
405      ap.add_argument("-o", "--out", default="colormap.yaml", help="output path")
406      ap.add_argument("--dataset", help=".h5ad providing categories + order (and maybe colors)")
407      ap.add_argument("--key", help="obs column holding the categories")
408      ap.add_argument("--palette", help="an existing palette file (tier 1, wins outright)")
409      ap.add_argument("--reference", help="reference figure to read a legend from")
410      ap.add_argument("--legend-box", help="x0,y0,x1,y1 of the legend in --reference")
411      ap.add_argument("--verify", metavar="FILE", default=None,
412                      help="check FILE carries a valid provenance stamp, then exit")
413      ap.add_argument("--allow-default", action="store_true",
414                      help="permit the tier-5 default palette instead of failing")
415      ap.add_argument("--json", action="store_true", help="also print the result as JSON")
416      args = ap.parse_args()
417  
418      if args.verify:
419          ok, msg = verify_colormap(args.verify)
420          sys.stdout.write(("OK: " if ok else "FAIL: ") + msg + "\n")
421          return 0 if ok else 1
422  
423      warnings: list[str] = []
424      order: list[str] = []
425      order_from = None
426  
427      # ---- categories + order (independent of the color source) ----
428      ds_colors = None
429      if args.dataset:
430          cats, ds_colors, key_used, note = from_dataset(args.dataset, args.key)
431          if cats:
432              order, order_from = cats, f"dataset obs['{key_used}'] ({note})"
433          else:
434              warnings.append(f"dataset gave no categories: {note}")
435  
436      mapping: dict = {}
437      tier = how = None
438  
439      try:
440          legend_box = _parse_box_arg(args.legend_box) if args.reference else None
441      except ValueError:
442          sys.stderr.write("ERROR: --legend-box expects x0,y0,x1,y1\n")
443          return 2
444  
445      # ---- tier 1: a supplied palette wins outright ----
446      if args.palette:
447          if not os.path.exists(args.palette):
448              sys.stderr.write(f"ERROR: --palette '{args.palette}' not found\n")
449              return 2
450          supplied = read_simple_yaml(args.palette)
