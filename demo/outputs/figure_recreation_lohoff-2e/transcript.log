[2] (function_call) {'type': 'function_call', 'name': 'write_file', 'arguments': '{"file_path":"/project/outputs/scripts/compute_lohoff_2e_stats.py","content":"#!/usr/bin/env python3\\n\\"\\"\\"Compute Lohoff et al. Figure 2e spatial-heterogeneity t-statistics.\\n\\nInputs are read from the staged workspace. Outputs are written under\\nproject/outputs/tables and project/outputs/reports.\\n\\"\\"\\"\\n\\nfrom __future__ import annotations\\n\\nimport re\\nimport warnings\\nfrom pathlib import Path\\n\\nimport anndata as ad\\nimport numpy as np\\nimport pandas as pd\\nfrom scipy.sparse import issparse\\nfrom scipy.sparse import coo_matrix\\nfrom scipy.sparse.csgraph import shortest_path\\nfrom scipy.spatial import Delaunay, QhullError\\nfrom sklearn.neighbors import NearestNeighbors\\n\\nDATASET = Path(\\"library/datasets/dataset_lohoff_et_al_seqfish.h5ad\\")\\nOUT_TABLE_DIR = Path(\\"project/outputs/tables\\")\\nOUT_REPORT_DIR = Path(\\"project/outputs/reports\\")\\nLONG_OUT = OUT_TABLE_DIR / \\"lohoff_2e_t_statistics_long.csv\\"\\nSUMMARY_OUT = OUT_TABLE_DIR / \\"lohoff_2e_average_t_statistics.csv\\"\\nREPORT_OUT = OUT_REPORT_DIR / \\"lohoff_2e_statistical_method_summary.md\\"\\n\\nCELLTYPE_COL = \\"celltype_mapped_refined\\"\\nSPATIAL_KEY = \\"spatial\\"\\nNAME_RE = re.compile(r\\"^(?P<embryo>embryo\\\\d+)_Pos(?P<position>\\\\d+)_cell(?P<cell>\\\\d+)_z(?P<z>\\\\d+)$\\")\\n\\n# Plot-facing aliases only; the original annotation is retained in `cell_type`.\\nDISPLAY_ALIASES = {\\n    \\"Mixed mesenchymal mesoderm\\": \\"Mesenchyme\\",\\n}\\n\\n\\ndef parse_obs_names(obs_names: pd.Index) -> pd.DataFrame:\\n    rows = []\\n    bad = []\\n    for name in obs_names.astype(str):\\n        match = NAME_RE.match(name)\\n        if match is None:\\n            bad.append(name)\\n            rows.append({\\"embryo\\": np.nan, \\"position\\": np.nan, \\"cell_id_from_name\\": np.nan, \\"z_slice\\": np.nan})\\n        else:\\n            gd = match.groupdict()\\n            rows.append(\\n                {\\n                    \\"embryo\\": gd[\\"embryo\\"],\\n                    \\"position\\": int(gd[\\"position\\"]),\\n                    \\"cell_id_from_name\\": int(gd[\\"cell\\"]),\\n                    \\"z_slice\\": f\\"z{gd[\'z\']}\\",\\n                }\\n            )\\n    if bad:\\n        raise ValueError(f\\"Could not parse embryo/z metadata from {len(bad)} observation names; first: {bad[:3]}\\")\\n    return pd.DataFrame(rows, index=obs_names)\\n\\n\\ndef one_hot_drop_first(values: pd.Series, prefix: str) -> pd.DataFrame:\\n    dummies = pd.get_dummies(values.astype(str), prefix=prefix, drop_first=True, dtype=float)\\n    return dummies\\n\\n\\ndef make_covariate_design(meta: pd.DataFrame) -> tuple[np.ndarray, list[str], int]:\\n    \\"\\"\\"Design matrix for non-spatial covariates in the requested model.\\n\\n    The instructions specify embryo, z slice, and embryo:z.  Terms that are\\n    constant or linearly dependent in this staged data are retained conceptually\\n    but removed by an SVD rank reduction during residualization.\\n    \\"\\"\\"\\n    pieces = [pd.DataFrame({\\"intercept\\": np.ones(meta.shape[0], dtype=float)}, index=meta.index)]\\n    conceptual_terms = [\\"intercept\\"]\\n\\n    if meta[\\"embryo\\"].nunique() > 1:\\n        emb = one_hot_drop_first(meta[\\"embryo\\"], \\"embryo\\")\\n        pieces.append(emb)\\n        conceptual_terms.extend(emb.columns.tolist())\\n\\n    if meta[\\"z_slice\\"].nunique() > 1:\\n        z = one_hot_drop_first(meta[\\"z_slice\\"], \\"z\\")\\n        pieces.append(z)\\n        conceptual_terms.extend(z.columns.tolist())\\n\\n    if meta[\\"embryo\\"].nunique() > 1 and meta[\\"z_slice\\"].nunique() > 1:\\n        interaction_values = meta[\\"embryo\\"].astype(str) + \\":\\" + meta[\\"z_slice\\"].astype(str)\\n        ez = one_hot_drop_first(interaction_values, \\"embryo_z\\")\\n        pieces.append(ez)\\n        conceptual_terms.extend(ez.columns.tolist())\\n\\n    C = pd.concat(pieces, axis=1).to_numpy(dtype=float)\\n    # Numeric rank used as degrees of freedom consumed by non-spatial covariates.\\n    if C.size == 0:\\n        rank = 0\\n    else:\\n        s = np.linalg.svd(C, compute_uv=False, full_matrices=False)\\n        rank = int((s > (1e-10 * s[0] if s.size else 0.0)).sum())\\n    return C, conceptual_terms, rank\\n\\n\\ndef build_delaunay_graph_distances(coords: np.ndarray) -> tuple[np.ndarray, int, str]:\\n    \\"\\"\\"Return all-pairs shortest path lengths on a spatial neighborhood graph.\\n\\n    A Delaunay triangulation is used as the cell-cell neighborhood network\\n    because the h5ad file does not contain a precomputed graph.  Edges are\\n    treated as unit graph steps, so D[j, k] is the topological path length.\\n    \\"\\"\\"\\n    n = coords.shape[0]\\n    if n < 2:\\n        return np.full((n, n), np.inf, dtype=float), 0, \\"none_single_cell\\"\\n\\n    edges: set[tuple[int, int]] = set()\\n    graph_method = \\"delaunay\\"\\n    if n == 2:\\n        edges.add((0, 1))\\n        graph_method = \\"single_edge\\"\\n    else:\\n        try:\\n            with warnings.catch_warnings():\\n                warnings.simplefilter(\\"ignore\\")\\n                tri = Delaunay(coords)\\n            for simplex in tri.simplices:\\n                for a, b in ((simplex[0], simplex[1]), (simplex[1], simplex[2]), (simplex[2], simplex[0])):\\n                    if a == b:\\n                        continue\\n                    if a > b:\\n                        a, b = b, a\\n                    edges.add((int(a), int(b)))\\n        except (QhullError, ValueError):\\n            # Robust fallback for degenerate coordinates: symmetric kNN graph.\\n            graph_method = \\"knn_fallback\\"\\n            k = min(6, n - 1)\\n            nbrs = NearestNeighbors(n_neighbors=k + 1).fit(coords)\\n            _, ind = nbrs.kneighbors(coords)\\n            for i in range(n):\\n                for j in ind[i, 1:]:\\n                    a, b = (i, int(j)) if i < int(j) else (int(j), i)\\n                    edges.add((a, b))\\n\\n    if not edges:\\n        return np.full((n, n), np.inf, dtype=float), 0, graph_method\\n\\n    row: list[int] = []\\n    col: list[int] = []\\n    data: list[float] = []\\n    for a, b in edges:\\n        row.extend((a, b))\\n        col.extend((b, a))\\n        data.extend((1.0, 1.0))\\n    graph = coo_matrix((data, (row, col)), shape=(n, n)).tocsr()\\n    distances = shortest_path(graph, directed=False, unweighted=True)\\n    return distances, len(edges), graph_method\\n\\n\\ndef spatial_weighted_expression(Y: np.ndarray, coords: np.ndarray) -> tuple[np.ndarray, dict[str, object]]:\\n    D, n_edges, graph_method = build_delaunay_graph_distances(coords)\\n    np.fill_diagonal(D, np.inf)\\n    with np.errstate(divide=\\"ignore\\", invalid=\\"ignore\\"):\\n        W = np.where(np.isfinite(D), 1.0 / D, 0.0)\\n    W[~np.isfinite(W)] = 0.0\\n    row_sums = W.sum(axis=1)\\n    nonzero_rows = row_sums > 0\\n    W[nonzero_rows, :] = W[nonzero_rows, :] / row_sums[nonzero_rows, None]\\n    S = W @ Y\\n    info = {\\n        \\"graph_method\\": graph_method,\\n        \\"n_edges\\": int(n_edges),\\n        \\"mean_degree\\": float(2 * n_edges / coords.shape[0]) if coords.shape[0] else np.nan,\\n        \\"n_zero_weight_rows\\": int((~nonzero_rows).sum()),\\n    }\\n    return S, info\\n\\n\\ndef t_statistics_for_genes(Y: np.ndarray, S: np.ndarray, C: np.ndarray) -> tuple[np.ndarray, int]:\\n    \\"\\"\\"Vectorized t-statistics for beta_spatial in Y_g ~ S_g + C.\\"\\"\\"\\n    n, g = Y.shape\\n    if C.size:\\n        U, singular_values, _ = np.linalg.svd(C, full_matrices=False)\\n        rank = int((singular_values > (1e-10 * singular_values[0] if singular_values.size else 0.0)).sum())\\n        Q = U[:, :rank]\\n        Yr = Y - Q @ (Q.T @ Y)\\n        Sr = S - Q @ (Q.T @ S)\\n    else:\\n        rank = 0\\n        Yr = Y.copy()\\n        Sr = S.copy()\\n\\n    df_residual = n - rank - 1\\n    if df_residual <= 0:\\n        return np.full(g, np.nan, dtype=float), df_residual\\n\\n    sss = np.sum(Sr * Sr, axis=0)\\n    numerator = np.sum(Sr * Yr, axis=0)\\n    beta = np.full(g, np.nan, dtype=float)\\n    valid = sss > 0\\n    beta[valid] = numerator[valid] / sss[valid]\\n\\n    residuals = Yr - Sr * beta[None, :]\\n    rss = np.sum(residuals * residuals, axis=0)\\n    sigma2 = rss / df_residual\\n    se = np.full(g, np.nan, dtype=float)\\n    se_valid = valid & (sigma2 > 0)\\n    se[se_valid] = np.sqrt(sigma2[se_valid] / sss[se_valid])\\n\\n    tvals = np.full(g, np.nan, dtype=float)\\n    tvals[se_valid] = beta[se_valid] / se[se_valid]\\n    return tvals, df_residual\\n\\n\\ndef main() -> None:\\n    OUT_TABLE_DIR.mkdir(parents=True, exist_ok=True)\\n    OUT_REPORT_DIR.mkdir(parents=True, exist_ok=True)\\n\\n    adata = ad.read_h5ad(DATASET)\\n    if CELLTYPE_COL not in adata.obs:\\n        raise KeyError(f\\"Expected observation column {CELLTYPE_COL!r} was not found\\")\\n    if SPATIAL_KEY not in adata.obsm:\\n        raise KeyError(f\\"Expected adata.obsm[{SPATIAL_KEY!r}] spatial coordinates were not found\\")\\n\\n    X = adata.X.toarray() if issparse(adata.X) else np.asarray(adata.X)\\n    X = X.astype(np.float64, copy=False)\\n    coords_all = np.asarray(adata.obsm[SPATIAL_KEY], dtype=float)\\n    parsed = parse_obs_names(adata.obs_names)\\n    obs = adata.obs.copy()\\n    obs = pd.concat([obs, parsed], axis=1)\\n    obs[CELLTYPE_COL] = obs[CELLTYPE_COL].astype(str)\\n\\n    genes = np.asarray(adata.var_names.astype(str))\\n    celltype_counts = obs[CELLTYPE_COL].value_counts()\\n    # Use annotation categories if present so all existing cell types are retained.\\n    if hasattr(adata.obs[CELLTYPE_COL].dtype, \\"categories\\"):\\n        cell_types = [str(x) for x in adata.obs[CELLTYPE_COL].cat.categories if str(x) in set(obs[CELLTYPE_COL])]\\n    else:\\n        cell_types = celltype_counts.index.tolist()\\n\\n    records: list[pd.DataFrame] = []\\n    graph_rows: list[dict[str, object]] = []\\n    print(f\\"Loaded {adata.n_obs} cells x {adata.n_vars} genes\\")\\n    print(f\\"Cell types: {len(cell_types)}\\")\\n\\n    for cell_type in cell_types:\\n        idx = np.flatnonzero(obs[CELLTYPE_COL].to_numpy() == cell_type)\\n        n_cells = idx.size\\n        if n_cells < 3:\\n            tvals = np.full(adata.n_vars, np.nan, dtype=float)\\n            df_residual = np.nan\\n            graph_info = {\\"graph_method\\": \\"not_fit_too_few_cells\\", \\"n_edges\\": 0, \\"mean_degree\\": np.nan, \\"n_zero_weight_rows\\": n_cells}\\n            cov_rank = np.nan\\n            cov_terms = []\\n        else:\\n            Y = X[idx, :]\\n            coords = coords_all[idx, :]\\n            S, graph_info = spatial_weighted_expression(Y, coords)\\n            C, cov_terms, cov_rank = make_covariate_design(obs.iloc[idx])\\n            tvals, df_residual = t_statistics_for_genes(Y, S, C)\\n\\n        display = DISPLAY_ALIASES.get(cell_type, cell_type)\\n        df = pd.DataFrame(\\n            {\\n                \\"cell_type\\": cell_type,\\n                \\"cell_type_display\\": display,\\n                \\"gene\\": genes,\\n                \\"t_statistic\\": tvals,\\n                \\"n_cells\\": n_cells,\\n                \\"df_residual\\": df_residual,\\n                \\"covariate_rank\\": cov_rank,\\n            }\\n        )\\n        records.append(df)\\n        graph_rows.append({\\"cell_type\\": cell_type, \\"n_cells\\": n_cells, **graph_info, \\"covariate_terms\\": \\";\\".join(cov_terms)})\\n        print(\\n            f\\"{cell_type:35s} n={n_cells:4d} mean_t={np.nanmean(tvals):8.3f} \\"\\n            f\\"max_t={np.nanmax(tvals):8.3f} edges={graph_info[\'n_edges\']}\\"\\n        )\\n\\n    long_df = pd.concat(records, ignore_index=True)\\n    summary = (\\n        long_df.groupby([\\"cell_type\\", \\"cell_type_display\\"], sort=False)\\n        .agg(\\n            average_t_statistic=(\\"t_statistic\\", \\"mean\\"),\\n            median_t_statistic=(\\"t_statistic\\", \\"median\\"),\\n            min_t_statistic=(\\"t_statistic\\", \\"min\\"),\\n            q25_t_statistic=(\\"t_statistic\\", lambda s: float(np.nanpercentile(s, 25))),\\n            q75_t_statistic=(\\"t_statistic\\", lambda s: float(np.nanpercentile(s, 75))),\\n            max_t_statistic=(\\"t_statistic\\", \\"max\\"),\\n            n_genes=(\\"gene\\", \\"size\\"),\\n            n_genes_valid=(\\"t_statistic\\", lambda s: int(np.isfinite(s).sum())),\\n            n_cells=(\\"n_cells\\", \\"first\\"),\\n            df_residual=(\\"df_residual\\", \\"first\\"),\\n            covariate_rank=(\\"covariate_rank\\", \\"first\\"),\\n        )\\n        .reset_index()\\n        .sort_values(\\"average_t_statistic\\", ascending=False, kind=\\"mergesort\\")\\n    )\\n    summary.insert(0, \\"order_rank\\", np.arange(1, summary.shape[0] + 1))\\n\\n    order_map = summary.set_index(\\"cell_type\\")[\\"order_rank\\"].to_dict()\\n    avg_map = summary.set_index(\\"cell_type\\")[\\"average_t_statistic\\"].to_dict()\\n    long_df[\\"order_rank\\"] = long_df[\\"cell_type\\"].map(order_map).astype(int)\\n    long_df[\\"average_t_statistic\\"] = long_df[\\"cell_type\\"].map(avg_map)\\n    long_df = long_df.sort_values([\\"order_rank\\", \\"gene\\"], kind=\\"mergesort\\")\\n\\n    # Add graph diagnostics to the summary table.\\n    graph_df = pd.DataFrame(graph_rows)\\n    summary = summary.merge(graph_df, on=[\\"cell_type\\", \\"n_cells\\"], how=\\"left\\")\\n\\n    long_df.to_csv(LONG_OUT, index=False)\\n    summary.to_csv(SUMMARY_OUT, index=False)\\n\\n    order_lines = [\\n        f\\"{int(row.order_rank)}. {row.cell_type_display} (`{row.cell_type}`): mean t={row.average_t_statistic:.3f}, n={int(row.n_cells)}\\"\\n        for row in summary.itertuples(index=False)\\n    ]\\n    report = f\\"\\"\\"# Lohoff 2e spatial-heterogeneity statistic computation\\n\\n## Inputs\\n- Dataset: `{DATASET}`\\n- Matrix: `adata.X`, shape {adata.n_obs:,} cells x {adata.n_vars:,} genes, converted from sparse to dense for vectorized linear models.\\n- Cell-type annotation: `obs[\'{CELLTYPE_COL}\']` ({len(cell_types)} observed categories).\\n- Spatial coordinates: `obsm[\'{SPATIAL_KEY}\']`.\\n- Embryo and z-slice covariates: parsed from observation names matching `{NAME_RE.pattern}`.\\n\\n## Statistical method implemented\\nFor each cell type and gene, cells of that type were used as observations.  A spatial covariate was first computed as the row-normalized inverse-shortest-path weighted average of the same gene\'s expression in all other cells from the same cell type.  The cell-cell neighborhood network was reconstructed with a Delaunay triangulation on the supplied two-dimensional spatial coordinates because the h5ad object did not contain a precomputed neighborhood graph (`obsp` was empty).  The distance D_jk was the topological shortest-path length on this graph; self weights were set to zero, and each row of weights was normalized to sum to one to match the stated weighted-mean covariate.\\n\\nThe requested linear model was then fit gene-by-gene:\\n\\n`expression ~ spatial_weighted_expression + embryo + z_slice + embryo:z_slice`.\\n\\nOnly one embryo (`{\', \'.join(sorted(obs[\'embryo\'].unique()))}`) is present in this staged dataset, so embryo main effects and embryo:z interactions are not separately estimable.  The implementation builds the available non-spatial covariate design and uses SVD rank reduction; in practice the estimable non-spatial adjustment is the z-slice indicator plus intercept for cell types containing both z slices.  The reported statistic is the t-statistic for the spatial weighted-expression coefficient.\\n\\n## Ordering variable\\nCell types were ordered by the mean t-statistic over all {adata.n_vars} genes, ignoring non-estimable values.\\n\\n## Cell-type order by average t-statistic\\n\\"\\"\\" + \\"\\\\n\\".join(order_lines) + f\\"\\"\\"\\n\\n## Outputs\\n- Long-format plotting table: `{LONG_OUT}`\\n- Average/order summary table: `{SUMMARY_OUT}`\\n\\"\\"\\"\\n    REPORT_OUT.write_text(report)\\n\\n    print(f\\"Wrote {LONG_OUT} ({long_df.shape[0]} rows)\\")\\n    print(f\\"Wrote {SUMMARY_OUT} ({summary.shape[0]} rows)\\")\\n    print(f\\"Wrote {REPORT_OUT}\\")\\n\\n\\nif __name__ == \\"__main__\\":\\n    main()\\n"}', 'call_id': 'call_9Y8XulZ1bW1uPjwPlJTfmFnB', 'id': 'fc_08320d952050731d006aa44a9e364487d289efa53afc5c521a', 'index': 1}
ToolCalls:
  1. {'name': 'write_file', 'args': {'file_path': '/project/outputs/scripts/compute_lohoff_2e_stats.py', 'content': '#!/usr/bin/env python3\n"""Compute Lohoff et al. Figure 2e spatial-heterogeneity t-statistics.\n\nInputs are read from the staged workspace. Outputs are written under\nproject/outputs/tables and project/outputs/reports.\n"""\n\nfrom __future__ import annotations\n\nimport re\nimport warnings\nfrom pathlib import Path\n\nimport anndata as ad\nimport numpy as np\nimport pandas as pd\nfrom scipy.sparse import issparse\nfrom scipy.sparse import coo_matrix\nfrom scipy.sparse.csgraph import shortest_path\nfrom scipy.spatial import Delaunay, QhullError\nfrom sklearn.neighbors import NearestNeighbors\n\nDATASET = Path("library/datasets/dataset_lohoff_et_al_seqfish.h5ad")\nOUT_TABLE_DIR = Path("project/outputs/tables")\nOUT_REPORT_DIR = Path("project/outputs/reports")\nLONG_OUT = OUT_TABLE_DIR / "lohoff_2e_t_statistics_long.csv"\nSUMMARY_OUT = OUT_TABLE_DIR / "lohoff_2e_average_t_statistics.csv"\nREPORT_OUT = OUT_REPORT_DIR / "lohoff_2e_statistical_method_summary.md"\n\nCELLTYPE_COL = "celltype_mapped_refined"\nSPATIAL_KEY = "spatial"\nNAME_RE = re.compile(r"^(?P<embryo>embryo\\d+)_Pos(?P<position>\\d+)_cell(?P<cell>\\d+)_z(?P<z>\\d+)$")\n\n# Plot-facing aliases only; the original annotation is retained in `cell_type`.\nDISPLAY_ALIASES = {\n    "Mixed mesenchymal mesoderm": "Mesenchyme",\n}\n\n\ndef parse_obs_names(obs_names: pd.Index) -> pd.DataFrame:\n    rows = []\n    bad = []\n    for name in obs_names.astype(str):\n        match = NAME_RE.match(name)\n        if match is None:\n            bad.append(name)\n            rows.append({"embryo": np.nan, "position": np.nan, "cell_id_from_name": np.nan, "z_slice": np.nan})\n        else:\n            gd = match.groupdict()\n            rows.append(\n                {\n                    "embryo": gd["embryo"],\n                    "position": int(gd["position"]),\n                    "cell_id_from_name": int(gd["cell"]),\n                    "z_slice": f"z{gd[\'z\']}",\n                }\n            )\n    if bad:\n        raise ValueError(f"Could not parse embryo/z metadata from {len(bad)} observation names; first: {bad[:3]}")\n    return pd.DataFrame(rows, index=obs_names)\n\n\ndef one_hot_drop_first(values: pd.Series, prefix: str) -> pd.DataFrame:\n    dummies = pd.get_dummies(values.astype(str), prefix=prefix, drop_first=True, dtype=float)\n    return dummies\n\n\ndef make_covariate_design(meta: pd.DataFrame) -> tuple[np.ndarray, list[str], int]:\n    """Design matrix for non-spatial covariates in the requested model.\n\n    The instructions specify embryo, z slice, and embryo:z.  Terms that are\n    constant or linearly dependent in this staged data are retained conceptually\n    but removed by an SVD rank reduction during residualization.\n    """\n    pieces = [pd.DataFrame({"intercept": np.ones(meta.shape[0], dtype=float)}, index=meta.index)]\n    conceptual_terms = ["intercept"]\n\n    if meta["embryo"].nunique() > 1:\n        emb = one_hot_drop_first(meta["embryo"], "embryo")\n        pieces.append(emb)\n        conceptual_terms.extend(emb.columns.tolist())\n\n    if meta["z_slice"].nunique() > 1:\n        z = one_hot_drop_first(meta["z_slice"], "z")\n        pieces.append(z)\n        conceptual_terms.extend(z.columns.tolist())\n\n    if meta["embryo"].nunique() > 1 and meta["z_slice"].nunique() > 1:\n        interaction_values = meta["embryo"].astype(str) + ":" + meta["z_slice"].astype(str)\n        ez = one_hot_drop_first(interaction_values, "embryo_z")\n        pieces.append(ez)\n        conceptual_terms.extend(ez.columns.tolist())\n\n    C = pd.concat(pieces, axis=1).to_numpy(dtype=float)\n    # Numeric rank used as degrees of freedom consumed by non-spatial covariates.\n    if C.size == 0:\n        rank = 0\n    else:\n        s = np.linalg.svd(C, compute_uv=False, full_matrices=False)\n        rank = int((s > (1e-10 * s[0] if s.size else 0.0)).sum())\n    return C, conceptual_terms, rank\n\n\ndef build_delaunay_graph_distances(coords: np.ndarray) -> tuple[np.ndarray, int, str]:\n    """Return all-pairs shortest path lengths on a spatial neighborhood graph.\n\n    A Delaunay triangulation is used as the cell-cell neighborhood network\n    because the h5ad file does not contain a precomputed graph.  Edges are\n    treated as unit graph steps, so D[j, k] is the topological path length.\n    """\n    n = coords.shape[0]\n    if n < 2:\n        return np.full((n, n), np.inf, dtype=float), 0, "none_single_cell"\n\n    edges: set[tuple[int, int]] = set()\n    graph_method = "delaunay"\n    if n == 2:\n        edges.add((0, 1))\n        graph_method = "single_edge"\n    else:\n        try:\n            with warnings.catch_warnings():\n                warnings.simplefilter("ignore")\n                tri = Delaunay(coords)\n            for simplex in tri.simplices:\n                for a, b in ((simplex[0], simplex[1]), (simplex[1], simplex[2]), (simplex[2], simplex[0])):\n                    if a == b:\n                        continue\n                    if a > b:\n                        a, b = b, a\n                    edges.add((int(a), int(b)))\n        except (QhullError, ValueError):\n            # Robust fallback for degenerate coordinates: symmetric kNN graph.\n            graph_method = "knn_fallback"\n            k = min(6, n - 1)\n            nbrs = NearestNeighbors(n_neighbors=k + 1).fit(coords)\n            _, ind = nbrs.kneighbors(coords)\n            for i in range(n):\n                for j in ind[i, 1:]:\n                    a, b = (i, int(j)) if i < int(j) else (int(j), i)\n                    edges.add((a, b))\n\n    if not edges:\n        return np.full((n, n), np.inf, dtype=float), 0, graph_method\n\n    row: list[int] = []\n    col: list[int] = []\n    data: list[float] = []\n    for a, b in edges:\n        row.extend((a, b))\n        col.extend((b, a))\n        data.extend((1.0, 1.0))\n    graph = coo_matrix((data, (row, col)), shape=(n, n)).tocsr()\n    distances = shortest_path(graph, directed=False, unweighted=True)\n    return distances, len(edges), graph_method\n\n\ndef spatial_weighted_expression(Y: np.ndarray, coords: np.ndarray) -> tuple[np.ndarray, dict[str, object]]:\n    D, n_edges, graph_method = build_delaunay_graph_distances(coords)\n    np.fill_diagonal(D, np.inf)\n    with np.errstate(divide="ignore", invalid="ignore"):\n        W = np.where(np.isfinite(D), 1.0 / D, 0.0)\n    W[~np.isfinite(W)] = 0.0\n    row_sums = W.sum(axis=1)\n    nonzero_rows = row_sums > 0\n    W[nonzero_rows, :] = W[nonzero_rows, :] / row_sums[nonzero_rows, None]\n    S = W @ Y\n    info = {\n        "graph_method": graph_method,\n        "n_edges": int(n_edges),\n        "mean_degree": float(2 * n_edges / coords.shape[0]) if coords.shape[0] else np.nan,\n        "n_zero_weight_rows": int((~nonzero_rows).sum()),\n    }\n    return S, info\n\n\ndef t_statistics_for_genes(Y: np.ndarray, S: np.ndarray, C: np.ndarray) -> tuple[np.ndarray, int]:\n    """Vectorized t-statistics for beta_spatial in Y_g ~ S_g + C."""\n    n, g = Y.shape\n    if C.size:\n        U, singular_values, _ = np.linalg.svd(C, full_matrices=False)\n        rank = int((singular_values > (1e-10 * singular_values[0] if singular_values.size else 0.0)).sum())\n        Q = U[:, :rank]\n        Yr = Y - Q @ (Q.T @ Y)\n        Sr = S - Q @ (Q.T @ S)\n    else:\n        rank = 0\n        Yr = Y.copy()\n        Sr = S.copy()\n\n    df_residual = n - rank - 1\n    if df_residual <= 0:\n        return np.full(g, np.nan, dtype=float), df_residual\n\n    sss = np.sum(Sr * Sr, axis=0)\n    numerator = np.sum(Sr * Yr, axis=0)\n    beta = np.full(g, np.nan, dtype=float)\n    valid = sss > 0\n    beta[valid] = numerator[valid] / sss[valid]\n\n    residuals = Yr - Sr * beta[None, :]\n    rss = np.sum(residuals * residuals, axis=0)\n    sigma2 = rss / df_residual\n    se = np.full(g, np.nan, dtype=float)\n    se_valid = valid & (sigma2 > 0)\n    se[se_valid] = np.sqrt(sigma2[se_valid] / sss[se_valid])\n\n    tvals = np.full(g, np.nan, dtype=float)\n    tvals[se_valid] = beta[se_valid] / se[se_valid]\n    return tvals, df_residual\n\n\ndef main() -> None:\n    OUT_TABLE_DIR.mkdir(parents=True, exist_ok=True)\n    OUT_REPORT_DIR.mkdir(parents=True, exist_ok=True)\n\n    adata = ad.read_h5ad(DATASET)\n    if CELLTYPE_COL not in adata.obs:\n        raise KeyError(f"Expected observation column {CELLTYPE_COL!r} was not found")\n    if SPATIAL_KEY not in adata.obsm:\n        raise KeyError(f"Expected adata.obsm[{SPATIAL_KEY!r}] spatial coordinates were not found")\n\n    X = adata.X.toarray() if issparse(adata.X) else np.asarray(adata.X)\n    X = X.astype(np.float64, copy=False)\n    coords_all = np.asarray(adata.obsm[SPATIAL_KEY], dtype=float)\n    parsed = parse_obs_names(adata.obs_names)\n    obs = adata.obs.copy()\n    obs = pd.concat([obs, parsed], axis=1)\n    obs[CELLTYPE_COL] = obs[CELLTYPE_COL].astype(str)\n\n    genes = np.asarray(adata.var_names.astype(str))\n    celltype_counts = obs[CELLTYPE_COL].value_counts()\n    # Use annotation categories if present so all existing cell types are retained.\n    if hasattr(adata.obs[CELLTYPE_COL].dtype, "categories"):\n        cell_types = [str(x) for x in adata.obs[CELLTYPE_COL].cat.categories if str(x) in set(obs[CELLTYPE_COL])]\n    else:\n        cell_types = celltype_counts.index.tolist()\n\n    records: list[pd.DataFrame] = []\n    graph_rows: list[dict[str, object]] = []\n    print(f"Loaded {adata.n_obs} cells x {adata.n_vars} genes")\n    print(f"Cell types: {len(cell_types)}")\n\n    for cell_type in cell_types:\n        idx = np.flatnonzero(obs[CELLTYPE_COL].to_numpy() == cell_type)\n        n_cells = idx.size\n        if n_cells < 3:\n            tvals = np.full(adata.n_vars, np.nan, dtype=float)\n            df_residual = np.nan\n            graph_info = {"graph_method": "not_fit_too_few_cells", "n_edges": 0, "mean_degree": np.nan, "n_zero_weight_rows": n_cells}\n            cov_rank = np.nan\n            cov_terms = []\n        else:\n            Y = X[idx, :]\n            coords = coords_all[idx, :]\n            S, graph_info = spatial_weighted_expression(Y, coords)\n            C, cov_terms, cov_rank = make_covariate_design(obs.iloc[idx])\n            tvals, df_residual = t_statistics_for_genes(Y, S, C)\n\n        display = DISPLAY_ALIASES.get(cell_type, cell_type)\n        df = pd.DataFrame(\n            {\n                "cell_type": cell_type,\n                "cell_type_display": display,\n                "gene": genes,\n                "t_statistic": tvals,\n                "n_cells": n_cells,\n                "df_residual": df_residual,\n                "covariate_rank": cov_rank,\n            }\n        )\n        records.append(df)\n        graph_rows.append({"cell_type": cell_type, "n_cells": n_cells, **graph_info, "covariate_terms": ";".join(cov_terms)})\n        print(\n            f"{cell_type:35s} n={n_cells:4d} mean_t={np.nanmean(tvals):8.3f} "\n            f"max_t={np.nanmax(tvals):8.3f} edges={graph_info[\'n_edges\']}"\n        )\n\n    long_df = pd.concat(records, ignore_index=True)\n    summary = (\n        long_df.groupby(["cell_type", "cell_type_display"], sort=False)\n        .agg(\n            average_t_statistic=("t_statistic", "mean"),\n            median_t_statistic=("t_statistic", "median"),\n            min_t_statistic=("t_statistic", "min"),\n            q25_t_statistic=("t_statistic", lambda s: float(np.nanpercentile(s, 25))),\n            q75_t_statistic=("t_statistic", lambda s: float(np.nanpercentile(s, 75))),\n            max_t_statistic=("t_statistic", "max"),\n            n_genes=("gene", "size"),\n            n_genes_valid=("t_statistic", lambda s: int(np.isfinite(s).sum())),\n            n_cells=("n_cells", "first"),\n            df_residual=("df_residual", "first"),\n            covariate_rank=("covariate_rank", "first"),\n        )\n        .reset_index()\n        .sort_values("average_t_statistic", ascending=False, kind="mergesort")\n    )\n    summary.insert(0, "order_rank", np.arange(1, summary.shape[0] + 1))\n\n    order_map = summary.set_index("cell_type")["order_rank"].to_dict()\n    avg_map = summary.set_index("cell_type")["average_t_statistic"].to_dict()\n    long_df["order_rank"] = long_df["cell_type"].map(order_map).astype(int)\n    long_df["average_t_statistic"] = long_df["cell_type"].map(avg_map)\n    long_df = long_df.sort_values(["order_rank", "gene"], kind="mergesort")\n\n    # Add graph diagnostics to the summary table.\n    graph_df = pd.DataFrame(graph_rows)\n    summary = summary.merge(graph_df, on=["cell_type", "n_cells"], how="left")\n\n    long_df.to_csv(LONG_OUT, index=False)\n    summary.to_csv(SUMMARY_OUT, index=False)\n\n    order_lines = [\n        f"{int(row.order_rank)}. {row.cell_type_display} (`{row.cell_type}`): mean t={row.average_t_statistic:.3f}, n={int(row.n_cells)}"\n        for row in summary.itertuples(index=False)\n    ]\n    report = f"""# Lohoff 2e spatial-heterogeneity statistic computation\n\n## Inputs\n- Dataset: `{DATASET}`\n- Matrix: `adata.X`, shape {adata.n_obs:,} cells x {adata.n_vars:,} genes, converted from sparse to dense for vectorized linear models.\n- Cell-type annotation: `obs[\'{CELLTYPE_COL}\']` ({len(cell_types)} observed categories).\n- Spatial coordinates: `obsm[\'{SPATIAL_KEY}\']`.\n- Embryo and z-slice covariates: parsed from observation names matching `{NAME_RE.pattern}`.\n\n## Statistical method implemented\nFor each cell type and gene, cells of that type were used as observations.  A spatial covariate was first computed as the row-normalized inverse-shortest-path weighted average of the same gene\'s expression in all other cells from the same cell type.  The cell-cell neighborhood network was reconstructed with a Delaunay triangulation on the supplied two-dimensional spatial coordinates because the h5ad object did not contain a precomputed neighborhood graph (`obsp` was empty).  The distance D_jk was the topological shortest-path length on this graph; self weights were set to zero, and each row of weights was normalized to sum to one to match the stated weighted-mean covariate.\n\nThe requested linear model was then fit gene-by-gene:\n\n`expression ~ spatial_weighted_expression + embryo + z_slice + embryo:z_slice`.\n\nOnly one embryo (`{\', \'.join(sorted(obs[\'embryo\'].unique()))}`) is present in this staged dataset, so embryo main effects and embryo:z interactions are not separately estimable.  The implementation builds the available non-spatial covariate design and uses SVD rank reduction; in practice the estimable non-spatial adjustment is the z-slice indicator plus intercept for cell types containing both z slices.  The reported statistic is the t-statistic for the spatial weighted-expression coefficient.\n\n## Ordering variable\nCell types were ordered by the mean t-statistic over all {adata.n_vars} genes, ignoring non-estimable values.\n\n## Cell-type order by average t-statistic\n""" + "\\n".join(order_lines) + f"""\n\n## Outputs\n- Long-format plotting table: `{LONG_OUT}`\n- Average/order summary table: `{SUMMARY_OUT}`\n"""\n    REPORT_OUT.write_text(report)\n\n    print(f"Wrote {LONG_OUT} ({long_df.shape[0]} rows)")\n    print(f"Wrote {SUMMARY_OUT} ({summary.shape[0]} rows)")\n    print(f"Wrote {REPORT_OUT}")\n\n\nif __name__ == "__main__":\n    main()\n'}, 'id': 'call_9Y8XulZ1bW1uPjwPlJTfmFnB', 'type': 'tool_call'}

