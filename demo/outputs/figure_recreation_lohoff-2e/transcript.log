  1. {'name': 'execute', 'args': {'command': "python3 - <<'PY'\nimport anndata as ad, pandas as pd, numpy as np, re\nadata=ad.read_h5ad('library/datasets/dataset_lohoff_et_al_seqfish.h5ad')\ncoords=adata.obsm['spatial']\nprint('coord min max mean std', coords.min(0), coords.max(0), coords.mean(0), coords.std(0))\n# parse pos z\nnames=adata.obs_names.astype(str)\npos=np.array([int(re.search(r'_Pos(\\d+)_', n).group(1)) for n in names])\nz=np.array([int(re.search(r'_z(\\d+)$', n).group(1)) for n in names])\nfor c in ['pos','z']:\n    pass\nfor p in [0,1,14,28]:\n  ix=np.where(pos==p)[0]\n  print('pos',p,'n',len(ix),'range', coords[ix].min(0), coords[ix].max(0),'z counts',pd.Series(z[ix]).value_counts().to_dict())\n# distances between same cell z2,z5 names same embryo/pos/cell different z\nbase=[re.sub(r'_z\\d+$','',n) for n in names]\nfrom collections import defaultdict\nd=defaultdict(list)\nfor i,b in enumerate(base): d[b].append(i)\npairs=[]\nfor b,inds in d.items():\n    if len(inds)>1:\n        pairs.append(np.linalg.norm(coords[inds[0]]-coords[inds[1]]))\nprint('paired cell count',len(pairs),'distance summary',pd.Series(pairs).describe())\nPY", 'timeout': 120}, 'id': 'call_EFJxgt0dT18YxPoHRfsQTDWO', 'type': 'tool_call'}

