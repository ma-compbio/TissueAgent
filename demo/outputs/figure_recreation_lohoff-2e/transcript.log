  1  #!/usr/bin/env python3
  2  """build_colormap.py -- produce the ONE colormap.yaml a reproduction plots from.
  3  
  4  Part of the 'figure-reproduce' skill. Portable and self-contained: it imports NO
  5  project package. Only PyYAML-free stdlib + numpy/Pillow (for the image tier) are
  6  needed; anndata/h5py are used lazily for the dataset tier.
  7  
  8  WHY THIS EXISTS
  9      Color has several possible sources of wildly different trustworthiness -- a
 10      user-supplied file, colors stored in the dataset, a reference figure's legend,
 11      or pixels sampled off a panel. Left implicit, the plotting code silently ends up
 12      on whichever one happened to be easiest, and nothing records which. This script
 13      tries them in priority order, writes ONE colormap.yaml, and stamps the tier it
 14      actually used so "colors came from the dataset" is never confused with "colors
 15      were guessed from a degraded raster".
 16  
 17  TIERS (highest trust first)
 18      1 supplied    an existing palette file (--palette): user/authors' own mapping
 19      2 dataset     colors stored with the data (AnnData .uns["<key>_colors"])
 20      3 legend      swatches measured from a reference figure's legend
 21      4 pixels      dominant colors sampled off the panel  [ONLY if reliable]
 22      5 default     a named fallback palette -- a DEVIATION, never silent
 23  
 24      Categories and their ORDER come from the dataset whenever it has them
 25      (obs["<key>"].cat.categories), independent of where the colors came from.
 26  
 27  USAGE
 28      python build_colormap.py -o colormap.yaml
 29          [--dataset data.h5ad --key celltype]     # categories + order (+ tier 2 colors)
 30          [--palette supplied.yaml]                # tier 1
 31          [--reference fig.png [--legend-box x0,y0,x1,y1]]   # tier 3 / 4
 32          [--allow-default]                        # permit tier 5 instead of failing
 33  
 34  EXAMPLES
 35      # dataset supplies names+order, reference legend supplies colors
 36      python build_colormap.py --dataset adata.h5ad --key cell_type \
 37                               --reference fig2b.png -o colormap.yaml
 38  
 39      # user handed us the palette: it wins outright
 40      python build_colormap.py --palette uploads/colormap.yaml -o colormap.yaml
 41  
 42  EXIT CODES
 43      0 wrote a colormap   1 no trustworthy source (use --allow-default to override)
 44      2 usage error
 45  """
 46  
 47  from __future__ import annotations
 48  
 49  import argparse
 50  import hashlib
 51  import json
 52  import math
 53  import os
 54  import pathlib
 55  import sys
 56  
 57  HERE = os.path.dirname(os.path.abspath(__file__))
 58  if HERE not in sys.path:
 59      sys.path.insert(0, HERE)
 60  
 61  
 62  def hint(pkg: str) -> str:
 63      return f"[degraded] optional dependency '{pkg}' not installed - try: pip install {pkg}"
 64  
 65  
 66  # --------------------------------------------------------------------------- #
 67  # Minimal YAML I/O (a flat "key: value" mapping -- no PyYAML required)
 68  # --------------------------------------------------------------------------- #
 69  def read_simple_yaml(path: str) -> dict:
 70      """Read a flat mapping. Uses PyYAML when present, else a tolerant fallback."""
 71      text = open(path).read()
 72      try:
 73          import yaml
 74          data = yaml.safe_load(text)
 75          return data if isinstance(data, dict) else {}
 76      except ImportError:
 77          out = {}
 78          for line in text.splitlines():
 79              line = line.split("#", 1)[0].rstrip()
 80              if not line or line.startswith(("-", " ")) or ":" not in line:
 81                  continue
 82              k, v = line.split(":", 1)
 83              out[k.strip().strip('"\'')] = v.strip().strip('"\'')
 84          return out
 85  
 86  
 87  def _norm_label(s: str) -> str:
 88      """Fold a legend label to a form that survives typography differences.
 89  
 90      A paper's legend and a dataset's categories routinely disagree on
 91      capitalisation, on punctuation inside compound names, and on British vs
 92      American spelling of the same term. Those are the same class, and refusing
 93      to pair them throws away a perfectly good measured palette.
 94      """
 95      t = "".join(ch for ch in s.casefold() if ch.isalnum() or ch in "/ ")
 96      return " ".join(t.replace("ae", "e").split())
 97  
 98  
 99  def _hex_rgb(value: str) -> tuple[int, int, int] | None:
100      """Return an RGB tuple for a three- or six-digit hex color."""
101      raw = value.lstrip("#")
102      if len(raw) == 3:
103          raw = "".join(ch * 2 for ch in raw)
104      if len(raw) != 6:
105          return None
106      try:
107          return tuple(int(raw[i : i + 2], 16) for i in (0, 2, 4))
108      except ValueError:
109          return None
110  
111  
112  def _explicit_palette_conflicts(mapping: dict, entries: list) -> list[tuple[str, str, str]]:
113      """Find material named-color disagreements with a reference legend."""
114      by_name = {_norm_label(name): (name, color) for name, color in mapping.items()}
115      conflicts = []
116      for entry in entries:
117          label = entry.get("label")
118          reference_color = entry.get("hex")
119          if not label or not reference_color or _norm_label(label) not in by_name:
120              continue
121          name, supplied_color = by_name[_norm_label(label)]
122          supplied_rgb = _hex_rgb(supplied_color)
123          reference_rgb = _hex_rgb(reference_color)
124          if supplied_rgb is None or reference_rgb is None:
125              continue
126          if math.dist(supplied_rgb, reference_rgb) > 30:
127              conflicts.append((name, supplied_color, reference_color))
128      return conflicts
129  
130  
131  def _parse_box_arg(value: str | None) -> tuple[int, int, int, int] | None:
132      """Parse an optional x0,y0,x1,y1 CLI argument."""
133      if value is None:
134          return None
135      parts = tuple(int(float(part)) for part in value.split(","))
136      if len(parts) != 4:
137          raise ValueError
138      return parts
139  
140  
141  def _provenance_hash(mapping: dict, order: list, tier) -> str:
142      """Short digest binding a colormap's colors, order and tier together.
143  
144      A tier stamp on its own is only a claim: a model can write `colormap.yaml`
145      by hand -- header and all -- and present a default palette as a resolved one.
146      That happened in a real run. Recomputing this digest proves the file came
147      from this script and has not been edited since, which turns "please use the
148      script" from a request into something `--verify` can check.
149      """
150      payload = json.dumps(
151          {"tier": str(tier), "order": list(order),
152           "map": {k: mapping[k] for k in order if k in mapping}},
153          sort_keys=True, separators=(",", ":"),
154      )
155      return hashlib.sha256(payload.encode()).hexdigest()[:16]
156  
157  
158  def verify_colormap(path: str) -> tuple[bool, str]:
159      """Re-derive the digest from a colormap file and compare it to the stamp."""
160      try:
161          text = pathlib.Path(path).read_text()
162      except OSError as e:
163          return False, "cannot read %s: %s" % (path, e)
164  
165      stamped = tier = None
166      mapping, order = {}, []
167      for line in text.splitlines():
168          st = line.strip()
169          if st.startswith("# provenance"):
170              stamped = st.split(":", 1)[1].strip()
171          elif st.startswith("# source_tier"):
172              tier = st.split(":", 1)[1].strip()
173          elif st and not st.startswith("#") and ":" in st:
174              k, v = st.split(":", 1)
175              k, v = k.strip(), v.strip().strip('"').strip("'")
176              if v.startswith("#") and len(v) in (4, 7):
177                  mapping[k] = v
178                  order.append(k)
179  
180      if stamped is None:
181          return False, (
182              "no '# provenance' stamp: this file was NOT produced by "
183              "build_colormap.py. A hand-written colormap is not a resolved one -- "
184              "re-run the script and use its output."
185          )
186      actual = _provenance_hash(mapping, order, tier)
187      if actual != stamped:
188          return False, (
189              "provenance mismatch (stamped %s, recomputed %s): the palette, its "
190              "order, or the tier was edited after the script wrote it."
191              % (stamped, actual)
192          )
193      return True, "provenance OK (tier %s, %d categories)" % (tier, len(order))
194  
195  
196  def write_colormap_yaml(path: str, mapping: dict, order: list, meta: dict) -> None:
197      """Write colormap.yaml: provenance header, then `Category: "#hex"` in order."""
198      L = ["# colormap.yaml -- the single source of truth for this figure's colors.",
199           "# Generated by build_colormap.py. Plot from THIS file; do not re-derive",
200           "# colors by eye and do not fall back to library defaults.",
201           "#"]
202      # Hash only the categories actually WRITTEN. `order` may list categories that
203      # got no swatch (a label the legend lacks), and those lines never reach the
204      # file -- so hashing the full order makes --verify recompute a different
205      # digest and reject a legitimately generated colormap.
206      written = [c for c in order if c in mapping]
207      L.append("# provenance  : %s" % _provenance_hash(mapping, written, meta.get("tier")))
208      L.append("# source_tier : %s" % meta.get("tier"))
209      L.append("# how         : %s" % meta.get("how"))
210      if meta.get("order_from"):
211          L.append("# order_from  : %s" % meta["order_from"])
212      if meta.get("warnings"):
213          for w in meta["warnings"]:
214              L.append("# WARNING     : %s" % w)
215      L.append("")
216      for cat in order:
217          if cat in mapping:
218              L.append('%s: "%s"' % (cat, mapping[cat]))
219      for cat in mapping:                      # any not covered by `order`
220          if cat not in order:
221              L.append('%s: "%s"' % (cat, mapping[cat]))
222      open(path, "w").write("\n".join(L) + "\n")
223  
224  
225  # --------------------------------------------------------------------------- #
226  # Categories + order, and tier-2 colors, from the dataset
227  # --------------------------------------------------------------------------- #
228  def from_dataset(path: str, key: str | None):
229      """Return (categories, colors_or_None, key_used, note).
230  
231      Reads AnnData via `anndata` when available, else directly from the HDF5 layout
232      (an .h5ad is just HDF5, and the categorical encoding is stable enough to read
233      without the library -- which matters because the plotting env often has anndata
234      but a helper-script env may not).
235      """
236      try:
237          import anndata  # noqa: F401
238          return _from_dataset_anndata(path, key)
239      except ImportError:
240          pass

