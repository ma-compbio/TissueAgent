    var_beta = np.diag(XtX_inv) * sigma2
    se_beta = np.sqrt(var_beta)

    t_stats = beta / se_beta
    p_vals = 2 * stats.t.sf(np.abs(t_stats), df=dof)

    return beta, se_beta, t_stats, p_vals, dof

