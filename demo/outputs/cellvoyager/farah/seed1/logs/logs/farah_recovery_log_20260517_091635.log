    order = np.argsort(pvals)
    ranks = np.arange(1, n + 1)
    qvals = np.empty(n, dtype=float)
    qvals[order] = pvals[order] * n / ranks
    qvals[order] = np.minimum.accumulate(qvals[order][::-1])[::-1]
