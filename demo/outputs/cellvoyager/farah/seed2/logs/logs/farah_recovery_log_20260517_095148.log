            partial_r2 = float(max(0.0, min(1.0, partial_r2))) if np.isfinite(partial_r2) else np.nan
        except np.linalg.LinAlgError:
            partial_r2 = np.nan
        return {
            'beta_x': float(beta_x),
            'se_x': float(se_x),
            't_x': float(t_x),
            'p_x': float(p_x),
            'partial_R2_x': float(partial_r2),
            'n_used': int(len(yv))
