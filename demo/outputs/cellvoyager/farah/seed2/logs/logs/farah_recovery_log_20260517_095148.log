import numpy as np
import pandas as pd
from sklearn.neighbors import NearestNeighbors

# Ensure required spatial coordinates and annotations are present
if 'spatial' not in adata.obsm.keys():
    raise ValueError('Spatial coordinates not found in adata.obsm["spatial"].')
for col in ['Populations', 'Sample_ID']:
    if col not in adata.obs.columns:
        raise ValueError(f'Required column {col} missing from adata.obs.')

# Identify cardiomyocytes (CM) vs non-CM as in step 1
cm_mask = adata.obs['Populations'].str.contains('CM', case=False, na=False)
adata.obs['is_CM'] = np.where(cm_mask, 'CM', 'non-CM')

# Define coarse niche groups based on Populations string patterns
pop = adata.obs['Populations'].astype(str)
coarse_group = []
for p in pop:
    lp = p.lower()
    if 'cm' in lp:
        coarse_group.append('CM')
    elif 'fibro' in lp:
        coarse_group.append('Fibroblast')
    elif ('vec' in lp) or ('bec' in lp) or ('lec' in lp):
        coarse_group.append('Endothelial')
    elif ('endocardial' in lp):
        coarse_group.append('Endocardial')
    elif ('epdc' in lp) or ('epicardial' in lp):
        coarse_group.append('Epicardial_lineage')
    elif ('pericyte' in lp) or ('vsmc' in lp):
        coarse_group.append('Mural')
    elif ('wbc' in lp) or ('immune' in lp):
        coarse_group.append('Immune')
    elif ('vic' in lp) or ('valve' in lp):
        coarse_group.append('Valve_interstitial')
    elif 'neur' in lp:
        coarse_group.append('Neuronal')
    else:
        coarse_group.append('Other_niche')
adata.obs['niche_coarse'] = coarse_group

# Prepare spatial coordinates and kNN model
coords = adata.obsm['spatial']
# Choose a moderate k to capture immediate physical neighbors
k = 12
nn = NearestNeighbors(n_neighbors=k+1, metric='euclidean')
nn.fit(coords)

# Compute neighbors for all cells (including self as first neighbor)
dists, indices = nn.kneighbors(coords)
# Drop the self-neighbor (index 0 for each row)
neigh_indices = indices[:, 1:]

# Precompute arrays for categories
populations = adata.obs['Populations'].astype('category')
coarse = adata.obs['niche_coarse'].astype('category')
cm_flag = adata.obs['is_CM'].astype('category')

pop_categories = populations.cat.categories.tolist()
coarse_categories = coarse.cat.categories.tolist()
cm_categories = cm_flag.cat.categories.tolist()

n_cells = adata.n_obs

# Initialize storage for neighbor fractions (CM vs non-CM)
for cat in cm_categories:
    adata.obs[f'nn_frac_is_{cat}'] = 0.0

# Initialize storage for fine-grained Populations neighbor fractions (only for frequent types)
pop_counts = adata.obs['Populations'].value_counts()
# Focus on populations with at least 500 cells overall to limit number of columns
frequent_pops = pop_counts[pop_counts >= 500].index.tolist()
for pcat in frequent_pops:
    safe_name = pcat.replace(' ', '_').replace('/', '_')
    adata.obs[f'nn_frac_pop_{safe_name}'] = 0.0

# Initialize storage for coarse niche groups
for ccat in coarse_categories:
    adata.obs[f'nn_frac_coarse_{ccat}'] = 0.0

# Iterate over cells and compute neighbor compositions
# We restrict *interpretation* to CM cells, but compute fractions for all to keep code simple
neighbor_pop = populations.values
neighbor_coarse = coarse.values
neighbor_cmflag = cm_flag.values

k_eff = neigh_indices.shape[1]

cm_cell_mask = (adata.obs['is_CM'] == 'CM').values

for i in range(n_cells):
