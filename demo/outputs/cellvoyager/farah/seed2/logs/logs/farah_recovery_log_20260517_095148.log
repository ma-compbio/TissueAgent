        XtX = Xv.T @ Xv
        try:
            XtX_inv = np.linalg.inv(XtX)
        except np.linalg.LinAlgError:
            return None
        beta = XtX_inv @ (Xv.T @ yv)
        y_pred = Xv @ beta
        resid = yv - y_pred
        dof = Xv.shape[0] - Xv.shape[1]
        if dof <= 0:
            return None
        sigma2 = (resid**2).sum() / dof
        se_beta = np.sqrt(np.diag(XtX_inv) * sigma2)
