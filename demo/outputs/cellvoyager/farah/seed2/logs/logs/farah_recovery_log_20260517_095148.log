# Prepare containers in adata.uns
if 'vCM_endo_contact_DE' not in adata.uns:
    adata.uns['vCM_endo_contact_DE'] = {}

# Convenience views of metadata
pop = adata.obs['Populations'].astype(str)
if 'Sample_ID' not in adata.obs.columns:
    raise ValueError("Sample_ID column required in adata.obs for Sample_ID-stratified grouping.")
sample_ids = adata.obs['Sample_ID'].astype(str)

# If UMAP/neighbors were not computed before, ensure neighbors exist for rank_genes_groups (Scanpy expects neighbors graph)
if 'neighbors' not in adata.uns:
    # Compute a basic neighbors graph on the existing space (e.g. PCA if available, else use expression)
    print("Neighbors not found in adata.uns; computing a default neighbors graph for DE statistics.")
