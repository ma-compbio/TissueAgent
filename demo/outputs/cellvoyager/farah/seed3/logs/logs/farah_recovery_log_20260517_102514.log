    X = sub.X
elif expr_source[0] == 'layers':
    layer = expr_source[1]
    sub = adata[vc_mask, vc_genes].copy()
    X = sub.layers[layer]
else:  # 'raw'
    raw = adata.raw[vc_mask, :]
    var_to_idx = {g: i for i, g in enumerate(list(raw.var_names))}
    gene_idx = [var_to_idx[g] for g in vc_genes if g in var_to_idx]
    if len(gene_idx) == 0:
