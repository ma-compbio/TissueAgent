import numpy as np
import pandas as pd
import scanpy as sc
from scipy import stats

# We assume `adata` is already in memory and that spatial entropy and hub_status
# were defined as in the previous step. Here we will:
# 1) Reconstruct per-population high-purity masks and hub_status.
# 2) Run per-population DE (hub vs non-hub) within those masks using Scanpy's
#    rank_genes_groups (Wilcoxon) and summarize top hub-upregulated genes.

# Focal non-cardiomyocyte populations examined in the entropy/Complexity analysis
focal_pops = [
    'vFibro', 'aFibro', 'adFibro', 'EPDC', 'BEC', 'VEC',
    'VSMC', 'Pericyte', 'VIC', 'aEndocardial', 'vEndocardial'
]

# Ensure required columns exist and are numeric where appropriate
required_obs_cols = ['Populations', 'Purity', 'Complexity', 'UMI Count', 'spatial_entropy_k20']
for col in required_obs_cols:
    if col not in adata.obs.columns:
        raise ValueError(f"Required column '{col}' not found in adata.obs; cannot proceed with DE analysis.")

for col in ['Purity', 'Complexity', 'UMI Count', 'spatial_entropy_k20']:
    adata.obs[col] = pd.to_numeric(adata.obs[col], errors='coerce')

# We will create a new column to store hub_status per cell across populations.
# Initialize as NaN; will fill per-population where applicable.
if 'hub_status_global' not in adata.obs.columns:
    adata.obs['hub_status_global'] = np.nan

# Container for per-population DE summaries
all_de_summaries = []

print("Running within-population DE (hub vs non-hub) for focal non-cardiomyocyte lineages...\n")

for pop in focal_pops:
    pop_mask = (adata.obs['Populations'] == pop)
    n_pop = int(pop_mask.sum())
    if n_pop < 50:
        print(f"Skipping {pop}: only {n_pop} cells (require >= 50).")
        continue

    # Subset dataframe for purity-based thresholds
    df_pop = adata.obs.loc[pop_mask, ['Purity', 'spatial_entropy_k20']].copy()
    df_pop = df_pop.dropna(subset=['Purity', 'spatial_entropy_k20'])
    if df_pop.shape[0] < 50:
        print(f"Skipping {pop}: fewer than 50 cells with complete Purity/entropy.")
        continue

    # Recompute per-population purity floor (30% quantile) and entropy hub threshold (top 10%)
    purity_floor = df_pop['Purity'].quantile(0.3)
    high_purity_mask_local = (adata.obs.loc[pop_mask, 'Purity'] >= purity_floor)

    # Within high-purity subset of this population, define hubs as top 10% entropy
    pop_indices = np.where(pop_mask)[0]
    hp_indices = pop_indices[high_purity_mask_local.values]
    if hp_indices.size < 40:
        print(f"{pop}: fewer than 40 high-purity cells after 30% Purity floor; skipping.")
        continue

    entropy_hp = adata.obs.iloc[hp_indices]['spatial_entropy_k20']
    entropy_thresh = entropy_hp.quantile(0.9)
    is_hub_local = (adata.obs.iloc[hp_indices]['spatial_entropy_k20'] >= entropy_thresh).values

    n_hub = int(is_hub_local.sum())
    n_nonhub = int((~is_hub_local).sum())
    if n_hub < 10 or n_nonhub < 20:
        print(f"{pop}: insufficient hubs/non-hubs (hubs={n_hub}, non-hubs={n_nonhub}); skipping.")
        continue

    # Update global hub_status label: 1 for hubs, 0 for non-hubs within this population & high-purity subset
    # Cells in this population but below the purity floor remain NaN and are excluded from DE.
    hp_mask_global = np.zeros(adata.n_obs, dtype=bool)
    hp_mask_global[hp_indices] = True
    # For reproducibility, set hub_status for this population within the high-purity subset
    adata.obs.loc[hp_indices, 'hub_status_global'] = np.where(is_hub_local, 1, 0)

    # Build an AnnData view restricted to this population and high-purity subset with non-NaN hub_status
    pop_hp_mask_final = (pop_mask & hp_mask_global & adata.obs['hub_status_global'].notna())
    n_final = int(pop_hp_mask_final.sum())
    if n_final < 30:
        print(f"{pop}: fewer than 30 cells after all filters; skipping DE.")
        continue

    adata_sub = adata[pop_hp_mask_final].copy()

    # Encode hub_status as a categorical group (string labels) for Scanpy
    adata_sub.obs['hub_status'] = adata_sub.obs['hub_status_global'].astype(int).astype(str)
    if adata_sub.obs['hub_status'].nunique() < 2:
        print(f"{pop}: only one hub_status group present in filtered subset; skipping.")
        continue

    # Run DE: hubs ("1") vs non-hubs ("0"), Wilcoxon test
    # We set use_raw=False to stick to the current X matrix (already appropriate for this panel).
    sc.tl.rank_genes_groups(
        adata_sub,
        groupby='hub_status',
        method='wilcoxon',
        use_raw=False
    )

    # Extract DE results: we want genes up in hubs (group '1' compared to '0')
    rgg = adata_sub.uns['rank_genes_groups']
    groups = list(rgg['names'].dtype.names)
    if '1' not in groups or '0' not in groups:
        print(f"{pop}: DE groups did not include both hub_status labels '0' and '1'; skipping summarization.")
        continue

    # Convert Scanpy structured arrays to DataFrame for group '1' (hubs up vs others)
    def _extract_group_df(rgg_dict, group_label, top_n=20):
        names = pd.Series(rgg_dict['names'][group_label], dtype=str)
        # logfoldchanges may be absent in older Scanpy; handle gracefully
        if 'logfoldchanges' in rgg_dict:
            lfc = pd.Series(rgg_dict['logfoldchanges'][group_label], dtype=float)
        else:
            lfc = pd.Series(np.nan, index=names.index)
        pvals = pd.Series(rgg_dict['pvals'][group_label], dtype=float)
        pvals_adj = pd.Series(rgg_dict['pvals_adj'][group_label], dtype=float)
        scores = pd.Series(rgg_dict['scores'][group_label], dtype=float)

        df_out = pd.DataFrame({
            'gene': names.values,
            'logfoldchange': lfc.values,
            'score': scores.values,
            'pval': pvals.values,
            'pval_adj': pvals_adj.values
        })
        # Focus on genes up in hubs (positive logFC if available).
        # If logFC is NaN, we fall back to score ordering.
        if df_out['logfoldchange'].notna().any():
            df_out = df_out.sort_values(['logfoldchange', 'score'], ascending=[False, False])
        else:
            df_out = df_out.sort_values('score', ascending=False)
        return df_out.head(top_n).reset_index(drop=True)

    de_top_hubs = _extract_group_df(rgg, group_label='1', top_n=20)
    de_top_hubs['Population'] = pop
    de_top_hubs['hub_group'] = '1'  # hubs
    all_de_summaries.append(de_top_hubs)

    print(f"{pop}: DE completed on N={n_final} high-purity cells (hubs={n_hub}, non-hubs={n_nonhub}).")
    print("Top hub-upregulated genes (first 10):")
    print(de_top_hubs.head(10).to_string(index=False, float_format=lambda x: f"{x:.3g}"))
    print("\n")

# After loop: aggregate and print a concise summary across lineages
if all_de_summaries:
    de_all_df = pd.concat(all_de_summaries, axis=0, ignore_index=True)

    print("\n=== Aggregated summary of hub-upregulated genes across focal populations ===")
    # For each gene, count in how many populations it appears among the top hub-up markers
    gene_counts = (
        de_all_df.groupby('gene')['Population']
        .nunique()
        .sort_values(ascending=False)
    )
    print("\nGenes most frequently upregulated in hubs across focal lineages (top 20):")
    print(gene_counts.head(20).to_string())

    # Also show, per population, the top 5 hub-up genes by logFC (or score if logFC missing)
    print("\nPer-population top 5 hub-upregulated genes:")
    for pop in sorted(de_all_df['Population'].unique()):
        df_pop = de_all_df[de_all_df['Population'] == pop]
        if df_pop.empty:
            continue
        df_top5 = df_pop.head(5)
        print(f"\nPopulation: {pop}")
        print(df_top5[['gene', 'logfoldchange', 'score', 'pval_adj']].to_string(index=False, float_format=lambda x: f"{x:.3g}"))
else:
    print("No DE results were generated; check population sizes and hub definitions.")

```


