    sample_mask_vc = (vc_sample_series == s).values
    if sample_mask_vc.sum() < 10:
        print(f"Skipping Sample_ID={s} for spatial neighbors (only {sample_mask_vc.sum()} vCMs).")
        continue

    # Indices (global) for vCMs in this sample
    global_idx = vc_indices[sample_mask_vc]
    # Build a temporary AnnData with spatial coords for these cells
    tmp_spatial = adata.obsm['spatial'][global_idx, :]
    tmp_adata = sc.AnnData(np.zeros((tmp_spatial.shape[0], 1)))  # dummy X
    tmp_adata.obsm['spatial'] = tmp_spatial

    # Compute neighbors on spatial coordinates
    sc.pp.neighbors(tmp_adata, use_rep='spatial', n_neighbors=15, n_pcs=0)

    # Extract connectivities and compute neighborhood-mean TF score
    conn = tmp_adata.obsp['connectivities']
    if hasattr(conn, 'A'):
        conn = conn.A
    conn = np.asarray(conn)

    # vCM TF scores for this sample
    sample_scores = vc_scores[sample_mask_vc]
    # Avoid self-weight bias by leaving diagonal; this is fine for smoothing
    # Neighborhood mean: weighted average of neighbors' scores
    # Add small epsilon to row sums to avoid division by zero
    row_sums = conn.sum(axis=1)
    eps = 1e-9
    weights = conn / (row_sums[:, None] + eps)
    local_mean = weights.dot(sample_scores)

    # Store back in global container
    nbhd_mean[global_idx] = local_mean

# Save neighborhood-mean scores in obs
nbhd_col = 'vCM_TF_signaling_score_nbhd_mean'
adata.obs[nbhd_col] = nbhd_mean

print(f"Stored neighborhood-mean TF/signaling score in adata.obs['{nbhd_col}'] for vCMs.")

# 6) Quantify spatial coherence: correlation between per-cell and neighborhood scores per vCM subtype and sample
results_rows = []
vc_subtypes = sorted(pop[vc_mask].unique().tolist())

for subtype in vc_subtypes:
    subtype_mask = (pop == subtype) & vc_mask
    if 'Sample_ID' in adata.obs.columns:
        sub_samples = adata.obs.loc[subtype_mask, 'Sample_ID'].astype(str).unique().tolist()
    else:
        sub_samples = ['all']

    for s in sub_samples:
        if s == 'all':
            mask = subtype_mask
        else:
            mask = subtype_mask & (adata.obs['Sample_ID'].astype(str) == s)
        n_cells_sub = int(mask.sum())
        if n_cells_sub < 20:
            continue

        vals_cell = adata.obs.loc[mask, score_name].astype(float).values
        vals_nbhd = adata.obs.loc[mask, nbhd_col].astype(float).values
        valid = np.isfinite(vals_cell) & np.isfinite(vals_nbhd)
        if valid.sum() < 20:
            continue

        x = vals_cell[valid]
        y = vals_nbhd[valid]

        # Pearson
        pearson_r, pearson_p = stats.pearsonr(x, y)
        # Spearman
        spearman_rho, spearman_p = stats.spearmanr(x, y)

        results_rows.append({
            'vCM_subtype': subtype,
            'Sample_ID': s,
            'n_cells': valid.sum(),
            'pearson_r_cell_vs_nbhd': pearson_r,
            'pearson_p_cell_vs_nbhd': pearson_p,
            'spearman_rho_cell_vs_nbhd': spearman_rho,
            'spearman_p_cell_vs_nbhd': spearman_p
        })

# 7) Association of TF scores with Purity per subtype and sample
purity = adata.obs['Purity'].astype(float)

for subtype in vc_subtypes:
    subtype_mask = (pop == subtype) & vc_mask
    if 'Sample_ID' in adata.obs.columns:
        sub_samples = adata.obs.loc[subtype_mask, 'Sample_ID'].astype(str).unique().tolist()
    else:
        sub_samples = ['all']

    for s in sub_samples:
        if s == 'all':
            mask = subtype_mask
        else:
            mask = subtype_mask & (adata.obs['Sample_ID'].astype(str) == s)
        n_cells_sub = int(mask.sum())
        if n_cells_sub < 20:
            continue

        tf_vals = adata.obs.loc[mask, score_name].astype(float).values
        nbhd_vals = adata.obs.loc[mask, nbhd_col].astype(float).values
        pur_vals = purity[mask].values

        valid_tf = np.isfinite(tf_vals) & np.isfinite(pur_vals)
        valid_nbhd = np.isfinite(nbhd_vals) & np.isfinite(pur_vals)

        if valid_tf.sum() >= 20:
            x_tf = tf_vals[valid_tf]
            y_p = pur_vals[valid_tf]
            pr_tf, pp_tf = stats.pearsonr(x_tf, y_p)
            sr_tf, sp_tf = stats.spearmanr(x_tf, y_p)
            # simple linear regression Purity ~ TF_score
            slope_tf, intercept_tf, r_tf, p_lin_tf, stderr_tf = stats.linregress(x_tf, y_p)

            results_rows.append({
                'vCM_subtype': subtype,
                'Sample_ID': s,
                'n_cells': valid_tf.sum(),
                'metric': 'Purity_vs_cell_TF',
                'pearson_r': pr_tf,
                'pearson_p': pp_tf,
                'spearman_rho': sr_tf,
                'spearman_p': sp_tf,
                'linreg_slope': slope_tf,
                'linreg_intercept': intercept_tf,
                'linreg_rvalue': r_tf,
                'linreg_p': p_lin_tf,
                'linreg_stderr': stderr_tf
            })

        if valid_nbhd.sum() >= 20:
            x_nb = nbhd_vals[valid_nbhd]
            y_p2 = pur_vals[valid_nbhd]
            pr_nb, pp_nb = stats.pearsonr(x_nb, y_p2)
            sr_nb, sp_nb = stats.spearmanr(x_nb, y_p2)
            slope_nb, intercept_nb, r_nb, p_lin_nb, stderr_nb = stats.linregress(x_nb, y_p2)

            results_rows.append({
                'vCM_subtype': subtype,
                'Sample_ID': s,
                'n_cells': valid_nbhd.sum(),
                'metric': 'Purity_vs_nbhd_TF',
                'pearson_r': pr_nb,
                'pearson_p': pp_nb,
                'spearman_rho': sr_nb,
                'spearman_p': sp_nb,
                'linreg_slope': slope_nb,
                'linreg_intercept': intercept_nb,
                'linreg_rvalue': r_nb,
                'linreg_p': p_lin_nb,
                'linreg_stderr': stderr_nb
            })

# 8) Summarize and print key statistics
if len(results_rows) == 0:
    print("No valid subtype+sample combinations with enough cells for spatial or Purity associations.")
else:
    res_df = pd.DataFrame(results_rows)

    print("\n=== Spatial coherence: cell vs neighborhood TF/signaling scores ===")
    spatial_rows = [r for r in results_rows if 'pearson_r_cell_vs_nbhd' in r]
    if len(spatial_rows) > 0:
        spatial_df = pd.DataFrame(spatial_rows)
        # Sort by absolute Pearson r
        spatial_df = spatial_df.sort_values('pearson_r_cell_vs_nbhd', key=lambda x: x.abs(), ascending=False)
        print(spatial_df.to_string(index=False))
    else:
        print("No spatial correlation rows found.")

    print("\n=== Associations between TF/signaling scores and Purity (per subtype+sample) ===")
    assoc_df = res_df[res_df.get('metric').notna()].copy() if 'metric' in res_df.columns else pd.DataFrame()
    if assoc_df.shape[0] > 0:
        # Show strongest associations by absolute Pearson r
        assoc_df = assoc_df.sort_values('pearson_r', key=lambda x: x.abs(), ascending=False)
        print(assoc_df.to_string(index=False))
    else:
        print("No Purity association rows found.")

