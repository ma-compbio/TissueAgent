import numpy as np
import pandas as pd
import scanpy as sc
from scipy import stats

# Assume `adata` is already in memory with:
# - adata.obs['density_residual'] populated from the prior OLS step
# - adata.obs['Populations'] defining cardiac populations
# - adata.obs['Sample_ID'] available
# - expression matrix in adata.X (cells x genes)

# Basic checks
required_cols = ['density_residual', 'Populations', 'Sample_ID']
missing = [c for c in required_cols if c not in adata.obs.columns]
if missing:
    raise ValueError(f"Missing required columns in adata.obs: {missing}")

if adata.obs['density_residual'].isna().all():
    raise ValueError("density_residual is entirely NaN; ensure the regression step was run successfully.")

# Identify populations with residuals and sufficient cells
min_cells = 500
pop_counts = adata.obs.groupby('Populations')['density_residual'].apply(lambda x: x.notna().sum())
eligible_pops = pop_counts[pop_counts >= min_cells].index.tolist()

print("Eligible populations for density-residual DE (n_cells with residuals ≥ %d):" % min_cells)
for pop in eligible_pops:
    print(f"  {pop}: {int(pop_counts[pop])} cells with residuals")

# Prepare to store DE results
all_de_results = []

# We will use Scanpy's rank_genes_groups with a temporary group label (low vs high residual)
# Make sure we operate on a copy to avoid polluting the main AnnData with many temp columns

for pop in eligible_pops:
    pop_mask = (adata.obs['Populations'] == pop) & adata.obs['density_residual'].notna()
    n_pop = int(pop_mask.sum())
    if n_pop < min_cells:
        continue

    ad_pop = adata[pop_mask].copy()
    resid = ad_pop.obs['density_residual'].values.astype(float)

    # Define low/high groups by per-population quartiles
    q1 = np.quantile(resid, 0.25)
    q3 = np.quantile(resid, 0.75)

    low_mask = resid <= q1
    high_mask = resid >= q3

    n_low = int(low_mask.sum())
    n_high = int(high_mask.sum())

    # Enforce minimum group sizes (for stability)
    min_group = 100
    if n_low < min_group or n_high < min_group:
        print(f"Skipping population {pop} due to insufficient low/high group sizes (low={n_low}, high={n_high}).")
        continue

    # Create group labels within this population
    group_labels = np.array(['mid'] * ad_pop.n_obs, dtype=object)
    group_labels[low_mask] = 'low_resid'
    group_labels[high_mask] = 'high_resid'
    ad_pop.obs['density_resid_group'] = pd.Categorical(group_labels, categories=['low_resid', 'mid', 'high_resid'])

    # Restrict DE to low vs high only (exclude 'mid') for a clean comparison
    de_mask = ad_pop.obs['density_resid_group'].isin(['low_resid', 'high_resid'])
    ad_de = ad_pop[de_mask].copy()

    # Run Wilcoxon rank-sum DE: high_resid vs low_resid
    sc.tl.rank_genes_groups(
        ad_de,
        groupby='density_resid_group',
        groups=['high_resid'],
        reference='low_resid',
        method='wilcoxon',
        use_raw=False,
        n_genes=adata.n_vars
    )

    # Extract results into a tidy DataFrame
    rg = ad_de.uns['rank_genes_groups']
    genes = np.array(rg['names']['high_resid']).astype(str)
    pvals = np.array(rg['pvals']['high_resid']).astype(float)
    pvals_adj = np.array(rg['pvals_adj']['high_resid']).astype(float)
    scores = np.array(rg['scores']['high_resid']).astype(float)
    logfc = np.array(rg['logfoldchanges']['high_resid']).astype(float)

    de_df = pd.DataFrame({
        'Population': pop,
        'gene': genes,
        'score': scores,
        'logFC_high_vs_low': logfc,
        'pval': pvals,
        'pval_adj': pvals_adj,
        'n_cells_total_pop': n_pop,
        'n_low_resid': n_low,
        'n_high_resid': n_high,
    })

    # Basic per-population DE summary
    sig_mask = de_df['pval_adj'] < 0.05
    n_sig = int(sig_mask.sum())
    print(f"Population {pop}: {n_sig} genes with FDR<0.05 (high_resid vs low_resid).")

    # Sort by adjusted p-value then by |logFC|
    de_df_sorted = de_df.sort_values(['pval_adj', 'logFC_high_vs_low'], ascending=[True, False])

    # Print top 10 genes for this population
    print(f"Top 10 density-residual DE genes for population {pop} (high_resid vs low_resid):")
    print(de_df_sorted.head(10).to_string(index=False))

    all_de_results.append(de_df)

# Concatenate all DE results across populations
if all_de_results:
    all_de_df = pd.concat(all_de_results, axis=0, ignore_index=True)
    # Store in adata.uns for downstream steps
    adata.uns['density_residual_DE_low_vs_high'] = all_de_df

    # Global summary across populations
    total_sig = int((all_de_df['pval_adj'] < 0.05).sum())
    print("\nOverall summary across populations:")
    print(f"  Total DE tests (population-gene combinations): {all_de_df.shape[0]}")
    print(f"  Total significant genes at FDR<0.05: {total_sig}")

    # Per-population significant gene counts
    sig_per_pop = all_de_df[all_de_df['pval_adj'] < 0.05].groupby('Population')['gene'].nunique().sort_values(ascending=False)
    print("\nNumber of unique significant genes (FDR<0.05) per population (sorted):")
    print(sig_per_pop.to_string())
else:
    print("No populations passed filtering for DE (check min_cells or min_group thresholds).")

