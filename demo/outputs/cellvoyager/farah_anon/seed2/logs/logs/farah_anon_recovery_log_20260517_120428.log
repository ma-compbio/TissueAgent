NEXT STEP PLAN - Analysis 1, Step 2: For each well-represented (Populations, Sample_ID) combination identified in the previous step, compute per-cell spatial–transcriptional coupling scores by comparing each cell’s transcriptomic distance to its k nearest spatial neighbors with distances to matched-size sets of random same-(Populations, Sample_ID) cells, operating entirely within each subset in a PCA space built on the 238-gene panel.

Code:
```python
import numpy as np
import pandas as pd
from scipy.spatial import cKDTree
from scipy.spatial.distance import cdist
from scipy import stats
import scanpy as sc

# -----------------------------
# Configuration
# -----------------------------

k_spatial = 8  # number of spatial nearest neighbors per cell
n_random_sets = 20  # how many random k-neighbor sets per cell to approximate null
min_cells_subset = 50  # safety threshold; skip very small (pop, sample) subsets
use_rep = None  # if None, build PCA on the fly for each subset from adata.X

# -----------------------------
# Helper functions
# -----------------------------

def _get_expression_matrix(adata_subset):
    """Return a 2D numpy array of expression values for the subset.

    Uses .X (dense or sparse), converted to dense float32. No extra normalization
    is done here, assuming adata is already in an analysis-ready space; if not,
    this function can be extended to perform log1p-normalization.
    """
    X = adata_subset.X
    if hasattr(X, "toarray"):
        X = X.toarray()
    return np.asarray(X, dtype=np.float32)


def _pca_reduce(X, n_pcs=30):
    """Simple PCA using SVD (no whitening) returning PCs with min(n_pcs, rank)."""
    # Center features
    X_centered = X - X.mean(axis=0, keepdims=True)
    # Economy SVD
    U, S, Vt = np.linalg.svd(X_centered, full_matrices=False)
    n_use = min(n_pcs, U.shape[1])
    return U[:, :n_use] * S[:n_use]


def compute_coupling_for_subset(adata_subset, k=k_spatial, n_random=n_random_sets, random_state=0):
    """Compute per-cell spatial–transcriptional coupling scores for a single
    (Populations, Sample_ID) subset.

    Returns a DataFrame with index matching adata_subset.obs_names and columns:
    ['d_spatial_mean', 'd_random_mean', 'delta', 'z_score'].
    """
    rng = np.random.RandomState(random_state)

    # Spatial coordinates
    if "spatial" not in adata_subset.obsm.keys():
        raise ValueError("'spatial' coordinates not found in adata.obsm")
    coords = np.asarray(adata_subset.obsm["spatial"], dtype=float)

    n_cells = coords.shape[0]
    if n_cells < (k + 1):
        # Not enough cells to define k neighbors
        return None

    # Transcriptomic representation: PCA on this subset
    X = _get_expression_matrix(adata_subset)
    pcs = _pca_reduce(X, n_pcs=min(30, X.shape[1]))

    # Precompute full pairwise distances in PCA space (Euclidean)
    # For this dataset (238 genes and large n), we rely on within-subset sizes
    # being moderate due to per-(Populations, Sample_ID) restriction.
    dist_mat = cdist(pcs, pcs, metric="euclidean")

    # Build spatial kNN using KD-tree
    tree = cKDTree(coords)
    # query k+1 to include the cell itself as neighbor 0, then drop self
    d_spatial, idx_spatial = tree.query(coords, k=k + 1)
    idx_spatial = idx_spatial[:, 1:]  # drop self index

    # Prepare arrays for outputs
    d_spatial_mean = np.zeros(n_cells, dtype=float)
    d_random_mean = np.zeros(n_cells, dtype=float)
    delta = np.zeros(n_cells, dtype=float)
    z_score = np.zeros(n_cells, dtype=float)

    all_indices = np.arange(n_cells)

    for i in range(n_cells):
        # Spatial neighbor distances in PCA space
        neigh_idx = idx_spatial[i]
        d_spatial_i = dist_mat[i, neigh_idx]
        d_spatial_mean[i] = d_spatial_i.mean()

        # Random neighbors: sample without replacement from all other cells
        others = np.delete(all_indices, i)
        random_means = np.zeros(n_random, dtype=float)
        for r in range(n_random):
            rand_idx = rng.choice(others, size=k, replace=False)
            random_means[r] = dist_mat[i, rand_idx].mean()

        d_random_mean[i] = random_means.mean()
        delta_i = d_random_mean[i] - d_spatial_mean[i]
        delta[i] = delta_i
        # Z-score of observed vs random null
        if random_means.std() > 0:
            z_score[i] = (d_spatial_mean[i] - random_means.mean()) / random_means.std()
        else:
            z_score[i] = 0.0

    df = pd.DataFrame({
        "d_spatial_mean": d_spatial_mean,
        "d_random_mean": d_random_mean,
        "delta": delta,  # positive delta => spatial neighbors more similar (smaller distance)
        "z_score": z_score
    }, index=adata_subset.obs_names)
    return df


# -----------------------------
# Main: iterate over well-represented (Populations, Sample_ID)
# -----------------------------

if "analysis_metadata" not in adata.uns or "sufficient_pops_per_sample" not in adata.uns["analysis_metadata"]:
    raise ValueError("Expected 'analysis_metadata' with 'sufficient_pops_per_sample' in adata.uns from Step 1.")

sufficient_pops_per_sample = adata.uns["analysis_metadata"]["sufficient_pops_per_sample"]

coupling_results = {}  # nested dict: coupling_results[(pop, sample)] -> DataFrame
summary_records = []   # per-(pop, sample) summaries

for pop, sample_list in sufficient_pops_per_sample.items():
    for sample in sample_list:
        subset_mask = (adata.obs["Populations"] == pop) & (adata.obs["Sample_ID"] == sample)
        n_cells_subset = int(subset_mask.sum())
        if n_cells_subset < max(min_cells_subset, k_spatial + 1):
            continue

        print(f"Computing coupling for Populations={pop}, Sample_ID={sample} (n={n_cells_subset} cells)...")
        adata_subset = adata[subset_mask].copy()
        df_coupling = compute_coupling_for_subset(adata_subset, k=k_spatial, n_random=n_random_sets)
        if df_coupling is None:
            print(f"  Skipped (too few cells for k={k_spatial}).")
            continue

        # Attach per-cell coupling metrics back to the main AnnData in obs
        for col in df_coupling.columns:
            if col not in adata.obs.columns:
                adata.obs[col] = np.nan
            adata.obs.loc[df_coupling.index, col] = df_coupling[col]

        # Store full per-cell table
        coupling_results[(pop, sample)] = df_coupling

        # Per-(pop, sample) summary statistics
        d_spatial_mean_med = float(np.median(df_coupling["d_spatial_mean"]))
        d_random_mean_med = float(np.median(df_coupling["d_random_mean"]))
        delta_med = float(np.median(df_coupling["delta"]))
        z_med = float(np.median(df_coupling["z_score"]))
        z_mean = float(np.mean(df_coupling["z_score"]))

        summary_records.append({
            "Populations": pop,
            "Sample_ID": sample,
            "n_cells": n_cells_subset,
            "k_spatial": k_spatial,
            "n_random_sets": n_random_sets,
            "d_spatial_median": d_spatial_mean_med,
            "d_random_median": d_random_mean_med,
            "delta_median": delta_med,
            "z_score_median": z_med,
            "z_score_mean": z_mean
        })

# Convert summaries to DataFrame
if summary_records:
    coupling_summary_df = pd.DataFrame(summary_records)
else:
    coupling_summary_df = pd.DataFrame(columns=[
        "Populations", "Sample_ID", "n_cells", "k_spatial", "n_random_sets",
        "d_spatial_median", "d_random_median", "delta_median", "z_score_median", "z_score_mean"
    ])

# Store in adata.uns for downstream steps
if "analysis_metadata" not in adata.uns:
    adata.uns["analysis_metadata"] = {}
adata.uns["analysis_metadata"]["coupling_per_cell"] = coupling_results
adata.uns["analysis_metadata"]["coupling_summary"] = coupling_summary_df

# Print text-only summary of results
print("\nPer-(Populations, Sample_ID) coupling summary (first 20 rows):")
print(coupling_summary_df.sort_values(["Populations", "Sample_ID"]).head(20))

print("\nNumber of (Populations, Sample_ID) subsets with computed coupling:", len(coupling_results))

# Basic interpretation summary (text-only)
if not coupling_summary_df.empty:
    print("\nOverall median delta (d_random_median - d_spatial_median) across all subsets:",
          float(coupling_summary_df["delta_median"].median()))
    print("Overall median z_score_median across all subsets:",
          float(coupling_summary_df["z_score_median"].median()))
else:
    print("No subsets passed the minimum cell threshold for coupling computation.")
