# ------------------------
# Helper: Benjamini–Hochberg FDR
# ------------------------
def bh_fdr(pvals: np.ndarray) -> np.ndarray:
    pvals = np.asarray(pvals, dtype=float)
    n = pvals.size
    order = np.argsort(pvals)
    ranked = pvals[order]
    qvals = np.empty(n, dtype=float)
    prev_q = 1.0
    for i in range(n - 1, -1, -1):
        rank = i + 1
        q = ranked[i] * n / rank
        if q > prev_q:
            q = prev_q
        prev_q = q
        qvals[i] = q
    out = np.empty(n, dtype=float)
    out[order] = qvals
    return out

