adata.obs['spatial_y'] = spatial[:, 1]
adata.obs['umap_x'] = umap[:, 0]
adata.obs['umap_y'] = umap[:, 1]

# Define groupings and power thresholds
min_cells_pop = 200
min_cells_pop_sample = 200

pop_col = 'Populations'
sample_col = 'Sample_ID'

