import numpy as np
import pandas as pd

# Step 1: Inspect metadata and summarize populations vs Complexity/Purity/Sample_ID

# Basic AnnData inspection
print('AnnData shape (cells x genes):', adata.shape)
print('\n.obs columns:', list(adata.obs.columns))
print('\n.obsm keys:', list(adata.obsm.keys()))

# Ensure required metadata columns exist
required_cols = ['Populations', 'Complexity', 'Purity', 'Sample_ID']
missing = [c for c in required_cols if c not in adata.obs.columns]
if missing:
    print('Missing required columns in adata.obs:', missing)
else:
    print('All required metadata columns found.')

# Convert to convenient dtypes
obs = adata.obs.copy()

# Coerce numeric fields, if needed
for col in ['Complexity', 'Purity']:
    if not np.issubdtype(obs[col].dtype, np.number):
        obs[col] = pd.to_numeric(obs[col], errors='coerce')

# Drop cells with missing key metadata
initial_n = obs.shape[0]
obs = obs.dropna(subset=['Populations', 'Complexity', 'Purity', 'Sample_ID'])
print(f"\nDropped {initial_n - obs.shape[0]} cells due to missing Populations/Complexity/Purity/Sample_ID.")

# Attach filtered view index to original AnnData
valid_idx = obs.index

# Summarize populations
pop_group = obs.groupby('Populations')
summary_list = []
for pop, df in pop_group:
    n_cells = df.shape[0]
    n_samples = df['Sample_ID'].nunique()
    complexity_mean = df['Complexity'].mean()
    complexity_sd = df['Complexity'].std()
    purity_mean = df['Purity'].mean()
    purity_sd = df['Purity'].std()
    summary_list.append({
        'Population': pop,
        'n_cells': n_cells,
        'n_samples': n_samples,
        'Complexity_mean': complexity_mean,
        'Complexity_sd': complexity_sd,
        'Purity_mean': purity_mean,
        'Purity_sd': purity_sd
    })

summary_df = pd.DataFrame(summary_list)

# Define a simple heuristic for "well-powered" populations
