    beta_x, _, _, _ = LA.lstsq(C_design, x, rcond=None)
    beta_y, _, _, _ = LA.lstsq(C_design, y, rcond=None)

    x_res = x - C_design.dot(beta_x)
    y_res = y - C_design.dot(beta_y)

