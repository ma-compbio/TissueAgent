complexity_col = 'Complexity'
umi_col = 'UMI Count'
sample_col = 'Sample_ID'

selected_pops = ['PA', 'PC', 'PD', 'PE', 'PH', 'PJ', 'PL', 'PN', 'PQ']

# Extract spatial coordinates
