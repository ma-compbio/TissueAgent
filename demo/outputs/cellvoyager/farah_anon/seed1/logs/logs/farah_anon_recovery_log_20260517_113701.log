    flag_cols = []
    for metric, pcol in [('Purity', 'p_adj_purity'),
                         ('Complexity', 'p_adj_complexity'),
                         ('UMI', 'p_adj_UMI'),
                         ('Spatial_x', 'p_adj_spatial_x'),
                         ('Spatial_y', 'p_adj_spatial_y'),
                         ('Sample_ID', 'p_adj_sample_ID')]:
        if pcol in res_df_sorted.columns:
