        r_s = np.sqrt((x_s - x_cent) ** 2 + (y_s - y_cent) ** 2)

        # Spearman correlations
        rho_x, p_x = safe_spearman(comp_s, x_s)
        rho_y, p_y = safe_spearman(comp_s, y_s)
        rho_r, p_r = safe_spearman(comp_s, r_s)

        rows.append({
            'population': pop,
            'sample_id': sid,
            'n_cells': int(sample_mask_local.sum()),
            'rho_complexity_x': rho_x,
            'p_complexity_x': p_x,
            'rho_complexity_y': rho_y,
            'p_complexity_y': p_y,
            'rho_complexity_r': rho_r,
            'p_complexity_r': p_r,
        })

# Assemble results into a DataFrame
spatial_df = pd.DataFrame(rows)

if spatial_df.empty:
    print("No valid (population, sample) combinations with sufficient cells for spatial tests.")
else:
    # Benjamini–Hochberg FDR correction across all spatial tests and metrics jointly
    def bh_fdr(pvals: np.ndarray) -> np.ndarray:
        pvals = np.asarray(pvals, dtype=float)
        n = pvals.size
        if n == 0:
            return pvals
        order = np.argsort(pvals)
        ranks = np.arange(1, n + 1)
        q = pvals[order] * n / ranks
        q = np.minimum.accumulate(q[::-1])[::-1]
        q = np.clip(q, 0.0, 1.0)
        out = np.empty_like(q)
        out[order] = q
        return out

    # Apply BH to each p-value column across all populations and samples
    for p_col, q_col in [
        ('p_complexity_x', 'q_complexity_x'),
        ('p_complexity_y', 'q_complexity_y'),
        ('p_complexity_r', 'q_complexity_r'),
    ]:
        pvals = spatial_df[p_col].values.astype(float)
        # Handle NaNs by leaving q as NaN
        nan_mask = np.isnan(pvals)
        if np.all(nan_mask):
            spatial_df[q_col] = np.nan
            continue
        p_work = pvals.copy()
        p_work[nan_mask] = 1.0
        qvals = bh_fdr(p_work)
        qvals[nan_mask] = np.nan
        spatial_df[q_col] = qvals

    # Store results in adata.uns for downstream DE step
    adata.uns['complexity_spatial_correlations'] = spatial_df

    # Print textual summary of spatial gradients
    print("\nSpatial Complexity–coordinate correlations for PJ, PE, PH (sorted by FDR):")
    display_cols = [
        'population', 'sample_id', 'n_cells',
        'rho_complexity_x', 'p_complexity_x', 'q_complexity_x',
        'rho_complexity_y', 'p_complexity_y', 'q_complexity_y',
        'rho_complexity_r', 'p_complexity_r', 'q_complexity_r',
    ]
    # Sort primarily by population, then by minimum q across the three metrics for easier inspection
    spatial_df['_min_q'] = spatial_df[[
        'q_complexity_x', 'q_complexity_y', 'q_complexity_r']].min(axis=1)
    print(
        spatial_df.sort_values(['population', '_min_q'])[display_cols].to_string(index=False)
    )
    spatial_df.drop(columns=['_min_q'], inplace=True)
