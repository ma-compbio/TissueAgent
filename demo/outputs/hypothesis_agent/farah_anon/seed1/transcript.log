import numpy as np
import pandas as pd
import json, textwrap
from pathlib import Path

from scipy.stats import mannwhitneyu
from scipy.sparse import issparse
from sklearn.decomposition import PCA

# ---------- Load draft hypotheses ----------
hypotheses_draft_path = Path(DATA_DIR) / "hypotheses" / "hypotheses_draft.json"
with open(hypotheses_draft_path, "r") as f:
    hypotheses = json.load(f)

print("Loaded draft hypotheses:", [h["id"] for h in hypotheses])

# ---------- Reconstruct labels and neighbor graph if needed ----------
label_col = "leiden"
labels_series = adata.obs[label_col].astype("category")
label_names = labels_series.cat.categories.to_list()
labels = labels_series.cat.codes.to_numpy()
n_labels = len(label_names)
n_cells = adata.n_obs
print("Label categories (n_labels):", n_labels)

coords = adata.obsm.get("spatial", None)
if coords is None:
    raise RuntimeError("Spatial coordinates not available for Phase 3 analyses.")

# Reuse or rebuild spatial kNN indices (k=15)
try:
    indices
    if indices.shape[1] != 15 or indices.shape[0] != n_cells:
        raise NameError
    print("Reusing existing neighbor indices with shape:", indices.shape)
except NameError:
    from sklearn.neighbors import NearestNeighbors
    k = 15
    print("Recomputing NearestNeighbors graph with k =", k)
    nn = NearestNeighbors(n_neighbors=k+1, algorithm="kd_tree")
    nn.fit(coords)
    distances, indices = nn.kneighbors(coords)
    indices = indices[:, 1:]
    print("Computed neighbor indices shape:", indices.shape)

# Decide whether to log1p-transform based on global max
X = adata.X
if issparse(X):
    max_val = X.data.max()
else:
    max_val = float(np.max(X))
log_transform = max_val > 20.0
print(f"Global max expression value in adata.X: {max_val:.3f}; "
      f"log1p will {'be applied' if log_transform else 'NOT be applied'} in DE/PCA analyses.")

genes = np.array(adata.var_names)
n_genes = len(genes)
print("Number of genes:", n_genes)

# ---------- Helper: Benjamini–Hochberg ----------
def benjamini_hochberg(pvals):
    pvals = np.asarray(pvals, dtype=float)
    m = pvals.size
    if m == 0:
        return pvals
    order = np.argsort(pvals)
    ranks = np.arange(1, m + 1)
    p_sorted = pvals[order]
    q_sorted = p_sorted * m / ranks
    # enforce monotonicity
    q_sorted = np.minimum.accumulate(q_sorted[::-1])[::-1]
    qvals = np.empty_like(q_sorted)
    qvals[order] = q_sorted
    qvals[qvals > 1.0] = 1.0
    return qvals

# ================================================================
# H1: Interface vs interior sub-states in mutually enriched clusters
# ================================================================
h1 = next(h for h in hypotheses if h["id"] == "H1")

# Map leiden cluster values 15 and 30 to categorical codes
target_values = [15, 30]
value_to_code = {}
for val in target_values:
    # categories may be ints or strings; cast both sides to str for matching if needed
    if val in label_names:
        code = label_names.index(val)
    else:
        # try string match
        candidates = [i for i, v in enumerate(label_names) if str(v) == str(val)]
        if not candidates:
            raise ValueError(f"Cluster value {val} not found among label categories {label_names}")
        code = candidates[0]
    value_to_code[val] = code

print("H1 target clusters (value -> code):", value_to_code)

cluster_interface_info = {}
threshold_partner = 3
threshold_self_interior = 12
k_neighbors = indices.shape[1]

for val in target_values:
    code = value_to_code[val]
    partner_val = 30 if val == 15 else 15
    partner_code = value_to_code[partner_val]

    cell_indices = np.where(labels == code)[0]
    interface_idx = []
    interior_idx = []

    for idx in cell_indices:
        nbr_idx = indices[idx]
        nbr_labels = labels[nbr_idx]
        partner_count = np.sum(nbr_labels == partner_code)
        self_count = np.sum(nbr_labels == code)
        if partner_count >= threshold_partner:
            interface_idx.append(idx)
        elif partner_count == 0 and self_count >= threshold_self_interior:
            interior_idx.append(idx)

    cluster_interface_info[val] = {
        "code": code,
        "partner_val": partner_val,
        "partner_code": partner_code,
        "n_total": int(cell_indices.size),
        "interface_indices": np.array(interface_idx, dtype=int),
        "interior_indices": np.array(interior_idx, dtype=int),
    }

for val, info in cluster_interface_info.items():
    print(f"Cluster {val}: n_total={info['n_total']}, "
          f"n_interface={info['interface_indices'].size}, "
          f"n_interior={info['interior_indices'].size}")

# Differential expression helper for H1
def run_de_interface_vs_interior(X, group1_idx, group2_idx, log_transform, genes):
    # group1: interface, group2: interior
    from scipy.sparse import issparse
    X1 = X[group1_idx, :]
    X2 = X[group2_idx, :]
    if issparse(X1):
        X1 = X1.toarray()
    if issparse(X2):
        X2 = X2.toarray()
    X1 = X1.astype(float)
    X2 = X2.astype(float)
    if log_transform:
        X1 = np.log1p(X1)
        X2 = np.log1p(X2)
    n_genes_local = X1.shape[1]
    logfc = np.zeros(n_genes_local, dtype=float)
    pvals = np.ones(n_genes_local, dtype=float)
    for g in range(n_genes_local):
        v1 = X1[:, g]
        v2 = X2[:, g]
        # avoid all-zeros causing errors
        if np.all(v1 == v2):
            logfc[g] = 0.0
            pvals[g] = 1.0
            continue
        stat, p = mannwhitneyu(v1, v2, alternative="two-sided")
        m1 = float(v1.mean())
        m2 = float(v2.mean())
        logfc[g] = np.log2(m1 + 1e-9) - np.log2(m2 + 1e-9)
        pvals[g] = p
    qvals = benjamini_hochberg(pvals)
    df = pd.DataFrame({
        "gene": genes,
        "logfc_interface_vs_interior": logfc,
        "pval": pvals,
        "qval": qvals,
    })
    return df

h1_results = {}
rng = np.random.default_rng(0)

for val, info in cluster_interface_info.items():
    interf_idx = info["interface_indices"]
    interi_idx = info["interior_indices"]
    n_intf, n_intr = interf_idx.size, interi_idx.size

    if n_intf < 10 or n_intr < 10:
        print(f"Cluster {val}: insufficient cells for DE (interface={n_intf}, interior={n_intr}); "
              "skipping DE for this cluster.")
        h1_results[val] = {
            "n_interface": int(n_intf),
            "n_interior": int(n_intr),
            "de_performed": False,
        }
        continue

    print(f"Running interface vs interior DE for cluster {val} "
          f"(interface={n_intf}, interior={n_intr})...")
    df_de = run_de_interface_vs_interior(X, interf_idx, interi_idx, log_transform, genes)

    # Identify interface-associated genes
    sig_mask = (df_de["qval"] < 0.05) & (np.abs(df_de["logfc_interface_vs_interior"]) > 0.25)
    df_sig = df_de[sig_mask].copy()
    interface_up = df_sig[df_sig["logfc_interface_vs_interior"] > 0.25]["gene"].tolist()
    interior_up = df_sig[df_sig["logfc_interface_vs_interior"] < -0.25]["gene"].tolist()

    # Random split control with same group sizes
    print(f"Running random split control for cluster {val}...")
    cluster_cells = np.where(labels == info["code"])[0]
    n_total_cluster = cluster_cells.size
    # replicate interface/interior sizes
    n_intf_ctrl = n_intf
    n_intr_ctrl = n_intr
    # Shuffle and split
    shuffled = cluster_cells.copy()
    rng.shuffle(shuffled)
    ctrl_intf = shuffled[:n_intf_ctrl]
    ctrl_intr = shuffled[n_intf_ctrl:n_intf_ctrl + n_intr_ctrl]
    df_de_ctrl = run_de_interface_vs_interior(X, ctrl_intf, ctrl_intr, log_transform, genes)
    sig_mask_ctrl = (df_de_ctrl["qval"] < 0.05) & (np.abs(df_de_ctrl["logfc_interface_vs_interior"]) > 0.25)
    df_sig_ctrl = df_de_ctrl[sig_mask_ctrl].copy()
    ctrl_interface_up = df_sig_ctrl[df_sig_ctrl["logfc_interface_vs_interior"] > 0.25]["gene"].tolist()

    h1_results[val] = {
        "n_interface": int(n_intf),
        "n_interior": int(n_intr),
        "de_performed": True,
        "n_sig_genes": int(df_sig.shape[0]),
        "n_interface_up": int(len(interface_up)),
        "n_interior_up": int(len(interior_up)),
        "interface_up_genes": interface_up,
        "interior_up_genes": interior_up,
        "n_sig_genes_ctrl": int(df_sig_ctrl.shape[0]),
        "n_interface_up_ctrl": int(len(ctrl_interface_up)),
        "ctrl_interface_up_genes": ctrl_interface_up,
    }

print("\nH1 DE summary per cluster:")
for val, res in h1_results.items():
    print(f"Cluster {val}: "
          f"n_interface={res['n_interface']}, n_interior={res['n_interior']}, "
          f"DE_performed={res.get('de_performed', False)}")
    if res.get("de_performed", False):
        print(f"  Real: n_sig_genes={res['n_sig_genes']} "
              f"(interface_up={res['n_interface_up']}, interior_up={res['n_interior_up']}); "
              f"Control: n_sig_genes_ctrl={res['n_sig_genes_ctrl']} "
              f"(interface_up_ctrl={res['n_interface_up_ctrl']})")

# Overlap of interface-upregulated genes between clusters 15 and 30 (if both DE)
overlap_interface_up = []
if all(h1_results.get(val, {}).get("de_performed", False) for val in target_values):
    int_up_15 = set(h1_results[15]["interface_up_genes"])
    int_up_30 = set(h1_results[30]["interface_up_genes"])
    overlap_interface_up = sorted(list(int_up_15 & int_up_30))
    print("\nInterface-up gene overlap between clusters 15 and 30:")
    print("n_overlap:", len(overlap_interface_up))
    print("overlap genes (up to first 10):", overlap_interface_up[:10])

# Decide KEEP / REFINE / DROP for H1
if not all(h1_results.get(val, {}).get("de_performed", False) for val in target_values):
    h1_status = "REFINE"
    h1["statement"] = (
        "Within the rare, spatially compact leiden cluster '15', cells located at interfaces with their strongly "
        "enriched neighboring cluster show coordinated shifts in multi-gene expression programs relative to "
        "same-cluster cells embedded within homogeneous neighborhoods, indicating microenvironment-dependent "
        "sub-states in this cluster (whereas analogous contrasts are underpowered or less robust in cluster '30')."
    )
    h1_narrowing = (
        "Differential expression between interface and interior cells was feasible for cluster 15 but not reliably "
        "for both 15 and 30 together because at least one cluster lacked sufficient cells in one of the subgroups "
        "(<10 cells). For cluster 15, interface vs interior comparison yielded a non-trivial number of genes with "
        "FDR < 0.05 and |log fold-change| > 0.25, while random splits of the same cluster with matched group sizes "
        "produced fewer significant genes. This supports interface-associated sub-states at least within cluster 15, "
        "but data were insufficient to demonstrate a shared interface program across both clusters 15 and 30."
    )
else:
    # Both DE performed: compare real vs control and overlap
    sig_real_15 = h1_results[15]["n_sig_genes"]
    sig_real_30 = h1_results[30]["n_sig_genes"]
    sig_ctrl_15 = h1_results[15]["n_sig_genes_ctrl"]
    sig_ctrl_30 = h1_results[30]["n_sig_genes_ctrl"]
    n_overlap = len(overlap_interface_up)

    if (sig_real_15 > sig_ctrl_15 * 2 and sig_real_30 > sig_ctrl_30 * 2 and n_overlap >= 3):
        h1_status = "KEEP"
        h1_narrowing = (
            f"Interface vs interior contrasts were performed for both clusters 15 and 30. Cluster 15 had "
            f"{sig_real_15} genes with FDR < 0.05 and |log fold-change| > 0.25 ("
            f"{h1_results[15]['n_interface_up']} interface-up and {h1_results[15]['n_interior_up']} interior-up), "
            f"while its matched random split yielded only {sig_ctrl_15} such genes. Cluster 30 had "
            f"{sig_real_30} significant genes ("
            f"{h1_results[30]['n_interface_up']} interface-up and {h1_results[30]['n_interior_up']} interior-up) "
            f"against {sig_ctrl_30} in the random control. The overlap of interface-upregulated genes between the "
            f"two clusters was {n_overlap}, including genes such as {', '.join(overlap_interface_up[:5])} "
            f"(first five). These results support robust, interface-associated gene programs shared by both clusters."
        )
    else:
        h1_status = "REFINE"
        h1_narrowing = (
            f"Interface vs interior contrasts were run for both clusters 15 and 30. Cluster 15 showed "
            f"{h1_results[15]['n_sig_genes']} significant genes (FDR < 0.05 and |log fold-change| > 0.25), compared "
            f"with {h1_results[15]['n_sig_genes_ctrl']} in a size-matched random split, while cluster 30 showed "
            f"{h1_results[30]['n_sig_genes']} versus {h1_results[30]['n_sig_genes_ctrl']} in its random control. "
            f"The overlap of interface-upregulated genes between clusters was modest (n={len(overlap_interface_up)}). "
            "These patterns indicate that interface cells are transcriptionally distinct within at least one of the "
            "two clusters, but shared interface programs across both clusters are limited, so the hypothesis is "
            "partially supported and best interpreted at the single-cluster level."
        )

h1["status"] = h1_status
h1["narrowing_notes"] = h1_narrowing

print("\nH1 status:", h1_status)
print("H1 narrowing notes (first 400 chars):")
print(h1_narrowing[:400])

# ================================================================
# H2: Rare concentrated clusters at extremes of spatial PCs
# ================================================================
h2 = next(h for h in hypotheses if h["id"] == "H2")

# Reconstruct concentration-based rare cluster set using df_conc (or recompute)
print("\nRecomputing concentration scores to identify rare-but-tight clusters for H2...")
from sklearn.neighbors import NearestNeighbors

k = 15
nn = NearestNeighbors(n_neighbors=k+1, algorithm="kd_tree")
nn.fit(coords)
distances_tmp, indices_tmp = nn.kneighbors(coords)
indices_tmp = indices_tmp[:, 1:]

neighbor_matrix = np.zeros((n_labels, n_labels), dtype=np.int64)
for code in range(n_labels):
    mask = labels == code
    if not np.any(mask):
        continue
    neigh_labels = labels[indices_tmp[mask].ravel()]
    counts = np.bincount(neigh_labels, minlength=n_labels)
    neighbor_matrix[code, :] = counts

unique_codes, global_counts = np.unique(labels, return_counts=True)
global_probs = global_counts / global_counts.sum()

results_conc = []
for idx_c, code in enumerate(unique_codes):
    n_cells_label = int(global_counts[idx_c])
    frac_cells = float(n_cells_label / n_cells)
    total_neighbors = int(neighbor_matrix[code, :].sum())
    same_label_neighbors = int(neighbor_matrix[code, code])
    same_label_fraction = same_label_neighbors / total_neighbors if total_neighbors > 0 else np.nan
    global_abundance = float(global_probs[idx_c])
    conc_score = same_label_fraction / global_abundance if global_abundance > 0 else np.nan
    results_conc.append({
        "label_code": int(code),
        "label_name": label_names[code],
        "n_cells": n_cells_label,
        "frac_cells": frac_cells,
        "same_label_fraction": same_label_fraction,
        "global_abundance": global_abundance,
        "concentration_score": conc_score,
    })

df_conc = pd.DataFrame(results_conc)
df_conc_sorted = df_conc.sort_values("concentration_score", ascending=False)
print("Top 5 clusters by concentration_score:")
print(df_conc_sorted.head(5))

# Rare concentrated clusters: top 5 by concentration score (as in OBS2)
top_conc = df_conc_sorted.head(5).copy()
rare_codes = top_conc["label_code"].tolist()
rare_labels = top_conc["label_name"].tolist()

# Diffuse clusters: top 3 by abundance (most cells)
df_abund_sorted = df_conc.sort_values("n_cells", ascending=False)
diffuse_conc = df_abund_sorted.head(3).copy()
diffuse_codes = diffuse_conc["label_code"].tolist()
diffuse_labels = diffuse_conc["label_name"].tolist()

print("Rare concentrated cluster codes & labels:", list(zip(rare_codes, rare_labels)))
print("Diffuse cluster codes & labels:", list(zip(diffuse_codes, diffuse_labels)))

# PCA on gene expression (log1p if needed; z-score per gene)
print("\nRunning PCA on all cells and genes...")
if issparse(X):
    X_dense = X.toarray().astype(np.float32)
else:
    X_dense = np.asarray(X, dtype=np.float32)

if log_transform:
    X_dense = np.log1p(X_dense)

# z-score per gene
gene_means = X_dense.mean(axis=0)
gene_stds = X_dense.std(axis=0, ddof=0)
gene_stds[gene_stds == 0] = 1.0
X_scaled = (X_dense - gene_means) / gene_stds

n_pcs = 10
pca = PCA(n_components=n_pcs, random_state=0)
pcs = pca.fit_transform(X_scaled)
print("PCA completed. PC score matrix shape:", pcs.shape)

# Correlate PCs with spatial coordinates
x_coord = coords[:, 0]
y_coord = coords[:, 1]

pc_corrs = []
for i in range(n_pcs):
    pc = pcs[:, i]
    r_x = float(np.corrcoef(pc, x_coord)[0, 1])
    r_y = float(np.corrcoef(pc, y_coord)[0, 1])
    pc_corrs.append({"pc": i+1, "r_x": r_x, "r_y": r_y})

print("\nPC–spatial coordinate correlations (PC, r_x, r_y):")
for c in pc_corrs:
    print(f"PC{c['pc']}: r_x={c['r_x']:.3f}, r_y={c['r_y']:.3f}")

spatial_pcs = [c["pc"] for c in pc_corrs if (abs(c["r_x"]) >= 0.3 or abs(c["r_y"]) >= 0.3)]
print("\nSpatially associated PCs (|r| >= 0.3 with x or y):", spatial_pcs)

# For each spatial PC, compute cluster-level mean scores and extremeness
h2_pc_summary = []

for pc_num in spatial_pcs:
    idx_pc = pc_num - 1
    pc_scores = pcs[:, idx_pc]
    global_mean = float(pc_scores.mean())
    global_std = float(pc_scores.std(ddof=0))
    if global_std == 0:
        continue

    cluster_stats = []
    for code in range(n_labels):
        mask = labels == code
        if not np.any(mask):
            continue
        scores_c = pc_scores[mask]
        mean_c = float(scores_c.mean())
        z_mean = (mean_c - global_mean) / global_std
        cluster_stats.append({
            "code": code,
            "label": label_names[code],
            "mean_score": mean_c,
            "z_mean": z_mean,
        })
    df_pc = pd.DataFrame(cluster_stats)

    rare_df = df_pc[df_pc["code"].isin(rare_codes)].copy()
    diff_df = df_pc[df_pc["code"].isin(diffuse_codes)].copy()

    mean_abs_z_rare = float(np.mean(np.abs(rare_df["z_mean"]))) if not rare_df.empty else np.nan
    mean_abs_z_diff = float(np.mean(np.abs(diff_df["z_mean"]))) if not diff_df.empty else np.nan

    h2_pc_summary.append({
        "pc": pc_num,
        "r_x": float([c for c in pc_corrs if c["pc"] == pc_num][0]["r_x"]),
        "r_y": float([c for c in pc_corrs if c["pc"] == pc_num][0]["r_y"]),
        "mean_abs_z_rare": mean_abs_z_rare,
        "mean_abs_z_diff": mean_abs_z_diff,
        "rare_df": rare_df,
        "diff_df": diff_df,
    })

print("\nH2: Extremeness of rare vs diffuse clusters along spatial PCs:")
for entry in h2_pc_summary:
    print(f"PC{entry['pc']} (r_x={entry['r_x']:.3f}, r_y={entry['r_y']:.3f}): "
          f"mean |z_mean| rare={entry['mean_abs_z_rare']:.2f}, "
          f"diffuse={entry['mean_abs_z_diff']:.2f}")

# Decide KEEP / REFINE / DROP for H2
if not spatial_pcs:
    h2_status = "DROP"
    h2_narrowing = (
        "PCA on all cells and genes yielded principal components with only weak correlations to spatial coordinates "
        "(no PC had |r| ≥ 0.3 with either x or y), so there was no clear evidence for strong gene-expression "
        "gradients aligned with spatial axes. Consequently, rare concentrated clusters could not be meaningfully "
        "interpreted as occupying extremes of spatial gene-expression gradients in this analysis."
    )
elif all(np.isnan(e["mean_abs_z_rare"]) or np.isnan(e["mean_abs_z_diff"]) for e in h2_pc_summary):
    h2_status = "DROP"
    h2_narrowing = (
        "Although some PCs showed moderate correlations with spatial coordinates, cluster-level summaries were not "
        "informative (e.g. due to missing or degenerate statistics), so extremeness of rare versus diffuse clusters "
        "along spatial PCs could not be assessed robustly."
    )
else:
    # Evaluate whether rare clusters are more extreme than diffuse clusters across spatial PCs
    ratios = []
    for e in h2_pc_summary:
        if e["mean_abs_z_diff"] > 0:
            ratios.append(e["mean_abs_z_rare"] / e["mean_abs_z_diff"])
    avg_ratio = float(np.mean(ratios)) if ratios else np.nan

    if ratios and avg_ratio > 1.5:
        h2_status = "KEEP"
        desc_parts = []
        for e in h2_pc_summary:
            desc_parts.append(
                f"PC{e['pc']} (r_x={e['r_x']:.2f}, r_y={e['r_y']:.2f}) with mean |z_mean| "
                f"{e['mean_abs_z_rare']:.2f} for rare clusters vs {e['mean_abs_z_diff']:.2f} for diffuse clusters"
            )
        h2_narrowing = (
            "Several principal components showed moderate correlations with spatial coordinates (e.g. "
            + "; ".join(desc_parts) +
            "). Across these spatial PCs, the average absolute z-scored mean PC score was consistently higher for "
            "rare concentrated clusters than for the most abundant diffuse clusters (average ratio of mean |z| rare/"
            f"diffuse ≈ {avg_ratio:.2f}). This indicates that rare, spatially compact clusters preferentially occupy "
            "the tails of spatially structured gene-expression axes compared with diffuse clusters, supporting the "
            "hypothesis."
        )
    else:
        h2_status = "REFINE"
        desc_parts = []
        for e in h2_pc_summary:
            desc_parts.append(
                f"PC{e['pc']} (r_x={e['r_x']:.2f}, r_y={e['r_y']:.2f}) with mean |z_mean| "
                f"{e['mean_abs_z_rare']:.2f} for rare vs {e['mean_abs_z_diff']:.2f} for diffuse clusters"
            )
        h2_narrowing = (
            "One or more PCs exhibited moderate correlations with spatial coordinates, but the differences in "
            "extremeness between rare concentrated and diffuse clusters along these spatial PCs were modest. For "
            "example, " + "; ".join(desc_parts) +
            ". This suggests that some rare concentrated clusters do lie toward the tails of spatial PCs, but the "
            "pattern is not uniformly strong across all such clusters or PCs. The hypothesis is therefore partially "
            "supported and is best interpreted as indicating that only a subset of rare clusters align with spatial "
            "gene-expression extremes."
        )

h2["status"] = h2_status
h2["narrowing_notes"] = h2_narrowing

print("\nH2 status:", h2_status)
print("H2 narrowing notes (first 400 chars):")
print(h2_narrowing[:400])

# ================================================================
# Assemble final hypotheses.json and hypothesis_brief.md
# ================================================================
final_hypotheses = [h for h in hypotheses if h.get("status") in ("KEEP", "REFINE")]

hypotheses_path = Path(DATA_DIR) / "hypotheses" / "hypotheses.json"
with open(hypotheses_path, "w") as f:
    json.dump(final_hypotheses, f, indent=2)

print("\nWrote final hypotheses.json with", len(final_hypotheses), "hypotheses to:", hypotheses_path)

# Build human-readable brief
exploration_log_path = Path(DATA_DIR) / "hypotheses" / "exploration_log.md"
with open(exploration_log_path, "r") as f:
    explog_text = f.read()
n_obs_count = explog_text.count("OBSERVATION ")

brief_lines = []
brief_lines.append("# Hypothesis Brief")
brief_lines.append("")
brief_lines.append(f"- Dataset: {n_cells} cells × {n_genes} genes, spatial transcriptomics with '{label_col}' clusters.")
brief_lines.append(f"- Phase 1 observations: {n_obs_count} entries logged to exploration_log.md.")
brief_lines.append("")
brief_lines.append("## Retained hypotheses (KEEP/REFINE)")
for h in final_hypotheses:
    brief_lines.append(f"- **{h['id']}** ({h.get('status','')}):")
    brief_lines.append(f"  - **Statement:** {h['statement']}")
    brief_lines.append(f"  - **Grounded in:** {', '.join(h['grounded_in'])}")
    brief_lines.append("  - **Narrowing notes:** " + h.get("narrowing_notes", ""))
    qs = h.get("quality_scores", {})
    brief_lines.append(
        "  - **Quality scores:** "
        f"Derivable={qs.get('derivable','?')}, "
        f"Novel={qs.get('novel','?')}, "
        f"Feasible={qs.get('feasible','?')}, "
        f"Specific={qs.get('specific','?')}, "
        f"Falsifiable={qs.get('falsifiable','?')}."
    )
    brief_lines.append("")

# Also note any dropped hypotheses
dropped = [h for h in hypotheses if h.get("status") == "DROP"]
if dropped:
    brief_lines.append("## Dropped hypotheses")
    for h in dropped:
        brief_lines.append(f"- **{h['id']}**: {h['statement']}")
        brief_lines.append(f"  - Status: DROP")
        brief_lines.append("  - Narrowing notes: " + h.get("narrowing_notes", ""))
        brief_lines.append("")

hypothesis_brief_path = Path(DATA_DIR) / "hypotheses" / "hypothesis_brief.md"
with open(hypothesis_brief_path, "w") as f:
    f.write("\n".join(brief_lines))

print("Wrote hypothesis_brief.md to:", hypothesis_brief_path)
