import numpy as np
import pandas as pd
import textwrap

print("Preparing pairwise co-localization analysis using existing neighbor_matrix...")
print("neighbor_matrix shape:", neighbor_matrix.shape)

n_labels = neighbor_matrix.shape[0]
label_names = list(label_names)  # ensure it's a plain list
global_probs = global_probs  # from previous step
df_conc = df_conc  # already computed concentration info

# Total neighbors per source label (central cells)
source_total_neighbors = neighbor_matrix.sum(axis=1)

pair_rows = []
min_contacts = 50  # filter to reduce noise

for i in range(n_labels):
    for j in range(n_labels):
        if i == j:
            continue
        obs_ij = neighbor_matrix[i, j]
        if obs_ij < min_contacts:
            continue
        total_i = source_total_neighbors[i]
        p_j = global_probs[j]
        exp_ij = total_i * p_j
        if exp_ij <= 0:
            continue
        enrichment = obs_ij / exp_ij
        pair_rows.append({
            "source_code": i,
            "source_name": str(label_names[i]),
            "target_code": j,
            "target_name": str(label_names[j]),
            "observed_contacts": int(obs_ij),
            "expected_contacts": float(exp_ij),
            "enrichment": float(enrichment),
            "source_total_neighbors": int(total_i),
        })

df_pairs = pd.DataFrame(pair_rows)
df_pairs_sorted = df_pairs.sort_values("enrichment", ascending=False)

print("Total directed label pairs with >= min_contacts:", df_pairs.shape[0])
print("\nTop 10 enriched directed label-neighbor pairs (source -> target):")
print(df_pairs_sorted.head(10))

# Build OBSERVATION 3 text
top_n = 10
top_pairs = df_pairs_sorted.head(top_n)

lines = []
lines.append("OBSERVATION 3:")
lines.append(
    f"Using the same spatial k={k} nearest-neighbor graph on {adata.n_obs} cells and {n_labels} '{label_col}' "
    "clusters, we examined pairwise co-localization by comparing, for each directed pair (source cluster A, "
    "neighbor cluster B), the observed number of A→B neighbor contacts to the expectation under random mixing "
    "given the global abundance of B."
)
lines.append(
    f"Considering only directed pairs with at least {min_contacts} observed neighbor contacts, "
    f"we obtained {df_pairs.shape[0]} source–target combinations. Enrichment was defined as "
    "observed_contacts / expected_contacts, where expected_contacts = total_neighbors_from_source * global_frequency_of_target."
)

if not top_pairs.empty:
    lines.append(
        f"The top {top_n} enriched directed cluster–neighbor pairs (source → target) were:"
    )
    for _, row in top_pairs.iterrows():
        lines.append(
            f"- Source cluster {row['source_name']} (code={int(row['source_code'])}) had "
            f"{int(row['observed_contacts'])} neighbors of cluster {row['target_name']} "
            f"(code={int(row['target_code'])}), versus an expected {row['expected_contacts']:.1f} given global "
            f"abundance, yielding an enrichment of {row['enrichment']:.2f}."
        )

# Add a brief summary of label abundances for context
lines.append(
    f"Across all {n_labels} clusters, global abundances spanned from {int(df_conc['n_cells'].min())} to "
    f"{int(df_conc['n_cells'].max())} cells (fractions {df_conc['frac_cells'].min():.4f} to "
    f"{df_conc['frac_cells'].max():.4f} of all cells), indicating that enriched co-localization pairs involve "
    "both common and relatively rare clusters."
)

obs3_text = "\n".join(lines) + "\n\n"

with open(exploration_log_path, "a") as f:
    f.write(textwrap.dedent(obs3_text))

print("\nLogged OBSERVATION 3 (pairwise co-localization) to exploration_log.md")

# Show a small preview of the written OBSERVATION 3
print("\nOBSERVATION 3 preview:")
print("\n".join(lines[:6]))
