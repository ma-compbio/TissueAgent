        "novel": 7,
        "feasible": 8,
        "specific": 7,
        "falsifiable": 7,
    },
}

hypotheses.append(h2)

# Save draft hypotheses
hypotheses_draft_path = Path(DATA_DIR) / "hypotheses" / "hypotheses_draft.json"
with open(hypotheses_draft_path, "w") as f:
    json.dump(hypotheses, f, indent=2)

