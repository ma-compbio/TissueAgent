<execute>
import numpy as np
import pandas as pd
import textwrap

from sklearn.neighbors import NearestNeighbors

# Reuse adata, exploration_log_path, label_col from previous step
print("Current adata shape:", adata.n_obs, "x", adata.n_vars)
print("Using label column for rare-but-tight analysis:", label_col)

coords = adata.obsm.get("spatial", None)
if coords is None:
    raise RuntimeError("Spatial coordinates not found; cannot perform rare-but-tight analysis.")

labels_series = adata.obs[label_col].astype("category")
label_names = labels_series.cat.categories.to_list()
labels = labels_series.cat.codes.to_numpy()
n_labels = len(label_names)
n_cells = adata.n_obs

print("Number of labels:", n_labels)
print("Label categories (first 10):", label_names[:10])

# Build spatial kNN graph
k = 15
print("Fitting NearestNeighbors on spatial coords with k =", k)
nn = NearestNeighbors(n_neighbors=k+1, algorithm="kd_tree")
nn.fit(coords)
distances, indices = nn.kneighbors(coords)

# Drop self (distance 0)
indices = indices[:, 1:]
distances = distances[:, 1:]
print("Neighbor indices shape (after dropping self):", indices.shape)

# Compute neighbor label matrix: for each central label L, counts of neighbor labels M
neighbor_matrix = np.zeros((n_labels, n_labels), dtype=np.int64)

for code in range(n_labels):
    mask = labels == code
    if not np.any(mask):
        continue
    neigh_labels = labels[indices[mask].ravel()]
    counts = np.bincount(neigh_labels, minlength=n_labels)
    neighbor_matrix[code, :] = counts

# Global label abundances
unique_codes, global_counts = np.unique(labels, return_counts=True)
global_probs = global_counts / global_counts.sum()

results = []
for idx, code in enumerate(unique_codes):
    n_cells_label = int(global_counts[idx])
    frac_cells = float(n_cells_label / n_cells)
    total_neighbors = int(neighbor_matrix[code, :].sum())
    same_label_neighbors = int(neighbor_matrix[code, code])
    same_label_fraction = same_label_neighbors / total_neighbors if total_neighbors > 0 else np.nan
    global_abundance = float(global_probs[idx])
    conc_score = same_label_fraction / global_abundance if global_abundance > 0 else np.nan
    results.append({
        "label_code": int(code),
        "label_name": str(label_names[code]),
        "n_cells": n_cells_label,
        "frac_cells": frac_cells,
        "same_label_fraction": same_label_fraction,
        "global_abundance": global_abundance,
        "concentration_score": conc_score,
        "total_neighbors": total_neighbors,
    })

df_conc = pd.DataFrame(results)
df_conc_sorted = df_conc.sort_values("concentration_score", ascending=False)
print("\nTop 10 labels by same-label concentration_score (same_label_fraction / global_abundance):")
print(df_conc_sorted.head(10))

# Select top 5 rare-but-tight labels
top_k = 5
top_conc = df_conc_sorted.head(top_k).copy()

# For each of these, compute top 3 non-self neighboring labels by enrichment
neighbor_enrichment_info = {}
min_neighbor_contacts = 20  # to reduce noise

for _, row in top_conc.iterrows():
    code = int(row["label_code"])
    nbr_counts = neighbor_matrix[code, :].astype(float)
    total_neighbors = nbr_counts.sum()
    observed_frac = nbr_counts / total_neighbors if total_neighbors > 0 else np.zeros_like(nbr_counts)
    expected_frac = global_probs
    with np.errstate(divide="ignore", invalid="ignore"):
        enrichment = np.where(expected_frac > 0, observed_frac / expected_frac, np.nan)
    # Exclude self
    enrichment[code] = np.nan
    # Apply contact threshold
    contact_mask = nbr_counts >= min_neighbor_contacts
    enrichment_filtered = enrichment.copy()
    enrichment_filtered[~contact_mask] = np.nan
    # Get top 3
    top3_idx = np.argsort(enrichment_filtered)[-3:][::-1]
    neighbors_list = []
    for idx2 in top3_idx:
        if np.isnan(enrichment_filtered[idx2]):
            continue
        neighbors_list.append({
            "neighbor_code": int(idx2),
            "neighbor_name": str(label_names[idx2]),
            "neighbor_contacts": int(nbr_counts[idx2]),
            "neighbor_observed_frac": float(observed_frac[idx2]),
            "neighbor_expected_frac": float(expected_frac[idx2]),
            "neighbor_enrichment": float(enrichment_filtered[idx2]),
        })
    neighbor_enrichment_info[code] = neighbors_list

print("\nTop rare-but-tight labels with their top 3 enriched non-self neighbors:")
for _, row in top_conc.iterrows():
    code = int(row["label_code"])
    print(f"Label {row['label_name']} (code={code}): n_cells={row['n_cells']}, "
          f"frac_cells={row['frac_cells']:.4f}, same_label_fraction={row['same_label_fraction']:.3f}, "
          f"concentration_score={row['concentration_score']:.2f}")
    neighs = neighbor_enrichment_info.get(code, [])
    for ninfo in neighs:
        print(f"  -> Neighbor {ninfo['neighbor_name']} (code={ninfo['neighbor_code']}): "
              f"contacts={ninfo['neighbor_contacts']}, "
              f"obs_frac={ninfo['neighbor_observed_frac']:.3f}, "
              f"exp_frac={ninfo['neighbor_expected_frac']:.3f}, "
              f"enrichment={ninfo['neighbor_enrichment']:.2f}")

# Log OBSERVATION 2
lines = []
lines.append("OBSERVATION 2:")
lines.append(
    f"Using k={k} spatial nearest neighbors on {n_cells} cells, we computed same-label neighbor fractions for all "
    f"{n_labels} '{label_col}' clusters. Global cluster abundances ranged from "
    f"{df_conc['n_cells'].min()} to {df_conc['n_cells'].max()} cells per label "
    f"({df_conc['frac_cells'].min():.4f} to {df_conc['frac_cells'].max():.4f} of all cells). "
    f"The top {top_k} clusters by same-label concentration score "
    f"(same_label_fraction / global_abundance) were: "
)

# Summarize top rare-but-tight labels
for _, row in top_conc.iterrows():
    lines.append(
        f"- Label {row['label_name']} (code={int(row['label_code'])}) with {int(row['n_cells'])} cells "
        f"({row['frac_cells']:.4f} of all cells) had same-label neighbors for "
        f"{row['same_label_fraction']:.3f} of its k-nearest neighbors and a concentration score of "
        f"{row['concentration_score']:.2f}."
    )

lines.append(
    "For each of these rare-but-tight clusters, we identified the top 3 non-self neighboring clusters by enrichment "
    "over global abundance among their spatial neighbors (requiring at least "
    f"{min_neighbor_contacts} neighbor contacts per partner label):"
)

for _, row in top_conc.iterrows():
    code = int(row["label_code"])
    neighs = neighbor_enrichment_info.get(code, [])
    if not neighs:
        continue
    detail_parts = []
    for ninfo in neighs:
        detail_parts.append(
            f"{ninfo['neighbor_name']} (code={ninfo['neighbor_code']}, "
            f"{ninfo['neighbor_contacts']} contacts, observed fraction {ninfo['neighbor_observed_frac']:.3f} "
            f"vs expected {ninfo['neighbor_expected_frac']:.3f}, enrichment {ninfo['neighbor_enrichment']:.2f})"
        )
    if detail_parts:
        lines.append(
            f"- Label {row['label_name']} (code={code}) most strongly neighbored: " +
            "; ".join(detail_parts) + "."
        )

obs2_text = "\n".join(lines) + "\n\n"

with open(exploration_log_path, "a") as f:
    f.write(textwrap.dedent(obs2_text))

print("\nLogged OBSERVATION 2 (rare-but-tight analysis) to exploration_log.md")
</execute>

