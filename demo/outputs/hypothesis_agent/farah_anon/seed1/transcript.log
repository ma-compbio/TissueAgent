print("\n=== Exploration log preview (first 600 chars) ===")
print(explog_text[:600])

# We'll base hypotheses on OBSERVATION 1 (dataset structure),
# OBSERVATION 2 (rare-but-tight clusters) and OBSERVATION 3 (enriched neighbor pairs).

hypotheses = []

# Hypothesis H1: interface-specific sub-states within mutually enriched rare clusters
h1 = {
    "id": "H1",
    "statement": (
        "Within the rare, spatially compact clusters that form strongly enriched mutual neighbor pairs "
        "(especially clusters '15' and '30' in the leiden labeling), cells located at inter-cluster interfaces "
        "(i.e. with many neighbors from the partner cluster) exhibit coordinated shifts in multi-gene expression "
        "programs relative to same-cluster cells embedded within homogeneous neighborhoods, indicating "
        "microenvironment-dependent sub-states inside these small communities."
    ),
    "grounded_in": ["OBSERVATION 2", "OBSERVATION 3"],
    "mechanism": (
        "OBSERVATION 2 shows that several clusters, including those labeled '15' and '30', are rare but highly "
        "self-associated in space, while OBSERVATION 3 reveals that clusters '15' and '30' are strongly enriched "
        "as each other's neighbors beyond what global abundances predict. If these small, tightly packed "
        "communities reflect specialized microenvironments, then cells at the interfaces between the two partner "
        "clusters should show distinct, shared expression programs compared with interior cells that mainly "
        "neighbor their own cluster."
    ),
    "test_plan": (
        "1. Use the existing k=15 spatial nearest-neighbor graph (indices array) and leiden labels to focus on "
        "clusters '15' and '30' (codes 15 and 28 in the categorical encoding).\n"
        "2. For each cell in cluster '15', compute the fraction of its 15 neighbors that belong to cluster '30'; "
        "define 'interface_15' cells as those with at least 3 of 15 neighbors from cluster '30', and "
        "'interior_15' cells as those with 0 neighbors from cluster '30' and at least 12 of 15 neighbors from "
        "cluster '15'. Apply the analogous definition for cluster '30' with respect to neighbors from '15'.\n"
        "3. For each cluster separately (15 and 30), perform differential expression between interface and "
        "interior subsets across all 238 genes using a non-parametric test (e.g. Wilcoxon rank-sum), after "
        "log1p-transforming counts if they are not already log-normalized. Compute per-gene log fold-change and "
        "Benjamini–Hochberg FDR-adjusted p-values.\n"
        "4. Define interface-associated gene programs as genes with FDR < 0.05 and absolute log fold-change above "
        "a small threshold (e.g. 0.25) in interface vs interior comparisons. Identify (a) the number of such "
        "genes per cluster and (b) the intersection of interface-upregulated genes shared between clusters '15' "
        "and '30'.\n"
        "5. Compare these results to a null by repeating step 3 for a control split where each cluster's cells "
        "are randomly partitioned into two groups of the same sizes as the interface/interior sets, and record "
        "how many significant genes are detected under random splitting.\n"
    ),
    "predicted_outcome": (
        "If the hypothesis holds, both clusters '15' and '30' will show substantial sets of genes (on the order "
