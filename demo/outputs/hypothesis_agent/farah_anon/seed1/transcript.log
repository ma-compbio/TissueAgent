    h1_results = {}

    for val, info in cluster_interface_info.items():
        interf_idx = info["interface_indices"]
        interi_idx = info["interior_indices"]
        n_intf, n_intr = interf_idx.size, interi_idx.size
        print(f"H1 DE check for cluster {val}: n_intf={n_intf}, n_intr={n_intr}")
        if n_intf < 10 or n_intr < 10:
            print(f"Cluster {val}: insufficient cells for DE.")
            h1_results[val] = {
                "n_interface": int(n_intf),
