if all(h1_results.get(val, {}).get("de_performed", False) for val in target_values):
    int_up_15 = set(h1_results[15]["interface_up_genes"])
    int_up_30 = set(h1_results[30]["interface_up_genes"])
    overlap_interface_up = sorted(list(int_up_15 & int_up_30))
    print("\nOverlap of interface-up genes between clusters 15 and 30: n_overlap=", len(overlap_interface_up))

# Decide status for H1
if not any(h1_results.get(val, {}).get("de_performed", False) for val in target_values):
    h1_status = "DROP"
    h1_narrowing = (
        "For both clusters 15 and 30, either interface or interior subsets contained fewer than ten cells under the "
        "stringent neighborhood criteria, preventing robust differential expression analysis. Without sufficient "
        "cells to contrast interface and interior states, there is no empirical support for interface-specific "
        "sub-states in these clusters in this dataset."
    )
elif all(h1_results.get(val, {}).get("de_performed", False) for val in target_values):
    sig_real_15 = h1_results[15]["n_sig_genes"]
    sig_real_30 = h1_results[30]["n_sig_genes"]
    sig_ctrl_15 = h1_results[15]["n_sig_genes_ctrl"]
    sig_ctrl_30 = h1_results[30]["n_sig_genes_ctrl"]
    n_overlap = len(overlap_interface_up)

    if (sig_real_15 > max(1, 2 * sig_ctrl_15) and
        sig_real_30 > max(1, 2 * sig_ctrl_30) and
        n_overlap >= 3):
        h1_status = "KEEP"
    else:
        h1_status = "REFINE"

    h1_narrowing = (
        f"Interface vs interior contrasts were feasible in both clusters 15 and 30. Cluster 15 had "
        f"{sig_real_15} genes with FDR < 0.05 and |log fold-change| > 0.25, compared with {sig_ctrl_15} such "
        f"genes in a size-matched random split; cluster 30 had {sig_real_30} versus {sig_ctrl_30} in the same "
        f"comparison. The overlap of interface-upregulated genes between the two clusters was {n_overlap} "
        f"(e.g., {', '.join(overlap_interface_up[:5])} among the first if present). These results indicate that "
        f"interface cells are transcriptionally distinct within at least one of the two clusters, but shared "
        f"interface programs across both clusters are limited, so the hypothesis is better interpreted as "
        f"cluster-specific rather than fully shared."
    )
else:
    # Only one of the clusters has DE
    de_cluster = 15 if h1_results.get(15, {}).get("de_performed", False) else 30
    res = h1_results[de_cluster]
    h1_status = "REFINE"
    h1_narrowing = (
        f"Differential expression between interface and interior subsets was only feasible for cluster {de_cluster} "
        f"(interface={res['n_interface']}, interior={res['n_interior']}), while the partner cluster lacked enough "
        f"cells in one of the groups (<10). In cluster {de_cluster}, interface vs interior comparison yielded "
        f"{res['n_sig_genes']} genes with FDR < 0.05 and |log fold-change| > 0.25, compared with "
        f"{res['n_sig_genes_ctrl']} significant genes in a size-matched random split. This supports the existence "
        f"of interface-associated sub-states within cluster {de_cluster}, but we cannot generalize this to a "
        f"shared program across both clusters 15 and 30."
    )

h1["status"] = h1_status
h1["narrowing_notes"] = h1_narrowing

print("\nH1 status:", h1_status)
print("H1 narrowing (first 400 chars):")
print(h1_narrowing[:400])

# ==============================================================
# H2: Rare concentrated clusters at extremes of spatial PCs
# ==============================================================

h2 = next(h for h in hypotheses if h["id"] == "H2")

print("\nRecomputing concentration scores for H2...")
k = 15
nn2 = NearestNeighbors(n_neighbors=k+1, algorithm="kd_tree")
nn2.fit(coords)
d2, idx2 = nn2.kneighbors(coords)
idx2 = idx2[:, 1:]

neighbor_matrix = np.zeros((n_labels, n_labels), dtype=np.int64)
for code in range(n_labels):
    mask = labels == code
    if not np.any(mask):
        continue
    neigh_labels = labels[idx2[mask].ravel()]
    counts = np.bincount(neigh_labels, minlength=n_labels)
    neighbor_matrix[code, :] = counts

unique_codes, global_counts = np.unique(labels, return_counts=True)
global_probs = global_counts / global_counts.sum()

results_conc = []
for idx_c, code in enumerate(unique_codes):
    n_cells_label = int(global_counts[idx_c])
    frac_cells = float(n_cells_label / n_cells)
    total_neighbors = int(neighbor_matrix[code, :].sum())
    same_label_neighbors = int(neighbor_matrix[code, code])
    same_label_fraction = same_label_neighbors / total_neighbors if total_neighbors > 0 else np.nan
    global_abundance = float(global_probs[idx_c])
    conc_score = same_label_fraction / global_abundance if global_abundance > 0 else np.nan
    results_conc.append({
        "label_code": int(code),
        "label_name": label_names[code],
        "n_cells": n_cells_label,
        "frac_cells": frac_cells,
        "same_label_fraction": same_label_fraction,
        "global_abundance": global_abundance,
        "concentration_score": conc_score,
    })

df_conc = pd.DataFrame(results_conc)
df_conc_sorted = df_conc.sort_values("concentration_score", ascending=False)
print("Top 5 by concentration score:")
print(df_conc_sorted.head(5))

top_conc = df_conc_sorted.head(5).copy()
rare_codes = top_conc["label_code"].tolist()
rare_labels = top_conc["label_name"].tolist()

df_abund_sorted = df_conc.sort_values("n_cells", ascending=False)
diffuse_conc = df_abund_sorted.head(3).copy()
diffuse_codes = diffuse_conc["label_code"].tolist()
diffuse_labels = diffuse_conc["label_name"].tolist()

print("Rare concentrated codes/labels:", list(zip(rare_codes, rare_labels)))
print("Diffuse (abundant) codes/labels:", list(zip(diffuse_codes, diffuse_labels)))

# PCA with explicit z-scoring
print("\nRunning PCA for H2...")
if issparse(X):
    X_dense = X.toarray().astype(np.float32)
else:
    X_dense = np.asarray(X, dtype=np.float32)

if log_transform:
    X_dense = np.log1p(X_dense)

gene_means = X_dense.mean(axis=0)
gene_stds = X_dense.std(axis=0, ddof=0)
zero_std_mask = gene_stds == 0
if zero_std_mask.sum() > 0:
    gene_stds[zero_std_mask] = 1.0

X_scaled = (X_dense - gene_means) / gene_stds
print("X_scaled shape:", X_scaled.shape)

n_pcs = 10
pca = PCA(n_components=n_pcs, random_state=0)
pcs = pca.fit_transform(X_scaled)
print("PCA done. pcs shape:", pcs.shape)

x_coord = coords[:, 0]
y_coord = coords[:, 1]

pc_corrs = []
for i in range(n_pcs):
    pc = pcs[:, i]
    r_x = float(np.corrcoef(pc, x_coord)[0, 1])
    r_y = float(np.corrcoef(pc, y_coord)[0, 1])
    pc_corrs.append({"pc": i+1, "r_x": r_x, "r_y": r_y})

print("\nPC–spatial correlations:")
for c in pc_corrs:
    print(f"PC{c['pc']}: r_x={c['r_x']:.3f}, r_y={c['r_y']:.3f}")

spatial_pcs = [c["pc"] for c in pc_corrs if (abs(c["r_x"]) >= 0.3 or abs(c["r_y"]) >= 0.3)]
print("Spatial PCs (|r|>=0.3):", spatial_pcs)

h2_pc_summary = []
for pc_num in spatial_pcs:
    idx_pc = pc_num - 1
    pc_scores = pcs[:, idx_pc]
    global_mean = float(pc_scores.mean())
    global_std = float(pc_scores.std(ddof=0))
    if global_std == 0:
        continue
    cluster_stats = []
    for code in range(n_labels):
        mask = labels == code
        if not np.any(mask):
            continue
        scores_c = pc_scores[mask]
        mean_c = float(scores_c.mean())
        z_mean = (mean_c - global_mean) / global_std
        cluster_stats.append({
            "code": code,
            "label": label_names[code],
            "mean_score": mean_c,
            "z_mean": z_mean,
        })
    df_pc = pd.DataFrame(cluster_stats)
    rare_df = df_pc[df_pc["code"].isin(rare_codes)].copy()
    diff_df = df_pc[df_pc["code"].isin(diffuse_codes)].copy()
    mean_abs_z_rare = float(np.mean(np.abs(rare_df["z_mean"]))) if not rare_df.empty else np.nan
    mean_abs_z_diff = float(np.mean(np.abs(diff_df["z_mean"]))) if not diff_df.empty else np.nan
    h2_pc_summary.append({
        "pc": pc_num,
        "r_x": float([c for c in pc_corrs if c["pc"] == pc_num][0]["r_x"]),
        "r_y": float([c for c in pc_corrs if c["pc"] == pc_num][0]["r_y"]),
        "mean_abs_z_rare": mean_abs_z_rare,
        "mean_abs_z_diff": mean_abs_z_diff,
    })

print("\nH2: mean |z_mean| for rare vs diffuse clusters along spatial PCs:")
for e in h2_pc_summary:
    print(f"PC{e['pc']} (r_x={e['r_x']:.3f}, r_y={e['r_y']:.3f}): "
          f"rare={e['mean_abs_z_rare']:.2f}, diffuse={e['mean_abs_z_diff']:.2f}")

# Decide status for H2
if not spatial_pcs:
    h2_status = "DROP"
    h2_narrowing = (
        "No principal component showed a moderate correlation with spatial coordinates (|r| ≥ 0.3), indicating an "
        "absence of clear large-scale gene-expression gradients aligned with x or y. Under these conditions, it is "
        "not meaningful to assess whether rare concentrated clusters occupy extremes of spatial PCs."
    )
else:
    ratios = []
    for e in h2_pc_summary:
        if e["mean_abs_z_diff"] > 0:
            ratios.append(e["mean_abs_z_rare"] / e["mean_abs_z_diff"])
    avg_ratio = float(np.mean(ratios)) if ratios else np.nan

    desc_parts = []
    for e in h2_pc_summary:
        desc_parts.append(
            f"PC{e['pc']} (r_x={e['r_x']:.2f}, r_y={e['r_y']:.2f}) with mean |z_mean| "
            f"{e['mean_abs_z_rare']:.2f} for rare vs {e['mean_abs_z_diff']:.2f} for diffuse clusters"
        )

    if ratios and avg_ratio > 1.5:
        h2_status = "KEEP"
        h2_narrowing = (
            "Several principal components showed moderate correlations with spatial coordinates, and rare "
            "concentrated clusters consistently occupied more extreme positions along these spatial PCs than the "
            "most abundant diffuse clusters. Specifically, " + "; ".join(desc_parts) +
            f". Across these PCs, the average ratio of mean |z_mean| for rare versus diffuse clusters was "
            f"~{avg_ratio:.2f}, supporting the idea that rare, spatially compact communities lie at the tails of "
            "spatial gene-expression gradients."
        )
    else:
        h2_status = "REFINE"
        h2_narrowing = (
            "At least one principal component was moderately correlated with spatial coordinates, but the difference "
            "in extremeness between rare concentrated and diffuse clusters was mixed rather than uniformly strong. "
            "For example, " + "; ".join(desc_parts) +
            f". The average ratio of mean |z_mean| for rare versus diffuse clusters across spatial PCs was about "
            f"{avg_ratio:.2f}, indicating that some rare clusters lie toward spatial PC tails while others do not. "
            "Thus, rare concentrated clusters are linked to extremes of spatial gene-expression gradients only for a "
            "subset of PCs and clusters, and the hypothesis is partially supported."
        )

h2["status"] = h2_status
h2["narrowing_notes"] = h2_narrowing

print("\nH2 status:", h2_status)
print("H2 narrowing (first 400 chars):")
print(h2_narrowing[:400])

# ==============================================================
# Assemble final hypotheses.json and hypothesis_brief.md
# ==============================================================

final_hypotheses = [h for h in hypotheses if h.get("status") in ("KEEP", "REFINE")]
dropped_hypotheses = [h for h in hypotheses if h.get("status") == "DROP"]

hypotheses_path = Path(DATA_DIR) / "hypotheses" / "hypotheses.json"
with open(hypotheses_path, "w") as f:
    json.dump(final_hypotheses, f, indent=2)
print("\nWrote final hypotheses.json with", len(final_hypotheses), "hypotheses to:", hypotheses_path)

# Build human-readable brief
exploration_log_path = Path(DATA_DIR) / "hypotheses" / "exploration_log.md"
with open(exploration_log_path, "r") as f:
    explog_text = f.read()
n_obs_count = explog_text.count("OBSERVATION ")

brief_lines = []
brief_lines.append("# Hypothesis Brief")
brief_lines.append("")
brief_lines.append(f"- Dataset: {n_cells} cells × {n_genes} genes, spatial transcriptomics with '{label_col}' clusters.")
brief_lines.append(f"- Phase 1 observations: {n_obs_count} entries logged to exploration_log.md.")
brief_lines.append("")
brief_lines.append("## Retained hypotheses (KEEP/REFINE)")
for h in final_hypotheses:
    brief_lines.append(f"- **{h['id']}** ({h.get('status','')}):")
    brief_lines.append(f"  - **Statement:** {h['statement']}")
    brief_lines.append(f"  - **Grounded in:** {', '.join(h['grounded_in'])}")
    brief_lines.append("  - **Narrowing notes:** " + h.get("narrowing_notes", ""))
    qs = h.get("quality_scores", {})
    brief_lines.append(
        "  - **Quality scores:** "
        f"Derivable={qs.get('derivable','?')}, "
        f"Novel={qs.get('novel','?')}, "
        f"Feasible={qs.get('feasible','?')}, "
        f"Specific={qs.get('specific','?')}, "
        f"Falsifiable={qs.get('falsifiable','?')}."
    )
    brief_lines.append("")

if dropped_hypotheses:
    brief_lines.append("## Dropped hypotheses")
    for h in dropped_hypotheses:
        brief_lines.append(f"- **{h['id']}**: {h['statement']}")
        brief_lines.append("  - Status: DROP")
        brief_lines.append("  - Narrowing notes: " + h.get("narrowing_notes", ""))
        brief_lines.append("")

hypothesis_brief_path = Path(DATA_DIR) / "hypotheses" / "hypothesis_brief.md"
with open(hypothesis_brief_path, "w") as f:
    f.write("\n".join(brief_lines))

print("Wrote hypothesis_brief.md to:", hypothesis_brief_path)
