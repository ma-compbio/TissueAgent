from pathlib import Path
import json, os, textwrap

import numpy as np
import pandas as pd
import anndata as ad

data_dir = Path(DATA_DIR)
print("DATA_DIR:", data_dir)

# Ensure hypotheses dir exists
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)

# ---- Read limited background ----
bg_path_md = data_dir / "briefs" / "background.md"
bg_path_fallback = data_dir / "briefs" / "paper_summary.txt"

background_text = ""
if bg_path_md.exists():
    with open(bg_path_md, "r") as f:
        background_text = f.read()
        print("Loaded background.md, length:", len(background_text))
elif bg_path_fallback.exists():
    with open(bg_path_fallback, "r") as f:
        background_text = f.read()
        print("Loaded paper_summary.txt, length:", len(background_text))
else:
    print("No background file found at", bg_path_md, "or", bg_path_fallback)

print("\n=== BACKGROUND PREVIEW (first 500 chars) ===")
print(background_text[:500])

# ---- Load AnnData dataset ----
adata_path = data_dir / "dataset" / "dataset_farah_anon.h5ad"
print("\nLoading AnnData from:", adata_path)
adata = ad.read_h5ad(adata_path)
print("AnnData loaded. Shape (cells x genes):", adata.n_obs, "x", adata.n_vars)

# Basic inventory
print("\nOBS columns:", list(adata.obs.columns))
print("VAR columns:", list(adata.var.columns))
print("OBSM keys:", list(adata.obsm.keys()))

# Try to identify spatial coordinates
spatial_coords = None
if "spatial" in adata.obsm_keys():
    spatial_coords = adata.obsm["spatial"]
    print("Using .obsm['spatial'] for coordinates. Shape:", spatial_coords.shape)
else:
    # Common conventions: 'x', 'y' or 'X_coord', 'Y_coord'
    cand_x = [c for c in adata.obs.columns if c.lower() in ("x", "x_coord", "x_coord_pix", "imagerow")]
    cand_y = [c for c in adata.obs.columns if c.lower() in ("y", "y_coord", "y_coord_pix", "imagecol")]
    if cand_x and cand_y:
        spatial_coords = adata.obs[[cand_x[0], cand_y[0]]].to_numpy()
        print(f"Using obs['{cand_x[0]}','{cand_y[0]}'] for coordinates. Shape:", spatial_coords.shape)
    else:
        print("WARNING: No obvious spatial coordinates found in .obsm or .obs; downstream spatial analyses may fail.")
print("Coordinate example (first 5 rows):")
if spatial_coords is not None:
    print(spatial_coords[:5])
else:
    print("None")

# Try to identify a cell-type / cluster label
label_col_candidates_order = [
    "cell_type", "celltype", "cell_types", "celltype_major", "cell_type_major",
    "annot", "annotation", "cluster", "leiden", "louvain"
]
label_col = None
for cand in label_col_candidates_order:
    if cand in adata.obs.columns:
        label_col = cand
        break

if label_col is None:
    # Fallback: first categorical column
    for col in adata.obs.columns:
        if pd.api.types.is_categorical_dtype(adata.obs[col]) or adata.obs[col].dtype == "category":
            label_col = col
            break

print("\nSelected label column for cell-type/cluster analyses:", label_col)
if label_col is not None:
    value_counts = adata.obs[label_col].value_counts()
    print("Distinct labels (n):", value_counts.shape[0])
    print("Top 10 labels by count:")
    print(value_counts.head(10))

# Write initial exploration_log.md header if not exists
exploration_log_path = hyp_dir / "exploration_log.md"
if not exploration_log_path.exists():
    with open(exploration_log_path, "w") as f:
        f.write("# Exploration Log\n\n")
    print("\nInitialized new exploration_log.md")
else:
    print("\nexploration_log.md already exists; will append new observations.")

# Log OBSERVATION 1: dataset inventory
obs_text = textwrap.dedent(f"""
OBSERVATION 1:
The dataset contains {adata.n_obs} cells and {adata.n_vars} genes. The selected label column is '{label_col}' with {adata.obs[label_col].nunique() if label_col is not None else 0} distinct labels; the most abundant label has {int(value_counts.iloc[0]) if label_col is not None else 0} cells and the 10 most frequent labels together account for {int(value_counts.head(10).sum()) if label_col is not None else 0} cells. Spatial coordinates are {'available' if spatial_coords is not None else 'not available'}; when present, the coordinate matrix has shape {spatial_coords.shape if spatial_coords is not None else '(NA)'} with example entries {spatial_coords[:3].tolist() if spatial_coords is not None else 'NA'}. The observation and feature metadata include {len(adata.obs.columns)} obs columns and {len(adata.var.columns)} var columns, with OBS columns {list(adata.obs.columns)[:8]} (first 8 shown).
""").strip() + "\n\n"

with open(exploration_log_path, "a") as f:
    f.write(obs_text)

print("\nLogged OBSERVATION 1 to exploration_log.md")
