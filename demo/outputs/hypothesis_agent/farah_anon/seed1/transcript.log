        f"Derivable={qs.get('derivable','?')}, "
        f"Novel={qs.get('novel','?')}, "
        f"Feasible={qs.get('feasible','?')}, "
        f"Specific={qs.get('specific','?')}, "
        f"Falsifiable={qs.get('falsifiable','?')}."
    )
    brief_lines.append("")

if dropped_hypotheses:
    brief_lines.append("## Dropped hypotheses")
    for h in dropped_hypotheses:
        brief_lines.append(f"- **{h['id']}**: {h['statement']}")
        brief_lines.append("  - Status: DROP")
        brief_lines.append("  - Narrowing notes: " + h.get("narrowing_notes", ""))
        brief_lines.append("")

hypothesis_brief_path = Path(DATA_DIR) / "hypotheses" / "hypothesis_brief.md"
with open(hypothesis_brief_path, "w") as f:
    f.write("\n".join(brief_lines))

print("Wrote hypothesis_brief.md to:", hypothesis_brief_path)
