from pathlib import Path
import json, os
import pandas as pd
import numpy as np
import anndata as ad

base = Path(DATA_DIR)
print("DATA_DIR:", base)

# Read limited background
bg_path = base / "briefs" / "background.md"
fallback_bg = base / "briefs" / "paper_summary.txt"
background_text = None
if bg_path.exists():
    background_text = bg_path.read_text()[:2000]
    print("Loaded background.md (first 500 chars):\n", background_text[:500])
elif fallback_bg.exists():
    background_text = fallback_bg.read_text()[:2000]
    print("Loaded paper_summary.txt (first 500 chars):\n", background_text[:500])
else:
    print("No background file found.")

# Optional data inventory
inv_path = base / "tables" / "data_inventory.tsv"
if inv_path.exists():
    inv = pd.read_csv(inv_path, sep="\t")
    print("Data inventory head:\n", inv.head())
else:
    print("No data_inventory.tsv found.")

# Load AnnData
adata_path = base / "dataset" / "dataset_farah_anon.h5ad"
print("Loading AnnData from:", adata_path)
adata = ad.read_h5ad(adata_path)
print(adata)

# Basic inventory: obs columns, var columns, obsm keys
print("obs columns:", list(adata.obs.columns))
print("var columns:", list(adata.var.columns))
print("obsm keys:", list(adata.obsm.keys()))
print("uns keys:", list(adata.uns.keys()))

# Identify candidate cell-type / cluster label columns
candidate_label_cols = []
for col in adata.obs.columns:
    if any(k in col.lower() for k in ["celltype", "cell_type", "cell type", "cluster", "leiden", "annotation", "label", "ctype"]):
        candidate_label_cols.append(col)
print("Candidate label columns:", candidate_label_cols)

# Show value counts for candidates
for col in candidate_label_cols:
    vc = adata.obs[col].value_counts().head(20)
    print(f"Value counts for {col} (top 20):\n", vc, "\n")

# Try to detect spatial coordinates
spatial_keys = []
if "spatial" in adata.obsm:
    spatial_keys.append("spatial")
for key in adata.obsm.keys():
    if key != "spatial" and adata.obsm[key].shape[1] in (2,3):
        spatial_keys.append(key)
print("Possible spatial obsm keys (2-3 dims):", spatial_keys)

coord_cols = [c for c in adata.obs.columns if c.lower() in ("x", "y", "x_coord", "y_coord", "x_coordinate", "y_coordinate", "pxl_col_in_fullres", "pxl_row_in_fullres")]
print("Possible spatial obs coordinate columns:", coord_cols)

# Ensure hypotheses directory and empty exploration_log (truncate if exists for clean run)
hyp_dir = base / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
exploration_log_path = hyp_dir / "exploration_log.md"
with open(exploration_log_path, "w") as f:
    f.write("# Exploration Log\n\n")
print("Initialized exploration_log.md at:", exploration_log_path)
