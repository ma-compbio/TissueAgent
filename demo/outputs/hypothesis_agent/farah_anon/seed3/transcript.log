            h2["statement"] = (
                "PW–PAA–PM micro-communities form spatially distinct stromal niches that differ transcriptionally "
                "from diffuse PM regions, but the enrichment for extracellular-matrix–associated genes is modest "
                "in this panel."
            )
            h2["narrowing_notes"] = (
                f"H2 partially supported: niche-core vs distant PM comparison yields "
                f"{sig_H2.shape[0]} niche-upregulated genes, of which {ecm_up.shape[0]} match a broad ECM-like "
                f"set (e.g., {', '.join(ecm_up['gene'].head(5).tolist()) if ecm_up.shape[0] > 0 else 'none'}). "
                "This indicates that PW–PAA–PM regions have a distinct program relative to diffuse PM, but the "
                "evidence for a strongly ECM-dominated signature is limited by the available gene panel."
            )
    else:
        h2["status"] = "REFINE"
        h2["statement"] = (
            "PW–PAA–PM micro-communities are spatially distinct, but the available numbers of niche-core and "
