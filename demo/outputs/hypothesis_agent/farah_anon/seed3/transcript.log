import numpy as np
import pandas as pd
from pathlib import Path
import json

# Phase 3: execute test plans and narrow hypotheses

base = Path(DATA_DIR)
hyp_dir = base / "hypotheses"
draft_path = hyp_dir / "hypotheses_draft.json"

# ---- Load draft hypotheses ----
with open(draft_path, "r") as f:
    hypotheses = json.load(f)
print("Loaded hypotheses_draft.json with", len(hypotheses), "entries.")

# ---- Basic dataset structures ----
labels = adata.obs["Populations"].astype("category")
label_names = labels.cat.categories.tolist()
codes = labels.cat.codes.to_numpy()
n_cells, n_genes = adata.n_obs, adata.n_vars
genes = np.array(adata.var_names)

print("n_cells:", n_cells, "n_genes:", n_genes)
print("Populations:", label_names)

# Spatial neighbors (k=15 incl. self, we use 14 non-self as before)
from sklearn.neighbors import NearestNeighbors

coords = adata.obsm["spatial"]
try:
    nbrs
    nbr_labels
    print("Using existing neighbor graph.")
except NameError:
    print("Recomputing neighbor graph.")
    k = 15
    nn = NearestNeighbors(n_neighbors=k, algorithm="auto", n_jobs=-1)
    nn.fit(coords)
    nbrs = nn.kneighbors(coords, return_distance=False)[:, 1:]
    nbr_labels = codes[nbrs]

# Expression matrix as dense array
X = adata.X
try:
    import scipy.sparse as sp
    if sp.issparse(X):
        X = X.toarray()
    else:
        X = np.asarray(X)
except Exception:
    X = np.asarray(X)

print("Expression matrix shape (dense):", X.shape)

# ---- Helpers: BH-FDR and DE testing ----
def benjamini_hochberg(pvals):
    pvals = np.asarray(pvals, dtype=float)
    n = pvals.size
    order = np.argsort(pvals)
    ranks = np.arange(1, n + 1)
    q = np.empty(n, dtype=float)
    q[order] = pvals[order] * n / ranks
    q = np.minimum.accumulate(q[::-1])[::-1]
    q[q > 1] = 1.0
    return q

from scipy.stats import mannwhitneyu

def de_mannwhitney(idx_group1, idx_group2, X_matrix, gene_names):
    idx_group1 = np.asarray(idx_group1, dtype=int)
    idx_group2 = np.asarray(idx_group2, dtype=int)
    n_genes_local = X_matrix.shape[1]
    pvals = np.ones(n_genes_local, dtype=float)
    log2fc = np.zeros(n_genes_local, dtype=float)

    for g in range(n_genes_local):
        x1 = X_matrix[idx_group1, g]
        x2 = X_matrix[idx_group2, g]
        if x1.size < 5 or x2.size < 5:
            pvals[g] = 1.0
            log2fc[g] = 0.0
            continue
        if np.all(x1 == x1[0]) and np.all(x2 == x2[0]) and x1[0] == x2[0]:
            pvals[g] = 1.0
            log2fc[g] = 0.0
            continue
        try:
            res = mannwhitneyu(x1, x2, alternative="two-sided")
            pvals[g] = res.pvalue
            m1 = float(x1.mean())
            m2 = float(x2.mean())
            log2fc[g] = np.log2(m1 + 1e-9) - np.log2(m2 + 1e-9)
        except Exception as e:
            pvals[g] = 1.0
            log2fc[g] = 0.0

    qvals = benjamini_hochberg(pvals)
    df = pd.DataFrame({
        "gene": gene_names,
        "pval": pvals,
        "qval": qvals,
        "log2FC": log2fc
    })
    df.sort_values("qval", inplace=True)
    return df

# Map population label to code
label_to_code = {lab: i for i, lab in enumerate(label_names)}

# Container to record which hypotheses are dropped / refined / kept
id_to_idx = {h["id"]: i for i, h in enumerate(hypotheses)}

# =========================
# H1: PX–PY interface niche
# =========================
print("\n=== Testing H1 (PX–PY interface program) ===")
h1 = hypotheses[id_to_idx["H1"]]

if "PX" in label_to_code and "PY" in label_to_code:
    code_PX = label_to_code["PX"]
    code_PY = label_to_code["PY"]

    mask_PX = (codes == code_PX)
    mask_PY = (codes == code_PY)

    nbr_labels_local = codes[nbrs]

    # Interface PX: at least one PY neighbor
    nbr_labels_PX = nbr_labels_local[mask_PX]
    has_PY_neighbor = (nbr_labels_PX == code_PY).any(axis=1)
    idx_PX_all = np.where(mask_PX)[0]
    idx_PX_interface = idx_PX_all[has_PY_neighbor]
    idx_PX_noninterface = idx_PX_all[~has_PY_neighbor]

    # Interface PY: at least one PX neighbor
    nbr_labels_PY = nbr_labels_local[mask_PY]
    has_PX_neighbor = (nbr_labels_PY == code_PX).any(axis=1)
    idx_PY_all = np.where(mask_PY)[0]
    idx_PY_interface = idx_PY_all[has_PX_neighbor]
    idx_PY_noninterface = idx_PY_all[~has_PX_neighbor]

    print("PX cells total:", mask_PX.sum(),
          "interface:", idx_PX_interface.size,
          "non-interface:", idx_PX_noninterface.size)
    print("PY cells total:", mask_PY.sum(),
          "interface:", idx_PY_interface.size,
          "non-interface:", idx_PY_noninterface.size)

    # Minimum cell count to run DE sensibly
    min_cells = 20
    if (idx_PX_interface.size >= min_cells and idx_PX_noninterface.size >= min_cells and
        idx_PY_interface.size >= min_cells and idx_PY_noninterface.size >= min_cells):

        # DE for PX
        de_PX = de_mannwhitney(idx_PX_interface, idx_PX_noninterface, X, genes)
        sig_PX = de_PX[(de_PX["qval"] < 0.05) & (de_PX["log2FC"] > 0)]
        print("PX interface vs non-interface: significant up genes:", sig_PX.shape[0])

        # DE for PY
        de_PY = de_mannwhitney(idx_PY_interface, idx_PY_noninterface, X, genes)
        sig_PY = de_PY[(de_PY["qval"] < 0.05) & (de_PY["log2FC"] > 0)]
        print("PY interface vs non-interface: significant up genes:", sig_PY.shape[0])

        shared_up = np.intersect1d(sig_PX["gene"].values, sig_PY["gene"].values)
        print("Shared upregulated genes in interface PX and PY:", shared_up.size)
        if shared_up.size > 0:
            print("Shared genes (up to 10):", shared_up[:10])

        # If there is a decent shared module (>=5 genes), check separation via PCA
        from sklearn.decomposition import PCA

        separation_info = {}
        if shared_up.size >= 5:
            shared_idx = np.array([np.where(genes == g)[0][0] for g in shared_up])

            # For PX
            idx_all_PX = np.concatenate([idx_PX_interface, idx_PX_noninterface])
            group_PX = np.array([1] * idx_PX_interface.size + [0] * idx_PX_noninterface.size)
            X_PX = X[np.ix_(idx_all_PX, shared_idx)]
            pca = PCA(n_components=1)
            pc1_PX = pca.fit_transform(X_PX)[:, 0]
            med_int_PX = float(np.median(pc1_PX[group_PX == 1]))
            med_non_PX = float(np.median(pc1_PX[group_PX == 0]))
            separation_PX = med_int_PX - med_non_PX

            # For PY
            idx_all_PY = np.concatenate([idx_PY_interface, idx_PY_noninterface])
            group_PY = np.array([1] * idx_PY_interface.size + [0] * idx_PY_noninterface.size)
            X_PY = X[np.ix_(idx_all_PY, shared_idx)]
            pca = PCA(n_components=1)
            pc1_PY = pca.fit_transform(X_PY)[:, 0]
            med_int_PY = float(np.median(pc1_PY[group_PY == 1]))
            med_non_PY = float(np.median(pc1_PY[group_PY == 0]))
            separation_PY = med_int_PY - med_non_PY

            separation_info = {
                "PX_median_PC1_interface": med_int_PX,
                "PX_median_PC1_noninterface": med_non_PX,
                "PX_PC1_separation": separation_PX,
                "PY_median_PC1_interface": med_int_PY,
                "PY_median_PC1_noninterface": med_non_PY,
                "PY_PC1_separation": separation_PY
            }
            print("PX PC1 separation (interface - non):", separation_PX)
            print("PY PC1 separation (interface - non):", separation_PY)
        else:
            shared_idx = np.array([], dtype=int)
            separation_info = {}

        # Decide KEEP vs REFINE based on shared module
        if shared_up.size >= 5:
            h1["status"] = "KEEP"
            h1["narrowing_notes"] = (
                f"H1 supported: PX and PY interface cells are abundant "
                f"(PX_interface={idx_PX_interface.size}, PX_non_interface={idx_PX_noninterface.size}; "
                f"PY_interface={idx_PY_interface.size}, PY_non_interface={idx_PY_noninterface.size}). "
                f"Differential expression reveals {sig_PX.shape[0]} interface-up genes in PX and "
                f"{sig_PY.shape[0]} in PY, with a shared module of {shared_up.size} genes "
                f"upregulated in both. Example shared genes: {', '.join(shared_up[:5])}. "
                f"PCA on this shared set yields clear separation of interface vs non-interface cells "
                f"within each label (PX PC1 separation={separation_info.get('PX_PC1_separation', 0):.3f}; "
                f"PY PC1 separation={separation_info.get('PY_PC1_separation', 0):.3f}), indicating a "
                f"coordinated PX–PY interface program."
            )
        else:
            h1["status"] = "REFINE"
            h1["statement"] = (
                "Spatially co-localized PX–PY micro-environments contain PX and PY cells that each exhibit "
                "label-specific interface-associated gene expression changes relative to non-interface PX and PY "
                "cells, without a strong shared multi-gene program common to both labels."
            )
            h1["narrowing_notes"] = (
                f"H1 partially supported: PX and PY interface subsets are present in substantial numbers "
                f"(PX_interface={idx_PX_interface.size}, PX_non_interface={idx_PX_noninterface.size}; "
                f"PY_interface={idx_PY_interface.size}, PY_non_interface={idx_PY_noninterface.size}). "
                f"Differential expression identifies {sig_PX.shape[0]} interface-up genes in PX and "
                f"{sig_PY.shape[0]} in PY, but only {shared_up.size} genes are shared between them, which is "
                f"insufficient for a robust common module (threshold ≥5). This suggests that PX and PY each "
                f"adjust their expression at the PX–PY interface, but these adjustments are largely "
                f"label-specific rather than a single, tightly shared program."
            )
    else:
        h1["status"] = "REFINE"
        h1["statement"] = (
            "PX and PY cells form repeated spatial interfaces, but the current dataset does not provide "
            "sufficient balanced interface and non-interface cells to robustly characterize a distinct "
            "PX–PY interface gene program."
        )
        h1["narrowing_notes"] = (
            "Cell counts for PX and/or PY interface vs non-interface subsets fell below the heuristic "
            f"minimum ({min_cells} cells per group), so formal differential expression was not performed. "
            "The spatial co-localization from OBSERVATION 2–3 is retained, but transcriptomic support for a "
            "distinct interface program remains inconclusive."
        )
else:
    h1["status"] = "DROP"
    h1["narrowing_notes"] = (
        "PX or PY labels were not present in the Populations annotation, so the PX–PY interface "
        "hypothesis could not be evaluated on this dataset."
    )

# =========================
# H2: PW–PAA–PM niche vs diffuse PM
# =========================
print("\n=== Testing H2 (PW–PAA–PM ECM-like niche) ===")
