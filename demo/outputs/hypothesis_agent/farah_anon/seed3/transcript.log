print("Number of unique Sample_ID:", adata.obs["Sample_ID"].nunique())
print("Sample_ID counts (top 10):\n", adata.obs["Sample_ID"].value_counts().head(10))

# Inspect Populations as putative cell-type labels
if "Populations" in adata.obs.columns:
    pop_counts = adata.obs["Populations"].value_counts()
    print("Populations categories:", len(pop_counts))
    print("Populations value counts (top 20):\n", pop_counts.head(20))
else:
    print("No 'Populations' column in obs.")

# Inspect leiden clusters
leiden_counts = adata.obs["leiden"].value_counts()
print("Number of leiden clusters:", len(leiden_counts))
print("Leiden value counts (top 20):\n", leiden_counts.head(20))

# Spatial coordinates summary
if "spatial" in adata.obsm:
    spatial = adata.obsm["spatial"]
    print("Spatial shape:", spatial.shape)
    x = spatial[:, 0]
    y = spatial[:, 1]
    print("X range:", float(x.min()), "to", float(x.max()))
    print("Y range:", float(y.min()), "to", float(y.max()))
else:
    print("No 'spatial' in obsm.")

# UMI and complexity summaries
umi = adata.obs["UMI Count"]
complexity = adata.obs["Complexity"]
print("UMI Count stats: min", float(umi.min()), "median", float(umi.median()), "max", float(umi.max()))
print("Complexity stats: min", float(complexity.min()), "median", float(complexity.median()), "max", float(complexity.max()))

# Write OBSERVATION 1: high-level dataset inventory
obs_lines = []
obs_lines.append("OBSERVATION 1:\n")
obs_lines.append(
    f"The dataset contains {adata.n_obs} cells and {adata.n_vars} genes across "
    f"{adata.obs['Sample_ID'].nunique()} samples, with spatial coordinates for all cells "
    f"({spatial.shape[0]} × {spatial.shape[1]}). The 'Populations' column has "
    f"{len(pop_counts) if 'Populations' in adata.obs.columns else 0} categories "
    f"(top entries: {', '.join([f'{idx}={cnt}' for idx, cnt in (pop_counts.head(5).items() if 'Populations' in adata.obs.columns else [])])}), "
    f"and the 'leiden' clustering defines {len(leiden_counts)} clusters "
    f"(top clusters by size: {', '.join([f'{idx}={cnt}' for idx, cnt in leiden_counts.head(5).items()])}). "
    f"UMI counts range from {float(umi.min())} to {float(umi.max())} "
    f"(median {float(umi.median())}), and library complexity ranges from "
    f"{float(complexity.min())} to {float(complexity.max())} (median {float(complexity.median())}). "
    f"Spatial x-coordinates span {float(x.min())}–{float(x.max())} and y-coordinates "
    f"span {float(y.min())}–{float(y.max())}.\n\n"
)
with open(exploration_log_path, "a") as f:
    f.writelines(obs_lines)

print("Wrote OBSERVATION 1 to exploration_log.md")
