    nbr_labels_local = codes[nbrs]

    # Core PW cells: at least one PAA and one PM neighbor
    nbr_labels_PW = nbr_labels_local[mask_PW]
    has_PAA_neighbor = (nbr_labels_PW == code_PAA).any(axis=1)
    has_PM_neighbor = (nbr_labels_PW == code_PM).any(axis=1)
    core_PW_local = has_PAA_neighbor & has_PM_neighbor
    idx_PW_all = np.where(mask_PW)[0]
    idx_PW_core = idx_PW_all[core_PW_local]

    print("PW cells total:", mask_PW.sum(), "core_PW (PAA+PM neighbors):", idx_PW_core.size)

    # Niche-core: core PW cells + their PAA/PM neighbors
    if idx_PW_core.size > 0:
        nbrs_core = nbrs[idx_PW_core]
        nbr_labels_core = codes[nbrs_core.reshape(-1)]
        nbr_indices_core = nbrs_core.reshape(-1)
        niche_neighbor_mask = np.isin(nbr_labels_core, [code_PW, code_PAA, code_PM])
        idx_niche_neighbors = np.unique(nbr_indices_core[niche_neighbor_mask])
        idx_niche_core = np.unique(np.concatenate([idx_PW_core, idx_niche_neighbors]))
    else:
