import numpy as np
import pandas as pd
from pathlib import Path

# Try to import scipy for p-values; if unavailable, we'll skip p-values
try:
    from scipy.stats import binom_test
    have_scipy = True
except Exception as e:
    print("SciPy not available, will skip p-values. Error:", repr(e))
    have_scipy = False

base = Path(DATA_DIR)
hyp_dir = base / "hypotheses"
exploration_log_path = hyp_dir / "exploration_log.md"

labels = adata.obs["Populations"].astype("category")
label_names = labels.cat.categories.tolist()
codes = labels.cat.codes.to_numpy()
n_labels = len(label_names)

# Use neighbor label matrix from previous step if available; otherwise recompute
from sklearn.neighbors import NearestNeighbors

if "spatial" in adata.obsm:
    coords = adata.obsm["spatial"]
else:
    raise RuntimeError("No spatial coordinates available in adata.obsm['spatial'].")

try:
    nbrs
    nbr_labels
    print("Using precomputed neighbor indices and labels.")
except NameError:
    print("Neighbor arrays not found; recomputing kNN.")
    k = 15
    nn = NearestNeighbors(n_neighbors=k, algorithm="auto", n_jobs=-1)
    nn.fit(coords)
    nbrs = nn.kneighbors(coords, return_distance=False)[:, 1:]
    nbr_labels = codes[nbrs]

k_minus_1 = nbrs.shape[1]
print("k-1 neighbors per cell:", k_minus_1)

global_counts = np.bincount(codes, minlength=n_labels)
global_freq = global_counts / global_counts.sum()

# For each source label A, compute neighbor composition
pair_records = []
for ia, lab_a in enumerate(label_names):
    mask_a = (codes == ia)
    n_cells_a = mask_a.sum()
    if n_cells_a == 0:
        continue
    nbr_labels_a = nbr_labels[mask_a].reshape(-1)
    total_neighbors_a = nbr_labels_a.size
    counts_ab = np.bincount(nbr_labels_a, minlength=n_labels)
    local_freq_ab = counts_ab / total_neighbors_a
    enrich_ab = local_freq_ab / np.maximum(global_freq, 1e-9)
    for ib, lab_b in enumerate(label_names):
        if ia == ib:
            continue
        count_ab = counts_ab[ib]
        if count_ab == 0:
            continue
        record = {
            "source_label": lab_a,
            "neighbor_label": lab_b,
            "source_cells": int(n_cells_a),
            "neighbor_edges": int(count_ab),
            "total_neighbors_from_source": int(total_neighbors_a),
            "local_freq": float(local_freq_ab[ib]),
            "global_freq": float(global_freq[ib]),
            "enrichment": float(enrich_ab[ib]),
        }
        pair_records.append(record)

pair_df = pd.DataFrame(pair_records)
print("Pairwise neighbor records:", pair_df.shape)

# Filter for enrichment > 1 and sort
pair_df = pair_df[pair_df["enrichment"] > 1].copy()
pair_df.sort_values(["enrichment", "neighbor_edges"], ascending=[False, False], inplace=True)
top_pairs = pair_df.head(10).reset_index(drop=True)
print("Top 10 enriched source→neighbor label pairs:\n", top_pairs)

# Compute p-values for the top pairs if SciPy is available
p_values = []
for _, row in top_pairs.iterrows():
    if have_scipy:
        k_obs = int(row["neighbor_edges"])
        n_trials = int(row["total_neighbors_from_source"])
        p0 = float(row["global_freq"])
        try:
            pval = float(binom_test(k_obs, n_trials, p0, alternative="greater"))
        except Exception as e:
            print("binom_test error:", repr(e))
            pval = np.nan
    else:
        pval = np.nan
    p_values.append(pval)
top_pairs["p_value"] = p_values

print("Top pairs with p-values:\n", top_pairs)

# Write OBSERVATION 3
lines = []
lines.append("OBSERVATION 3:\n")
pair_texts = []
for _, row in top_pairs.iterrows():
    pair_texts.append(
        f"{row['source_label']}→{row['neighbor_label']} (source_cells={int(row['source_cells'])}, "
        f"neighbor_edges={int(row['neighbor_edges'])} out of {int(row['total_neighbors_from_source'])} neighbors; "
        f"local_freq={row['local_freq']:.3f} vs global_freq={row['global_freq']:.3f}, "
        f"enrichment={row['enrichment']:.1f}"
        + (f", p_value={row['p_value']:.1e}" if not np.isnan(row['p_value']) else "")
        + ")"
    )

lines.append(
    "Pairwise spatial co-localization across all 27 'Populations' labels was quantified by comparing, for each "
    "source label, the fraction of its spatial neighbors belonging to each other label against that label's "
    "global frequency. Among all source→neighbor pairs with enrichment > 1, the 10 most enriched were: "
    + "; ".join(pair_texts)
    + ". These pairs represent strongly co-localized label combinations, with local neighbor fractions far "
    "exceeding global expectations and, where computed, extremely small binomial p-values.\n\n"
)

with open(exploration_log_path, "a") as f:
    f.writelines(lines)

print("Wrote OBSERVATION 3 to exploration_log.md")
