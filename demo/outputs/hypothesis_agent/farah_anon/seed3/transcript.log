<execute>
import numpy as np
import pandas as pd
from pathlib import Path

from sklearn.neighbors import NearestNeighbors

base = Path(DATA_DIR)
hyp_dir = base / "hypotheses"
exploration_log_path = hyp_dir / "exploration_log.md"

# Use Populations as cell-type labels
labels = adata.obs["Populations"].astype("category")
label_names = labels.cat.categories.tolist()
codes = labels.cat.codes.to_numpy()
n_cells = adata.n_obs
n_labels = len(label_names)
print("Using Populations as labels:", n_labels, "categories.")

# Build kNN graph on spatial coordinates
coords = adata.obsm["spatial"]
print("Coords shape:", coords.shape)

k = 15  # includes self
nn = NearestNeighbors(n_neighbors=k, algorithm="auto", n_jobs=-1)
nn.fit(coords)
nbrs = nn.kneighbors(coords, return_distance=False)  # shape (n_cells, k)
# Exclude self (assumed index 0)
nbrs = nbrs[:, 1:]
print("Neighbor indices shape (excluding self):", nbrs.shape)

# Neighbor label codes
nbr_labels = codes[nbrs]  # shape (n_cells, k-1)

# Same-label fraction per cell
same = (nbr_labels == codes[:, None])
same_frac = same.mean(axis=1)

# Global frequencies
global_counts = np.bincount(codes, minlength=n_labels)
global_freq = global_counts / global_counts.sum()

# Aggregate per label: mean same_frac, concentration index
df_cells = pd.DataFrame({
    "label_code": codes,
    "same_frac": same_frac
})
mean_same = df_cells.groupby("label_code")["same_frac"].mean().reindex(range(n_labels)).to_numpy()

concentration_index = mean_same / np.maximum(global_freq, 1e-9)

summary = pd.DataFrame({
    "label": label_names,
    "count": global_counts,
    "global_freq": global_freq,
    "mean_same_frac": mean_same,
    "concentration_index": concentration_index
}).sort_values("concentration_index", ascending=False)

print("Top 10 labels by concentration index:\n", summary.head(10))

# Select top 5 rare-but-tight labels by concentration index
top_rare_tight = summary.head(5).copy()
print("Selected rare-but-tight labels:\n", top_rare_tight)

# For each selected label, compute top 3 non-self neighboring labels by enrichment
neighbor_partners = {}
for _, row in top_rare_tight.iterrows():
    lab = row["label"]
    lab_code = label_names.index(lab)
    mask = (codes == lab_code)
    idx_cells = np.where(mask)[0]
    if idx_cells.size == 0:
        continue
    nbr_idx_sub = nbrs[mask]  # neighbors for cells of this label
    nbr_labels_sub = codes[nbr_idx_sub.reshape(-1)]
    # Exclude self-label neighbors for partner analysis
    partner_codes = nbr_labels_sub[nbr_labels_sub != lab_code]
    if partner_codes.size == 0:
        neighbor_partners[lab] = []
        continue
    partner_counts = np.bincount(partner_codes, minlength=n_labels)
    partner_freq_local = partner_counts / partner_codes.size
    # Expected under global
    enrichment = partner_freq_local / np.maximum(global_freq, 1e-9)
    # Zero out self just in case
    enrichment[lab_code] = 0.0
    # Rank partners
    top_partner_idx = np.argsort(enrichment)[::-1][:5]
    partners_info = []
    for j in top_partner_idx:
        if partner_counts[j] == 0:
            continue
        partners_info.append({
            "label": label_names[j],
            "count": int(partner_counts[j]),
            "local_freq": float(partner_freq_local[j]),
            "global_freq": float(global_freq[j]),
            "enrichment": float(enrichment[j]),
        })
    # Keep top 3 with nonzero counts
    neighbor_partners[lab] = partners_info[:3]

print("Neighbor partners for rare-but-tight labels:")
for lab, partners in neighbor_partners.items():
    print("Label", lab, "partners:", partners)

# Write OBSERVATION 2 to exploration_log.md
lines = []
lines.append("OBSERVATION 2:\n")
desc_parts = []
for _, row in top_rare_tight.iterrows():
    lab = row["label"]
    desc = (
        f"{lab} (n={int(row['count'])}, global_freq={row['global_freq']:.3f}) has "
        f"mean same-label neighbor fraction {row['mean_same_frac']:.3f} "
        f"and concentration index {row['concentration_index']:.2f}"
    )
    desc_parts.append(desc)
summary_text = "; ".join(desc_parts)

partner_texts = []
for lab, partners in neighbor_partners.items():
    if not partners:
        partner_texts.append(f"{lab} has almost exclusively self-neighbors with negligible non-self neighbors.")
        continue
    p_str = ", ".join(
        [f"{p['label']} (count={p['count']}, local_freq={p['local_freq']:.3f}, "
         f"global_freq={p['global_freq']:.3f}, enrichment={p['enrichment']:.2f})"
         for p in partners]
    )
    partner_texts.append(f"For {lab}, the top non-self neighboring labels are: {p_str}.")
partners_summary = " ".join(partner_texts)

lines.append(
    f"Using the 'Populations' labels (27 categories) and a 14-nearest-neighbor graph in spatial coordinates, "
    f"rare-but-spatially-concentrated populations were identified by the ratio of mean same-label neighbor "
    f"fraction to global frequency. The top 5 labels by this concentration index are: {summary_text}. "
    f"Across these labels, the same-label neighbor fractions greatly exceed their global frequencies, indicating "
    f"tight spatial clustering. Neighbor analysis around each of these rare-but-tight labels reveals specific "
    f"non-self partners: {partners_summary}\n\n"
)
with open(exploration_log_path, "a") as f:
    f.writelines(lines)

print("Wrote OBSERVATION 2 to exploration_log.md")
</execute>

