from pathlib import Path
import json

base = Path(DATA_DIR)
hyp_dir = base / "hypotheses"
hyp_dir.mkdir(exist_ok=True)
exploration_log_path = hyp_dir / "exploration_log.md"

# ---- Read exploration log back (Phase 2 start) ----
if exploration_log_path.exists():
    with open(exploration_log_path, "r") as f:
        expl_text = f.read()
    print("=== exploration_log.md ===")
    print(expl_text)
else:
    print("exploration_log.md not found; this should not happen at Phase 2.")

# ---- Read limited biological background ----
briefs_dir = base / "briefs"
bg_path = briefs_dir / "background.md"
if not bg_path.exists():
    bg_path = briefs_dir / "paper_summary.txt"

if bg_path.exists():
    with open(bg_path, "r") as f:
        bg_text = f.read()
    print(f"\n=== Background from {bg_path.name} (first 1200 chars) ===")
    print(bg_text[:1200])
else:
    bg_text = ""
    print("No background file found.")

# ---- Inspect gene panel to avoid referencing absent genes ----
genes = list(adata.var_names)
print("\nTotal genes in panel:", len(genes))
print("First 40 genes:", genes[:40])

# Optionally check for some broad functional families
families = {
    "collagen_like": [g for g in genes if g.startswith("COL")],
    "chemokine_like": [g for g in genes if g.startswith("CCL") or g.startswith("CXCL")],
    "integrin_like": [g for g in genes if g.startswith("ITG")],
    "matrix_metalloproteinase_like": [g for g in genes if g.startswith("MMP") or g.startswith("ADAM")],
    "endothelial_markers_like": [g for g in genes if g in ["PECAM1","VWF","KDR","FLT1","ENG"]],
    "fibroblast_like": [g for g in genes if g in ["COL1A1","COL1A2","COL3A1","FN1","DCN","LUM"]],
    "immune_markers_like": [g for g in genes if g in ["PTPRC","CD3D","CD3E","MS4A1","LYZ"]],
    "cardiomyocyte_like": [g for g in genes if g in ["TNNT2","TNNI3","MYH6","MYH7","ACTC1"]]
}
print("\nGene family presence (only non-empty shown):")
for fam, glist in families.items():
    if glist:
        print(f"  {fam}: {glist}")

# ---- Draft 2–3 hypotheses anchored in observations ----

hypotheses = []

# H1: PX–PY co-localized microenvironment with distinct program vs isolated PX/PY
h1_statement = (
    "Spatially co-localized PX–PY micro-environments form a specialized interface niche where PX and PY cells "
    "share a coordinated multi-gene expression program that is distinct from PX and PY cells located in regions "
    "without direct PX–PY contact."
)
hypotheses.append({
