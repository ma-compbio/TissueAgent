        # Simple proxy for signaling/stress-associated genes in this panel
        signaling_prefixes = ("CXCL", "BMP", "FGF", "FGFR", "PDG", "VEGF", "NOTCH", "DLL", "WNT", "HIF", "JUN", "FOS")
        signaling_genes = [g for g in genes if g.startswith(signaling_prefixes) or g in ["AGT", "ANGPT1", "ADM"]]
        signaling_up = sig_H3[sig_H3["gene"].isin(signaling_genes)]
        print("Signaling/stress-like genes up in embedded PV:", signaling_up.shape[0])
        if signaling_up.shape[0] > 0:
