    print("Niche-core PW/PAA/PM cells:", idx_niche_core.size)

    # Distant PM: PM cells with no PW and no PAA neighbor
    nbr_labels_PM = nbr_labels_local[mask_PM]
    has_PW_neighbor_PM = (nbr_labels_PM == code_PW).any(axis=1)
    has_PAA_neighbor_PM = (nbr_labels_PM == code_PAA).any(axis=1)
    distant_PM_local = (~has_PW_neighbor_PM) & (~has_PAA_neighbor_PM)
    idx_PM_all = np.where(mask_PM)[0]
    idx_PM_distant = idx_PM_all[distant_PM_local]
    print("PM cells total:", mask_PM.sum(), "distant_PM:", idx_PM_distant.size)

    min_cells = 30
    if idx_niche_core.size >= min_cells and idx_PM_distant.size >= min_cells:
        de_H2 = de_mannwhitney(idx_niche_core, idx_PM_distant, X, genes)
        sig_H2 = de_H2[(de_H2["qval"] < 0.05) & (de_H2["log2FC"] > 0)]
        print("Niche-core vs distant_PM: significant up genes:", sig_H2.shape[0])

        # ECM-like gene set from panel
        ecm_genes = [g for g in genes
                     if g.startswith("COL") or g.startswith("MMP") or g.startswith("ADAMTS")
                     or g in ["FN1", "LUM", "DCN", "THBS1", "THBS2", "THBS3", "THBS4", "FBN1", "FBN2", "ELN"]]
        ecm_up = sig_H2[sig_H2["gene"].isin(ecm_genes)]
        print("ECM-like genes up in niche-core:", ecm_up.shape[0])
        if ecm_up.shape[0] > 0:
