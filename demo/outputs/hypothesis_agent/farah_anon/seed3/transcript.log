kept = [h for h in hypotheses if h.get("status") in ["KEEP", "REFINE"]]
dropped = [h for h in hypotheses if h.get("status") == "DROP"]

# Ensure at least one retained, even if all were weakly supported
if len(kept) == 0 and len(hypotheses) > 0:
