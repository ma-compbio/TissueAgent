    ),
    "quality_scores": {
        "derivable": 7,
        "novel": 6,
        "feasible": 8,
        "specific": 8,
        "falsifiable": 9
    }
})

# ---- Save draft hypotheses ----
draft_path = hyp_dir / "hypotheses_draft.json"
with open(draft_path, "w") as f:
    json.dump(hypotheses, f, indent=2)

print(f"\nWrote {len(hypotheses)} hypotheses to {draft_path}")
