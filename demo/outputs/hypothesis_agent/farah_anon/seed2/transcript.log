gene_name_to_index = {g: i for i, g in enumerate(var_names)}

def get_expr_subset(cell_idx, gene_idx):
    """Return dense expression array (cells x genes) for given indices."""
    sub = X[cell_idx, :][:, gene_idx]
    if issparse(sub):
        return sub.toarray()
    else:
        return np.asarray(sub)

def bh_fdr(pvals):
    """Benjamini-Hochberg FDR correction; returns q-values array."""
    pvals = np.asarray(pvals)
    n = pvals.size
    order = np.argsort(pvals)
    ranks = np.arange(1, n+1)
    qvals = np.empty_like(pvals, dtype=float)
    qvals[order] = pvals[order] * n / ranks
    qvals = np.minimum.accumulate(qvals[order][::-1])[::-1]
    qvals = np.minimum(qvals, 1.0)
    q_out = np.empty_like(qvals)
    q_out[order] = qvals
    return q_out

