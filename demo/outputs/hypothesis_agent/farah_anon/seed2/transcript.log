    cells_interface = focal_cells[interface_mask]
    cells_non_interface = focal_cells[~interface_mask]

    # DE across all genes (interface vs non-interface)
    expr_if = get_expr_subset(cells_interface, np.arange(n_genes))
    expr_non = get_expr_subset(cells_non_interface, np.arange(n_genes))

    pvals = np.ones(n_genes)
    logfc = np.zeros(n_genes)

    for gi in range(n_genes):
        x = expr_if[:, gi]
        y = expr_non[:, gi]
        if np.all(x == x[0]) and np.all(y == y[0]):
            pvals[gi] = 1.0
            logfc[gi] = 0.0
            continue
        try:
            stat, p = mannwhitneyu(x, y, alternative="two-sided")
        except ValueError:
            p = 1.0
        pvals[gi] = p
        mean_if = x.mean() + 1e-9
        mean_non = y.mean() + 1e-9
        logfc[gi] = np.log2(mean_if / mean_non)

    qvals = bh_fdr(pvals)
    sig_up_mask = (qvals < 0.05) & (logfc > 0)
    sig_up_genes = var_names[sig_up_mask]

    # Check enrichment of signaling/TF genes among upregulated
    sig_tf_up = [g for g in sig_up_genes if g in signaling_tf_genes]
    h1_notes.append(
        f"Cluster {focal_label_str}: {sig_up_mask.sum()} genes upregulated in interface cells at FDR<0.05, "
        f"of which {len(sig_tf_up)} are signaling/TF genes "
