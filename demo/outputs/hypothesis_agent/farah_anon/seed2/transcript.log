<execute>
import numpy as np, re, json, pandas as pd
from pathlib import Path

from scipy.spatial import cKDTree

data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
exploration_log_path = hyp_dir / "exploration_log.md"

# Reuse adata, coords, cell_label_key from previous block
print("Existing adata shape:", adata.shape)
print("Cell label key:", cell_label_key)

labels = adata.obs[cell_label_key].astype(str).values
coords = np.asarray(adata.obsm["spatial"])
n_cells = adata.n_obs

# Build kNN graph in spatial space
k = 15
tree = cKDTree(coords)
dists, idx = tree.query(coords, k=k+1)  # includes self as first neighbor
neighbor_idx = idx[:, 1:]  # drop self, shape (n_cells, k)

# Map labels to integer codes
label_names, codes = np.unique(labels, return_inverse=True)
n_labels = label_names.shape[0]
print("Number of distinct labels:", n_labels)

# Global label stats
n_cells_per_label = np.bincount(codes, minlength[n_labels] if isinstance(n_labels, int) else n_labels)

# Fix small bug in previous line (cannot modify above now, recompute properly)
n_labels = int(n_labels)
n_cells_per_label = np.bincount(codes, minlength=n_labels)
global_frac = n_cells_per_label / n_cells

# === Rare-but-tight metric: same-label NN fraction vs global abundance ===
neighbor_labels_codes = codes[neighbor_idx]  # (n_cells, k)
same_mask = (neighbor_labels_codes == codes[:, None])
same_counts_per_cell = same_mask.sum(axis=1)  # number of same-label neighbors for each cell

same_counts_per_label = np.bincount(codes, weights=same_counts_per_cell, minlength=n_labels)
same_fraction_per_label = same_counts_per_label / (k * np.maximum(n_cells_per_label, 1))

ratio_same_vs_global = same_fraction_per_label / np.maximum(global_frac, 1e-9)

# Rank labels by ratio (descending)
order = np.argsort(-ratio_same_vs_global)
top_m = 5 if n_labels >= 5 else n_labels
top_idx = order[:top_m]

print("Top labels by same-label NN enrichment over global abundance:")
for i in top_idx:
    print(
        f"Label {label_names[i]}: n={n_cells_per_label[i]}, "
        f"global_frac={global_frac[i]:.4f}, same_NN_frac={same_fraction_per_label[i]:.4f}, "
        f"ratio={ratio_same_vs_global[i]:.2f}"
    )

# Determine next observation index
next_idx = 1
if exploration_log_path.exists():
    txt = exploration_log_path.read_text()
    matches = re.findall(r"OBSERVATION (\d+):", txt)
    if matches:
        next_idx = max(int(m) for m in matches) + 1

# OBSERVATION for rare-but-tight ranking
lines = []
lines.append(f"OBSERVATION {next_idx}:")
lines.append(
    f"Using a k={k} spatial nearest-neighbor graph on {n_cells} cells, "
    f"I computed for each of the {n_labels} leiden labels the fraction of same-label neighbors "
    f"and compared it to the global label fraction."
)
summary_parts = []
for i in top_idx:
    summary_parts.append(
        f"label {label_names[i]}: {n_cells_per_label[i]} cells "
        f"({global_frac[i]:.4%} of all cells), same-label NN fraction {same_fraction_per_label[i]:.3f}, "
        f"enrichment ratio {ratio_same_vs_global[i]:.2f}"
    )
lines.append(
    "The 5 most spatially self-enriched (\"tight\") labels by same-label neighbor enrichment over global abundance are: "
    + "; ".join(summary_parts)
    + "."
)
lines.append("This identifies rare or moderately abundant labels that form spatially compact domains in the tissue.")
lines.append("")

with open(exploration_log_path, "a") as f:
    f.write("\n".join(lines) + "\n")

print(f"Wrote OBSERVATION {next_idx}")
print("\n".join(lines))

# === Neighbor enrichment for rare-but-tight populations (mandatory follow-up) ===
# For each of the top labels, compute enrichment of non-self neighbor labels
next_idx += 1
lines2 = []
lines2.append(f"OBSERVATION {next_idx}:")
lines2.append(
    "For each of the rare-but-tight labels identified above, I examined the composition of their spatial neighbors "
    "using the same k-nearest-neighbor graph, and compared observed neighbor label fractions to global expectations."
)

total_neighbors_from_label = np.bincount(codes, minlength=n_labels) * k  # edges originating from each label

for i in top_idx:
    mask_cells = (codes == i)
    neigh_codes_i = neighbor_labels_codes[mask_cells].ravel()
    if neigh_codes_i.size == 0:
        continue
    neigh_counts = np.bincount(neigh_codes_i, minlength=n_labels)
    observed_frac = neigh_counts / neigh_codes_i.size
    expected_frac = global_frac
    enrichment = observed_frac / np.maximum(expected_frac, 1e-9)

    # Exclude self label
    enrichment_nonself = enrichment.copy()
    enrichment_nonself[i] = -np.inf

    top3_idx = np.argsort(-enrichment_nonself)[:3]
    parts = []
    for j in top3_idx:
        parts.append(
            f"{label_names[j]} (neighbors={neigh_counts[j]}, "
            f"observed_frac={observed_frac[j]:.3f}, expected_frac={expected_frac[j]:.3f}, "
            f"enrichment={enrichment[j]:.2f})"
        )
    lines2.append(
        f"For tight label {label_names[i]} ({n_cells_per_label[i]} cells), the three most enriched non-self neighbor "
        f"labels by enrichment over global abundance are: " + "; ".join(parts) + "."
    )

lines2.append("")

with open(exploration_log_path, "a") as f:
    f.write("\n".join(lines2) + "\n")

print(f"Wrote OBSERVATION {next_idx}")
print("\n".join(lines2))

# === Global pairwise co-localization across all label pairs (additional EDA pass) ===
next_idx += 1

L = n_labels
center_codes = np.repeat(codes, k)
neighbor_codes_flat = neighbor_labels_codes.ravel()
pair_index = center_codes * L + neighbor_codes_flat
pair_counts = np.bincount(pair_index, minlength=L * L).reshape(L, L)

edges_from_label = n_cells_per_label * k  # outgoing edges from each label
expected_counts = edges_from_label[:, None] * global_frac[None, :]

enrichment_matrix = pair_counts / np.maximum(expected_counts, 1e-9)

# Focus on distinct label pairs (A != B), symmetrize by averaging A->B and B->A
enrichment_sym = (enrichment_matrix + enrichment_matrix.T) / 2.0
pair_obs_sym = (pair_counts + pair_counts.T) / 2.0

mask_offdiag = ~np.eye(L, dtype=bool)
flat_enrich = enrichment_sym[mask_offdiag]
flat_counts = pair_obs_sym[mask_offdiag]

# Filter to pairs with enough observed neighbors to avoid noise
min_edges = 200
valid = flat_counts >= min_edges
flat_enrich_valid = flat_enrich[valid]

# Indices back to (i,j)
idx_all = np.argwhere(mask_offdiag)
idx_valid = idx_all[valid]

top_pairs_n = 10 if flat_enrich_valid.size >= 10 else flat_enrich_valid.size
top_pair_order = np.argsort(-flat_enrich_valid)[:top_pairs_n]

lines3 = []
lines3.append(f"OBSERVATION {next_idx}:")
lines3.append(
    "Using all directed edges in the spatial k-nearest-neighbor graph, I quantified pairwise co-localization between "
    "all leiden labels by comparing observed neighbor counts to expectations from global label frequencies. "
    f"I summarize the top {top_pairs_n} most strongly co-localized non-identical label pairs with at least "
    f"{min_edges} observed neighbor edges."
)

pair_summaries = []
for rank in top_pair_order:
    i, j = idx_valid[rank]
    if i == j:
        continue
    obs_edges = pair_obs_sym[i, j]
    exp_edges = expected_counts[i, j] + expected_counts[j, i]
    enr = flat_enrich_valid[rank]
    pair_summaries.append(
        f"{label_names[i]}–{label_names[j]}: observed neighbor edges≈{int(obs_edges)}, "
        f"expected≈{exp_edges:.1f}, enrichment≈{enr:.2f}"
    )

for s in pair_summaries:
    lines3.append("- " + s)

lines3.append("")

with open(exploration_log_path, "a") as f:
    f.write("\n".join(lines3) + "\n")

print(f"Wrote OBSERVATION {next_idx}")
print("\n".join(lines3))
</execute>

