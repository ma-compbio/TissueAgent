from pathlib import Path
import json, os, sys, re
import numpy as np
import pandas as pd
from anndata import AnnData
import anndata as ad

data_dir = Path(DATA_DIR)

# 1. Read limited background
bg_path_md = data_dir / "briefs" / "background.md"
bg_path_txt = data_dir / "briefs" / "paper_summary.txt"
background_text = ""
if bg_path_md.exists():
    background_text = bg_path_md.read_text()[:2000]
    src = "background.md"
elif bg_path_txt.exists():
    background_text = bg_path_txt.read_text()[:2000]
    src = "paper_summary.txt"
else:
    src = "NONE"
print("BACKGROUND_SOURCE:", src)
print("BACKGROUND_SNIPPET:\n", background_text[:500].replace("\n", " ")[:500], "\n")

# 2. Load AnnData
adata_path = data_dir / "dataset" / "dataset_farah_anon.h5ad"
print("LOADING:", adata_path)
adata = ad.read_h5ad(adata_path)
print("ADATA SHAPE:", adata.shape)

# 3. Inspect obs/var, find cell-type label and spatial coords
print("OBS COLUMNS:", list(adata.obs.columns)[:30])
print("VAR COUNT:", adata.n_vars)
print("OBSM KEYS:", list(adata.obsm.keys()))

# Heuristic for cell-type / cluster label
candidate_keys = [
    "cell_type", "celltype", "celltypes", "cell_type_major", "cell_type_minor",
    "cell_subtype", "subtype", "annotation", "annot", "cluster", "clusters",
    "leiden", "louvain", "seurat_clusters"
]
cell_label_key = None
for key in candidate_keys:
    if key in adata.obs.columns:
        cell_label_key = key
        break

if cell_label_key is None:
    # fallback: choose first categorical with 5–100 categories
    for col in adata.obs.columns:
        series = adata.obs[col]
        if pd.api.types.is_categorical_dtype(series) or series.dtype == "object":
            n_uniq = series.nunique()
            if 5 <= n_uniq <= 100:
                cell_label_key = col
                break

print("CELL_LABEL_KEY:", cell_label_key)
if cell_label_key is not None:
    label_counts = adata.obs[cell_label_key].value_counts().sort_values(ascending=False)
    print("LABEL COUNTS (top 15):")
    print(label_counts.head(15))

# Heuristic for spatial coordinates
coords = None
coords_source = None
if "spatial" in adata.obsm.keys():
    coords = np.asarray(adata.obsm["spatial"])
    coords_source = "obsm['spatial']"
else:
    # look for obs columns like x, y, px, py
    x_cols = [c for c in adata.obs.columns if re.search(r"(x|X).*coord|^x$|_x$", c)]
    y_cols = [c for c in adata.obs.columns if re.search(r"(y|Y).*coord|^y$|_y$", c)]
    if len(x_cols) > 0 and len(y_cols) > 0:
        # take first pair
        coords = np.vstack([adata.obs[x_cols[0]].values, adata.obs[y_cols[0]].values]).T
        coords_source = f"obs['{x_cols[0]}'], obs['{y_cols[0]}']"

print("COORDS_SOURCE:", coords_source, "SHAPE:" if coords is not None else None, None if coords is None else coords.shape)

# 4. Prepare hypotheses dir and exploration log
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
exploration_log_path = hyp_dir / "exploration_log.md"

# Helper: determine next OBSERVATION index
next_idx = 1
if exploration_log_path.exists():
    txt = exploration_log_path.read_text()
    matches = re.findall(r"OBSERVATION (\d+):", txt)
    if matches:
        next_idx = max(int(m) for m in matches) + 1

# 5. EDA Pass 1: basic inventory (cell-type distribution and spatial extent)
n_cells, n_genes = adata.shape
if coords is not None:
    x_min, y_min = coords.min(axis=0)
    x_max, y_max = coords.max(axis=0)
    extent_str = f"spatial extent x[{x_min:.1f}, {x_max:.1f}], y[{y_min:.1f}, {y_max:.1f}]"
else:
    extent_str = "no explicit spatial coordinates detected"

if cell_label_key is not None:
    counts = adata.obs[cell_label_key].value_counts()
    top5 = counts.head(5)
    frac_top5 = (top5 / n_cells).round(4)
    celltype_summary_lines = []
    for name, cnt in top5.items():
        celltype_summary_lines.append(f"- {name}: {cnt} cells ({cnt / n_cells:.3%})")
    celltype_summary = "\n".join(celltype_summary_lines)
    n_labels = counts.shape[0]
else:
    celltype_summary = "No clear cell-type / cluster label column identified."
    n_labels = 0

obs_text = []
obs_text.append(f"OBSERVATION {next_idx}:")
obs_text.append(f"This dataset contains {n_cells} cells and {n_genes} genes with {n_labels} distinct labels in obs['{cell_label_key}'] if available.")
obs_text.append(f"The recorded spatial range is: {extent_str}.")
if cell_label_key is not None:
    obs_text.append("The 5 most abundant labels and their cell counts/fractions are:")
    obs_text.append(celltype_summary)
else:
    obs_text.append("A primary categorical label for cell types or clusters could not be confidently identified from the metadata.")
obs_text.append("")  # blank line

with open(exploration_log_path, "a") as f:
    f.write("\n".join(obs_text) + "\n")

print(f"Wrote OBSERVATION {next_idx} to {exploration_log_path}")
print("\n".join(obs_text))
</execute>

