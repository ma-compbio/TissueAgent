    frac_partner = is_partner.mean(axis=1)

    interface_mask = frac_partner >= interface_threshold
    n_interface = interface_mask.sum()
    n_non_interface = focal_cells.size - n_interface

    h1_notes.append(
        f"Cluster {focal_label_str}: total cells={focal_cells.size}, "
        f"interface (>= {interface_threshold:.2f} partner neighbors)={n_interface}, "
        f"non-interface={n_non_interface}."
