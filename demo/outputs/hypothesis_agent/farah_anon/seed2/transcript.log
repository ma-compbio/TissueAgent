    top3_idx = np.argsort(-enrichment_nonself)[:3]
    parts = []
    for j in top3_idx:
        parts.append(
            f"{label_names[j]} (neighbors={int(neigh_counts[j])}, "
            f"observed_frac={observed_frac[j]:.3f}, expected_frac={expected_frac[j]:.3f}, "
            f"enrichment={enrichment[j]:.2f})"
        )
    lines2.append(
        f"For tight label {label_names[i]} ({int(n_cells_per_label[i])} cells), the three most enriched non-self "
        f"neighbor labels by enrichment over global abundance are: " + "; ".join(parts) + "."
    )

lines2.append("")

with open(exploration_log_path, "a") as f:
    f.write("\n".join(lines2) + "\n")

print(f"Wrote OBSERVATION {next_idx}")
print("\n".join(lines2))

# === Global pairwise co-localization across all label pairs (additional EDA pass) ===
next_idx += 1

L = n_labels
center_codes = np.repeat(codes, k)
neighbor_codes_flat = neighbor_labels_codes.ravel()
pair_index = center_codes * L + neighbor_codes_flat
pair_counts = np.bincount(pair_index, minlength=L * L).reshape(L, L)

edges_from_label = n_cells_per_label * k
expected_counts = edges_from_label[:, None] * global_frac[None, :]

pair_counts_sym = pair_counts + pair_counts.T
expected_sym = expected_counts + expected_counts.T
enrichment_sym = pair_counts_sym / np.maximum(expected_sym, 1e-9)

mask_offdiag = ~np.eye(L, dtype=bool)
flat_enrich = enrichment_sym[mask_offdiag]
flat_counts = pair_counts_sym[mask_offdiag]

min_edges = 500
valid = flat_counts >= min_edges
flat_enrich_valid = flat_enrich[valid]

idx_all = np.argwhere(mask_offdiag)
idx_valid = idx_all[valid]

top_pairs_n = int(min(10, flat_enrich_valid.size))

lines3 = []
lines3.append(f"OBSERVATION {next_idx}:")
lines3.append(
    "Using all edges in the spatial k-nearest-neighbor graph, I quantified pairwise co-localization between all "
    "leiden labels by comparing observed neighbor counts to expectations from global label frequencies, symmetrized "
    f"across label pairs. I report the top {top_pairs_n} most strongly co-localized non-identical label pairs with at "
    f"least {min_edges} observed neighbor edges."
)

if top_pairs_n > 0:
    pair_summaries = []
    order_pairs = np.argsort(-flat_enrich_valid)[:top_pairs_n]
    for rank in order_pairs:
        i, j = idx_valid[rank]
        if i == j:
            continue
        obs_edges = pair_counts_sym[i, j]
        exp_edges = expected_sym[i, j]
        enr = flat_enrich_valid[rank]
        pair_summaries.append(
            f"{label_names[i]}–{label_names[j]}: observed neighbor edges≈{int(obs_edges)}, "
            f"expected≈{exp_edges:.1f}, enrichment≈{enr:.2f}"
        )
    for s in pair_summaries:
        lines3.append("- " + s)
else:
    lines3.append(
        "No label pairs passed the minimum neighbor edge threshold for robust enrichment estimation under these settings."
    )

lines3.append("")

with open(exploration_log_path, "a") as f:
    f.write("\n".join(lines3) + "\n")

print(f"Wrote OBSERVATION {next_idx}")
print("\n".join(lines3))
