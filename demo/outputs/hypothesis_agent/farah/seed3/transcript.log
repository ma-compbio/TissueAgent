<execute>
import numpy as np
import pandas as pd
from pathlib import Path

from sklearn.neighbors import NearestNeighbors

# Reuse adata loaded previously
print(adata)
print("obs columns:", list(adata.obs.columns))

# Decide on main cell-type and cluster columns
if 'Populations' in adata.obs.columns:
    celltype_col_main = 'Populations'
else:
    celltype_col_main = None

if 'leiden' in adata.obs.columns:
    cluster_col = 'leiden'
else:
    cluster_col = None

print("Using celltype_col_main:", celltype_col_main)
print("Using cluster_col (for fine clusters):", cluster_col)

# Inspect basic stats for these columns
summary_info = {}
if celltype_col_main is not None:
    ct_series = adata.obs[celltype_col_main].astype(str)
    ct_counts = ct_series.value_counts()
    summary_info['celltype_counts'] = ct_counts.to_dict()
    print("Cell types (Populations) and counts (top 10):")
    print(ct_counts.head(10))
    print("Total distinct Populations:", ct_counts.shape[0])

if cluster_col is not None:
    cl_series = adata.obs[cluster_col].astype(str)
    cl_counts = cl_series.value_counts()
    summary_info['cluster_counts'] = cl_counts.to_dict()
    print("Clusters (leiden) and counts (top 10):")
    print(cl_counts.head(10))
    print("Total distinct leiden clusters:", cl_counts.shape[0])

# Prepare spatial coordinates
if "spatial" not in adata.obsm:
    raise ValueError("No 'spatial' coordinates found in adata.obsm.")
coords = np.asarray(adata.obsm["spatial"])
print("Spatial coords shape:", coords.shape, "min/max:", coords.min(), coords.max())

# Build spatial neighbor graph
K = 10  # number of neighbors (excluding self)
nn = NearestNeighbors(n_neighbors=K + 1, algorithm="kd_tree")
nn.fit(coords)
distances, indices = nn.kneighbors(coords)
neighbor_indices = indices[:, 1:K + 1]  # drop self at index 0
n_cells = adata.n_obs
total_edges = n_cells * K
print("Built spatial neighbor graph with", total_edges, "directed edges (K =", K, ").")

# === EDA PASS 2: Rare-but-tight analysis on fine clusters (leiden) ===
exploration_log_path = Path(DATA_DIR) / "hypotheses" / "exploration_log.md"

if cluster_col is not None:
    labels = adata.obs[cluster_col].astype(str).values
    label_series = pd.Series(labels, name="cluster")
    global_counts = label_series.value_counts()
    global_freq = global_counts / n_cells
    print("Total distinct clusters for rare-but-tight scan:", global_counts.shape[0])

    # Build edge-level DataFrame
    src_labels = np.repeat(labels, K)
    dst_labels = labels[neighbor_indices].ravel()
    same = (src_labels == dst_labels)

    edges_df = pd.DataFrame({
        "src": src_labels,
        "dst": dst_labels,
        "same": same.astype(int)
    })

    g = edges_df.groupby("src")
    edges_per_src = g["same"].count()
    same_edges_per_src = g["same"].sum()
    same_frac = same_edges_per_src / edges_per_src

    # Align with global frequencies
    same_frac = same_frac.reindex(global_freq.index)
    ratio = same_frac / global_freq

    # Put summary into a DataFrame
    rare_df = pd.DataFrame({
        "n_cells": global_counts,
        "global_freq": global_freq,
        "same_neighbor_frac": same_frac,
        "clustering_ratio": ratio
    }).dropna()

    # Require at least some minimum cell count for stability
    min_cells = 100
    filtered_rare_df = rare_df[rare_df["n_cells"] >= min_cells].copy()
    filtered_rare_df = filtered_rare_df.sort_values("clustering_ratio", ascending=False)

    top_n = 5 if filtered_rare_df.shape[0] >= 5 else filtered_rare_df.shape[0]
    top_rare = filtered_rare_df.head(top_n)
    print("Top rare-but-tight clusters by clustering_ratio (min_cells =", min_cells, "):")
    print(top_rare)

    # For each of these clusters, compute top 3 non-self neighboring labels by enrichment
    neighbor_enrichment = {}
    for cluster_label in top_rare.index:
        sub_edges = edges_df[edges_df["src"] == cluster_label]
        dst_counts = sub_edges["dst"].value_counts()
        dst_freq = dst_counts / dst_counts.sum()
        # Expected from global frequencies
        exp_freq = global_freq.reindex(dst_freq.index)
        enrichment = dst_freq / exp_freq
        enrichment = enrichment.dropna()
        # Drop self label
        if cluster_label in enrichment.index:
            enrichment = enrichment.drop(cluster_label, errors="ignore")
        if enrichment.empty:
            continue
        # Top 3 by enrichment
        top_neighbors = enrichment.sort_values(ascending=False).head(3)
        neighbor_enrichment[cluster_label] = {
            "neighbors": top_neighbors.index.tolist(),
            "enrichment": top_neighbors.values.tolist(),
            "dst_freq": dst_freq.reindex(top_neighbors.index).values.tolist(),
        }

    # Write OBSERVATION 2
    with open(exploration_log_path, "a") as log_f:
        log_f.write("OBSERVATION 2:\n")
        if top_rare.shape[0] > 0:
            desc_parts = []
            for cl_label, row in top_rare.iterrows():
                n_c = int(row["n_cells"])
                gf = row["global_freq"]
                sf = row["same_neighbor_frac"]
                cr = row["clustering_ratio"]
                part = (
                    f"Cluster '{cl_label}' (n={n_c}, global frequency {gf:.3f}) has a same-label nearest-neighbor fraction of "
                    f"{sf:.3f}, corresponding to a clustering ratio of {cr:.2f} relative to global abundance"
                )
                # Add neighbor enrichment if available
                if cl_label in neighbor_enrichment:
                    ne = neighbor_enrichment[cl_label]
                    neighbor_strs = []
                    for nb_name, enr, dfreq in zip(ne["neighbors"], ne["enrichment"], ne["dst_freq"]):
                        neighbor_strs.append(
                            f"'{nb_name}' (neighbor fraction {dfreq:.3f}, enrichment {enr:.2f}x over expectation)"
                        )
                    neighbors_txt = "; ".join(neighbor_strs)
                    part += f"; its top three non-self neighboring clusters by enrichment are {neighbors_txt}"
                desc_parts.append(part + ". ")
            full_txt = (
                f"A rare-but-tight scan over {global_counts.shape[0]} leiden clusters (using K={K} spatial neighbors) "
                f"identified {top_rare.shape[0]} clusters with at least {min_cells} cells that show strong spatial self-association. "
                + " ".join(desc_parts)
            )
            log_f.write(full_txt)
        else:
            log_f.write(
                f"A rare-but-tight scan over {global_counts.shape[0]} leiden clusters (using K={K} spatial neighbors) "
                f"found no clusters with at least {min_cells} cells that exhibited strong spatial self-association after filtering. "
            )
        log_f.write("\n\n")
    print("OBSERVATION 2 (rare-but-tight clusters and neighbor enrichment) written to exploration_log.md")
else:
    print("No cluster_col available; skipping rare-but-tight analysis.")

# === EDA PASS 3: Pairwise co-localization across coarse Populations ===
if celltype_col_main is not None:
    pop_labels = adata.obs[celltype_col_main].astype(str).values
    pop_series = pd.Series(pop_labels, name="population")
    pop_global_counts = pop_series.value_counts()
    pop_global_freq = pop_global_counts / n_cells
    print("Total distinct Populations for co-localization scan:", pop_global_counts.shape[0])

    # Construct edges at population level
    src_pop = np.repeat(pop_labels, K)
    dst_pop = pop_labels[neighbor_indices].ravel()

    edges_pop_df = pd.DataFrame({
        "src": src_pop,
        "dst": dst_pop
    })

    pair_counts = edges_pop_df.groupby(["src", "dst"]).size().reset_index(name="count")

    # Aggregate to unordered pairs
    def make_unordered_pair(a, b):
        return tuple(sorted((a, b)))

    pair_counts["pair"] = pair_counts.apply(lambda r: make_unordered_pair(r["src"], r["dst"]), axis=1)
    unordered = pair_counts.groupby("pair")["count"].sum().reset_index()

    # Compute enrichment for non-self pairs
    enriched_rows = []
    for pair, count in zip(unordered["pair"], unordered["count"]):
        a, b = pair
        if a == b:
            continue
        fa = pop_global_freq.get(a, np.nan)
        fb = pop_global_freq.get(b, np.nan)
        if pd.isna(fa) or pd.isna(fb):
            continue
        expected = 2 * fa * fb * total_edges  # two directions
        if expected == 0:
            continue
        enrichment = count / expected
        enriched_rows.append({
            "pair": pair,
            "pop_a": a,
            "pop_b": b,
            "observed_edges": int(count),
            "expected_edges": float(expected),
            "enrichment": float(enrichment)
        })

    enriched_df = pd.DataFrame(enriched_rows)
    if not enriched_df.empty:
        enriched_df = enriched_df.sort_values("enrichment", ascending=False)
        top_pairs = enriched_df.head(10)
        print("Top 10 enriched population pairs by neighbor co-localization:")
        print(top_pairs)

        # Write OBSERVATION 3
        with open(exploration_log_path, "a") as log_f:
            log_f.write("OBSERVATION 3:\n")
            parts = []
            for _, row in top_pairs.iterrows():
                a = row["pop_a"]
                b = row["pop_b"]
                obs = row["observed_edges"]
                exp = row["expected_edges"]
                enr = row["enrichment"]
                fa = pop_global_freq[a]
                fb = pop_global_freq[b]
                parts.append(
                    f"Population pair ('{a}', '{b}') with global frequencies {fa:.3f} and {fb:.3f} shows "
                    f"{obs} observed neighbor edges versus {exp:.1f} expected under random mixing (enrichment {enr:.2f}x)."
                )
            full_txt = (
                f"Pairwise co-localization analysis across {pop_global_counts.shape[0]} Populations using the same K={K} "
                f"spatial neighbor graph identified several strongly enriched population pairs. "
                + " ".join(parts)
            )
            log_f.write(full_txt)
            log_f.write("\n\n")
        print("OBSERVATION 3 (pairwise population co-localization) written to exploration_log.md")
    else:
        print("No enriched population pairs could be computed (enriched_df empty).")
else:
    print("No Populations column available; skipping population-level co-localization analysis.")

# After EDA passes, inspect and print the exploration log so far
with open(exploration_log_path, "r") as f:
    log_text = f.read()
print("Current exploration_log.md contents:\n")
print(log_text)
