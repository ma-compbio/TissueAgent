            global_prox_mask[nc_indices[prox_mask_local]] = True
            global_dist_mask[nc_indices[dist_mask_local]] = True

            scores_prox = cond_scores[global_prox_mask]
            scores_dist = cond_scores[global_dist_mask]
            med_prox = float(np.median(scores_prox))
            med_dist = float(np.median(scores_dist))
            diff = med_prox - med_dist
            if ranksums is not None:
                stat, pval = ranksums(scores_prox, scores_dist)
            else:
                stat, pval = np.nan, np.nan

            h3_notes.append(
                f"Conduction/ion-handling program (genes {genes_used}) had median score {med_prox:.4f} in neuron-proximal "
                f"ncCM-IFT-like cells vs {med_dist:.4f} in neuron-distant cells (diff {diff:.4f}, p={pval:.2e} if computed)."
            )

            if pval is not None and pval < 0.05 and diff > 0:
                h3_status = "KEEP"
                h3_notes.append("Neuron-proximal ncCM-IFT-like cells show significantly higher conduction program scores; hypothesis retained.")
            elif pval is not None and pval < 0.05 and diff < 0:
                h3_status = "DROP"
                h3_notes.append("Neuron-proximal ncCM-IFT-like cells show significantly lower conduction program scores; hypothesis contradicted and dropped.")
            else:
                h3_status = "REFINE"
                h3_notes.append("Differences in conduction program scores between neuron-proximal and neuron-distant ncCM-IFT-like cells are weak or not statistically significant; hypothesis refined to emphasize possible but modest shifts.")

# Refine statement if needed
if h3_status == "REFINE":
    h3["statement"] = (
        "Cardiomyocytes classified as ncCM-IFT-like that reside in neuron-enriched microenvironments tend to show "
        "at most modest shifts in conduction and ion-handling gene programs compared to ncCM-IFT-like cells located "
        "away from neuronal neighbors, rather than a uniformly strong upregulation of conduction features."
    )

h3["narrowing_notes"] = " ".join(h3_notes)
h3["status"] = h3_status
print("\nH3 status:", h3_status)
for line in h3_notes:
    print(line)

if h3_status == "DROP":
    dropped.append(h3)
else:
    results.append(h3)

# ---------- Save final hypotheses.json and hypothesis_brief.md ----------
final_path = Path(DATA_DIR) / "hypotheses" / "hypotheses.json"
final_payload = {"hypotheses": results}
with open(final_path, "w") as f:
    json.dump(final_payload, f, indent=2)
print("\nFinal hypotheses written to", final_path)

brief_path = Path(DATA_DIR) / "hypotheses" / "hypothesis_brief.md"
with open(brief_path, "w") as f:
    f.write("# Hypothesis Brief — Farah heart MERFISH spatial dataset\n\n")
    f.write("## Retained hypotheses (KEEP/REFINE)\n\n")
    for h in results:
        f.write(f"### {h['id']}\n")
        f.write(f"**Status:** {h['status']}\n\n")
        f.write(f"**Statement:** {h['statement']}\n\n")
        f.write(f"**Grounded in:** {', '.join(h['grounded_in'])}\n\n")
        f.write("**Narrowing notes:**\n\n")
        f.write(h["narrowing_notes"] + "\n\n")
    if dropped:
        f.write("## Dropped hypotheses\n\n")
        for h in dropped:
            f.write(f"- **{h['id']}** (status {h['status']}): {h['statement']}\n")
            if "narrowing_notes" in h:
                f.write(f"  - Notes: {h['narrowing_notes']}\n")
            f.write("\n")

print("Hypothesis brief written to", brief_path)

print("\nSummary of retained hypotheses IDs and status:", [(h["id"], h["status"]) for h in results])
print("Summary of dropped hypotheses IDs and status:", [(h["id"], h["status"]) for h in dropped])
