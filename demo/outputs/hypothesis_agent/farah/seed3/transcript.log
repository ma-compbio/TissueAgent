from pathlib import Path
import os
import json
import numpy as np
import pandas as pd

# Set up paths
data_dir = Path(DATA_DIR)
background_path = data_dir / "briefs" / "background.md"
fallback_background_path = data_dir / "briefs" / "paper_summary.txt"
dataset_path = data_dir / "dataset" / "dataset_farah_heart_merfish.h5ad"
log_dir = data_dir / "hypotheses"
log_dir.mkdir(parents=True, exist_ok=True)
exploration_log_path = log_dir / "exploration_log.md"

print("DATA_DIR:", data_dir)
print("Background path:", background_path)
print("Dataset path:", dataset_path)

# Read limited background
background_text = ""
if background_path.exists():
    with open(background_path, "r") as f:
        background_text = f.read()
    print("Loaded background.md (first 500 chars):")
    print(background_text[:500])
elif fallback_background_path.exists():
    with open(fallback_background_path, "r") as f:
        background_text = f.read()
    print("background.md not found, loaded paper_summary.txt (first 500 chars):")
    print(background_text[:500])
else:
    print("No background file found.")

# Load AnnData dataset
import anndata as ad

adata = ad.read_h5ad(dataset_path)
print("Loaded AnnData:")
print(adata)
print("obs columns:", list(adata.obs.columns))
print("var columns:", list(adata.var.columns)[:10], "... (total", adata.var.shape[1], "genes)")
print("obsm keys:", list(adata.obsm.keys()))

# Identify a likely cell-type label column
celltype_col_candidates = [c for c in adata.obs.columns if "celltype" in c.lower() or "cell_type" in c.lower() or "cluster" in c.lower()]
print("Cell type / cluster column candidates:", celltype_col_candidates)

celltype_col = None
if len(celltype_col_candidates) > 0:
    celltype_col = celltype_col_candidates[0]
else:
    # Fallback: pick the first categorical column with relatively few categories
    for c in adata.obs.columns:
        if pd.api.types.is_categorical_dtype(adata.obs[c]) or adata.obs[c].dtype == "category":
            n_cat = adata.obs[c].nunique()
        else:
            n_cat = adata.obs[c].nunique() if adata.obs[c].dtype == "object" else None
        if n_cat is not None and 2 <= n_cat <= 100:
            celltype_col = c
            break

print("Selected cell-type/cluster column:", celltype_col)

# Summarize cell-type counts
obs_summary = {}
if celltype_col is not None:
    ct_counts = adata.obs[celltype_col].value_counts().sort_values(ascending=False)
    total_cells = adata.n_obs
    obs_summary["total_cells"] = int(total_cells)
    obs_summary["celltype_col"] = celltype_col
    obs_summary["celltype_counts"] = ct_counts.to_dict()
    print("Top 10 cell types by count:")
    print(ct_counts.head(10))
    print("Number of distinct cell-type/cluster labels:", ct_counts.shape[0])
else:
    total_cells = adata.n_obs
    obs_summary["total_cells"] = int(total_cells)
    print("No suitable cell-type/cluster column found.")

# Check for any region/sample annotation columns
region_cols = [c for c in adata.obs.columns if any(k in c.lower() for k in ["region", "zone", "area", "slice", "sample"])]
print("Potential region/sample columns:", region_cols)

# Initialize / overwrite exploration log for this run
with open(exploration_log_path, "w") as log_f:
    log_f.write("# Exploration Log\n\n")

# Write OBSERVATION 1: dataset inventory
with open(exploration_log_path, "a") as log_f:
    log_f.write("OBSERVATION 1:\n")
    if celltype_col is not None:
        n_labels = len(obs_summary["celltype_counts"])
        top_entries = list(obs_summary["celltype_counts"].items())[:5]
        top_str = "; ".join([f"{k}: {v}" for k, v in top_entries])
        log_f.write(
            f"The MERFISH heart dataset contains {obs_summary['total_cells']} cells with a '{celltype_col}' label spanning {n_labels} distinct values. "
            f"The five most abundant labels are {top_str}. "
        )
    else:
        log_f.write(
            f"The MERFISH heart dataset contains {obs_summary['total_cells']} cells but no clear cell-type or cluster annotation column could be identified among obs columns {list(adata.obs.columns)}. "
        )
    if region_cols:
        # Summarize first region column
        rc = region_cols[0]
        rc_counts = adata.obs[rc].value_counts().to_dict()
        rc_top = list(rc_counts.items())[:5]
        rc_top_str = "; ".join([f"{k}: {v}" for k, v in rc_top])
        log_f.write(
            f"A potential region/sample column '{rc}' has {len(rc_counts)} distinct values, with top entries {rc_top_str}. "
        )
    else:
        log_f.write(
            "No obvious region or slice annotation columns (containing 'region', 'zone', 'area', 'slice', or 'sample') were detected in obs. "
        )
    log_f.write("\n\n")

print("OBSERVATION 1 written to exploration_log.md")
