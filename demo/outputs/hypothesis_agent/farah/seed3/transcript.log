from pathlib import Path
import json
import numpy as np
import pandas as pd

# Try to import stats functions
try:
    from scipy.stats import ranksums
except Exception as e:
    ranksums = None
    print("Warning: scipy.stats.ranksums not available:", e)

hypotheses_draft_path = Path(DATA_DIR) / "hypotheses" / "hypotheses_draft.json"
with open(hypotheses_draft_path, "r") as f:
    draft = json.load(f)

print("Loaded draft hypotheses IDs:", [h["id"] for h in draft["hypotheses"]])

# Helper: compute program scores for a given gene list
def compute_program_scores(adata_obj, gene_list):
    genes_present = [g for g in gene_list if g in adata_obj.var_names]
    if len(genes_present) == 0:
        return genes_present, None
    sub = adata_obj[:, genes_present]
    X = sub.X
    # Convert to dense if sparse
    if hasattr(X, "toarray"):
        X = X.toarray()
    scores = X.mean(axis=1)
    scores = np.array(scores).ravel()
    return genes_present, scores

# Common annotations / neighbors
pop_col = "Populations"
cluster_col = "leiden"
pops = adata.obs[pop_col].astype(str).values
clusters = adata.obs[cluster_col].astype(str).values
n_cells = adata.n_obs

# Ensure neighbor_indices exist (from earlier phase); if not, rebuild
if "neighbor_indices" not in globals():
    from sklearn.neighbors import NearestNeighbors
    coords = np.asarray(adata.obsm["spatial"])
    K = 10
    nn = NearestNeighbors(n_neighbors=K + 1, algorithm="kd_tree")
    nn.fit(coords)
    distances, indices = nn.kneighbors(coords)
    neighbor_indices = indices[:, 1:K + 1]
    print("Rebuilt neighbor_indices with K=10")

K = neighbor_indices.shape[1]
print("Using neighbor graph with K =", K)

results = []
dropped = []

# ---------- H1 TEST ----------
h1 = next(h for h in draft["hypotheses"] if h["id"] == "H1")
print("\nTesting", h1["id"])

# Rare-but-tight clusters from OBSERVATION 2
rare_clusters = ["15", "20", "28", "29", "31"]
ecm_gene_candidates = [g for g in adata.var_names if g.startswith("COL") or g.startswith("LAMA")] + \
                      [g for g in ["FN1", "VCAN", "POSTN", "FBN1", "ELN"] if g in adata.var_names]

ecm_genes_present, ecm_scores = compute_program_scores(adata, ecm_gene_candidates)
print("ECM genes present:", ecm_genes_present)

h1_notes = []

if ecm_scores is None or len(ecm_genes_present) == 0:
    h1_notes.append("No ECM/adhesion program could be evaluated because none of the specified ECM genes were present.")
    h1_status = "DROP"
else:
    # For each rare cluster, find dominant population and compare ECM scores
    comparisons = []
    for cl in rare_clusters:
        mask_cluster = (clusters == cl)
        if not mask_cluster.any():
            continue
        pops_in_cluster = pd.Series(pops[mask_cluster]).value_counts()
        dominant_pop = pops_in_cluster.index[0]
        n_dom = int(pops_in_cluster.iloc[0])
        # Background: same population, other clusters
        mask_dom_pop = (pops == dominant_pop)
        mask_background = mask_dom_pop & (~mask_cluster)
        if mask_background.sum() < 50 or mask_cluster.sum() < 50:
            continue
        scores_cluster = ecm_scores[mask_cluster]
        scores_back = ecm_scores[mask_background]
        med_cluster = float(np.median(scores_cluster))
        med_back = float(np.median(scores_back))
        diff = med_cluster - med_back
        if ranksums is not None:
            stat, pval = ranksums(scores_cluster, scores_back)
        else:
            # Fallback: no formal p-value
            stat, pval = np.nan, np.nan
        comparisons.append({
            "cluster": cl,
            "dominant_pop": dominant_pop,
            "n_cluster": int(mask_cluster.sum()),
            "n_dom_pop_cluster": n_dom,
            "n_background": int(mask_background.sum()),
            "median_cluster": med_cluster,
            "median_background": med_back,
            "diff_median": diff,
            "stat": float(stat),
            "pval": float(pval) if not np.isnan(pval) else None
        })
    if len(comparisons) == 0:
        h1_notes.append("Could not perform comparisons: rare clusters had too few cells sharing a dominant population or insufficient background cells.")
        h1_status = "DROP"
    else:
        # Summarize results
        sig_higher = 0
        sig_lower = 0
        nonsig = 0
        for c in comparisons:
            direction = "higher" if c["diff_median"] > 0 else "lower"
            pval = c["pval"]
            if pval is not None and pval < 0.05:
                if direction == "higher":
                    sig_higher += 1
                else:
                    sig_lower += 1
            else:
                nonsig += 1
            h1_notes.append(
                f"Cluster {c['cluster']} (dominant population {c['dominant_pop']}, "
                f"n_cluster={c['n_cluster']}, n_background={c['n_background']}) "
                f"had ECM score median {c['median_cluster']:.4f} vs {c['median_background']:.4f} "
                f"in background (diff {c['diff_median']:.4f}, p={c['pval']:.2e} if computed)."
            )
        h1_notes.append(
            f"Across {len(comparisons)} rare-but-tight clusters with evaluable comparisons, "
            f"{sig_higher} showed significantly higher ECM scores (p<0.05), "
            f"{sig_lower} showed significantly lower ECM scores, and {nonsig} were not significant."
        )
        # Decision logic
        if sig_higher > 0 and sig_lower == 0:
            h1_status = "KEEP"
            h1_notes.append("The data consistently support higher ECM/adhesion program scores in at least a subset of rare-but-tight clusters; hypothesis retained as stated.")
        elif sig_higher > 0 and sig_lower > 0:
            h1_status = "REFINE"
            h1_notes.append("The data show mixed effects (some clusters higher, some lower); hypothesis refined to focus on the clusters with higher ECM scores.")
        elif sig_higher == 0 and sig_lower == 0:
            h1_status = "DROP"
            h1_notes.append("No rare-but-tight clusters showed significant ECM score differences; hypothesis dropped.")
        else:  # sig_lower > 0 and sig_higher == 0
            h1_status = "DROP"
            h1_notes.append("Rare-but-tight clusters preferentially showed lower ECM scores than background; hypothesis contradicted and dropped.")

# If REFINE, adjust statement to mention "a subset"
if h1_status == "REFINE":
    h1["statement"] = (
        "A subset of spatially rare but highly self-associated cell communities captured by high-clustering-ratio "
        "leiden clusters exhibits coordinated enrichment of extracellular-matrix and cell-adhesion gene programs "
        "relative to more spatially dispersed clusters belonging to the same major population, while other rare "
        "clusters do not show this pattern."
    )

h1["narrowing_notes"] = " ".join(h1_notes)
h1["status"] = h1_status
print("\nH1 status:", h1_status)
for line in h1_notes:
    print(line)

if h1_status == "DROP":
    dropped.append(h1)
else:
    results.append(h1)

# ---------- H2 TEST ----------
h2 = next(h for h in draft["hypotheses"] if h["id"] == "H2")
print("\nTesting", h2["id"])

vascular_gene_candidates = ["PECAM1", "CDH5", "VWF", "KDR", "FLT1", "SELE", "ICAM1", "VCAM1"]
vascular_genes_present = [g for g in vascular_gene_candidates if g in adata.var_names]
print("Vascular/interface genes present:", vascular_genes_present)

h2_notes = []

# Define endothelial and neighbor populations
endo_pops = {"LEC", "VEC"}
neighbor_pops = {"adFibro", "EPDC", "Epicardial"}

endo_mask = np.isin(pops, list(endo_pops))
n_endo = int(endo_mask.sum())
h2_notes.append(f"Identified {n_endo} endothelial cells (Populations in {sorted(list(endo_pops))}).")

if n_endo < 100 or len(vascular_genes_present) == 0:
    if len(vascular_genes_present) == 0:
        h2_notes.append("No vascular-interface program could be evaluated because none of the specified endothelial genes were present.")
    if n_endo < 100:
        h2_notes.append("Too few endothelial cells to define robust interface and non-interface subsets.")
    h2_status = "DROP"
else:
    # Compute neighbor-based interface fraction for each endothelial cell
    endo_indices = np.where(endo_mask)[0]
    endo_neighbor_frac = np.zeros(n_endo, dtype=float)
    is_neighbor_interface = np.isin(pops, list(neighbor_pops))
    for i, cell_idx in enumerate(endo_indices):
        neigh = neighbor_indices[cell_idx]
        if len(neigh) == 0:
            endo_neighbor_frac[i] = 0.0
        else:
            endo_neighbor_frac[i] = is_neighbor_interface[neigh].mean()
    # Define top and bottom quantiles
    q_high = np.quantile(endo_neighbor_frac, 0.75)
    q_low = np.quantile(endo_neighbor_frac, 0.25)
    interface_mask_local = endo_neighbor_frac >= q_high
    non_interface_mask_local = endo_neighbor_frac <= q_low
    n_interface = int(interface_mask_local.sum())
    n_non_interface = int(non_interface_mask_local.sum())
    h2_notes.append(
        f"Using neighbor fractions of adFibro/EPDC/Epicardial, defined {n_interface} 'interface-associated' endothelial cells "
        f"(>=75th percentile, threshold {q_high:.3f}) and {n_non_interface} 'non-interface' cells "
        f"(<=25th percentile, threshold {q_low:.3f})."
    )

    if n_interface < 30 or n_non_interface < 30:
        h2_notes.append("Interface or non-interface endothelial subsets were too small for robust comparison; hypothesis dropped.")
        h2_status = "DROP"
    else:
        genes_used, vascular_scores = compute_program_scores(adata, vascular_genes_present)
        if vascular_scores is None:
            h2_notes.append("Failed to compute vascular program scores despite genes being present; hypothesis dropped.")
            h2_status = "DROP"
        else:
            # Map local masks back to global indices
            global_interface_mask = np.zeros(n_cells, dtype=bool)
            global_non_interface_mask = np.zeros(n_cells, dtype=bool)
            global_interface_mask[endo_indices[interface_mask_local]] = True
            global_non_interface_mask[endo_indices[non_interface_mask_local]] = True

            scores_interface = vascular_scores[global_interface_mask]
            scores_non_interface = vascular_scores[global_non_interface_mask]
            med_int = float(np.median(scores_interface))
            med_non = float(np.median(scores_non_interface))
            diff = med_int - med_non
            if ranksums is not None:
                stat, pval = ranksums(scores_interface, scores_non_interface)
            else:
                stat, pval = np.nan, np.nan

            h2_notes.append(
                f"Vascular-interface program (genes {genes_used}) had median score {med_int:.4f} in interface-associated "
                f"endothelial cells vs {med_non:.4f} in non-interface cells (diff {diff:.4f}, p={pval:.2e} if computed)."
            )

            if pval is not None and pval < 0.05 and diff > 0:
                h2_status = "KEEP"
                h2_notes.append("Interface-associated endothelial cells show significantly higher vascular-interface program scores; hypothesis retained.")
            elif pval is not None and pval < 0.05 and diff < 0:
                h2_status = "DROP"
                h2_notes.append("Interface-associated endothelial cells show significantly lower vascular-interface program scores; hypothesis contradicted and dropped.")
            else:
                h2_status = "REFINE"
                h2_notes.append("Differences in vascular-interface program scores between interface and non-interface endothelial cells are weak or not statistically significant; hypothesis refined to emphasize possible but modest shifts.")

# Refine statement if needed
if h2_status == "REFINE":
    h2["statement"] = (
        "Lymphatic and vascular endothelial cells in regions enriched for adventitial fibroblasts or "
        "epicardial-derived cells tend to show modest shifts, rather than uniformly strong increases, in "
        "vascular-interface and barrier-related gene programs compared to endothelial cells in regions with "
        "few such mesenchymal neighbors."
    )

h2["narrowing_notes"] = " ".join(h2_notes)
h2["status"] = h2_status
print("\nH2 status:", h2_status)
for line in h2_notes:
    print(line)

if h2_status == "DROP":
    dropped.append(h2)
else:
    results.append(h2)

# ---------- H3 TEST ----------
h3 = next(h for h in draft["hypotheses"] if h["id"] == "H3")
print("\nTesting", h3["id"])

conduction_gene_candidates = [g for g in adata.var_names if g.startswith("GJA") or g.startswith("SCN") or g.startswith("KCN")] + \
                             [g for g in ["RYR2", "CACNA1C", "HCN4"] if g in adata.var_names]
# Remove duplicates while preserving order
seen = set()
conduction_genes_present = []
for g in conduction_gene_candidates:
    if g not in seen:
        seen.add(g)
        conduction_genes_present.append(g)

print("Conduction/ion-handling genes present:", conduction_genes_present)

h3_notes = []

nc_label = "ncCM-IFT-like"
neuro_label = "Neuronal"

nc_mask = (pops == nc_label)
n_nc = int(nc_mask.sum())
h3_notes.append(f"Identified {n_nc} ncCM-IFT-like cells and {int((pops == neuro_label).sum())} Neuronal cells.")

if n_nc < 100 or len(conduction_genes_present) == 0:
    if len(conduction_genes_present) == 0:
        h3_notes.append("No conduction/ion-handling program could be evaluated because none of the specified genes were present.")
    if n_nc < 100:
        h3_notes.append("Too few ncCM-IFT-like cells to define neuron-proximal and neuron-distant subsets.")
    h3_status = "DROP"
else:
    # Neighbor-based neuron fraction for ncCM-IFT-like cells
    nc_indices = np.where(nc_mask)[0]
    is_neighbor_neuro = (pops == neuro_label)
    nc_neuro_frac = np.zeros(n_nc, dtype=float)
    for i, cell_idx in enumerate(nc_indices):
        neigh = neighbor_indices[cell_idx]
        if len(neigh) == 0:
            nc_neuro_frac[i] = 0.0
        else:
            nc_neuro_frac[i] = is_neighbor_neuro[neigh].mean()
    q_high = np.quantile(nc_neuro_frac, 0.75)
    q_low = np.quantile(nc_neuro_frac, 0.25)
    prox_mask_local = nc_neuro_frac >= q_high
    dist_mask_local = nc_neuro_frac <= q_low
    n_prox = int(prox_mask_local.sum())
    n_dist = int(dist_mask_local.sum())
    h3_notes.append(
        f"Defined {n_prox} 'neuron-proximal' ncCM-IFT-like cells (>=75th percentile Neuronal-neighbor fraction, threshold {q_high:.3f}) "
        f"and {n_dist} 'neuron-distant' cells (<=25th percentile, threshold {q_low:.3f})."
    )

    if n_prox < 30 or n_dist < 30:
        h3_notes.append("Neuron-proximal or neuron-distant ncCM-IFT-like subsets were too small for robust comparison; hypothesis dropped.")
        h3_status = "DROP"
    else:
        genes_used, cond_scores = compute_program_scores(adata, conduction_genes_present)
        if cond_scores is None:
