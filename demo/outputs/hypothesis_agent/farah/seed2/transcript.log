n_pos_1_ad = int((log2fc_ad_vf > 1.0).sum())
print(f"Number of genes with log2FC>0.5: {n_pos_05_ad}, with log2FC>1.0: {n_pos_1_ad} (out of {len(gene_names)})")

# If enough cells, gene expression: adFibro-in-niche vs adFibro-outside
if mask_ad_niche.sum() >= 20 and mask_ad_non.sum() >= 20:
    print("\nDifferential expression: adFibro in niche vs adFibro outside niche")
    mean_ad_niche = group_means(X, mask_ad_niche)
    mean_ad_non = group_means(X, mask_ad_non)
    log2fc_ad_inout = np.log2((mean_ad_niche + eps) / (mean_ad_non + eps))
    order3 = np.argsort(-log2fc_ad_inout)
    top_up_idx3 = order3[:20]
    print("Top 20 genes upregulated in adFibro-in-niche vs adFibro-outside by log2FC:")
    for i in top_up_idx3:
        print(f"{gene_names[i]}: log2FC={log2fc_ad_inout[i]:.2f}, mean_in={mean_ad_niche[i]:.3f}, mean_out={mean_ad_non[i]:.3f}")
    n_pos_05_inout = int((log2fc_ad_inout > 0.5).sum())
    n_pos_1_inout = int((log2fc_ad_inout > 1.0).sum())
    print(f"Number of genes with log2FC>0.5: {n_pos_05_inout}, with log2FC>1.0: {n_pos_1_inout} (out of {len(gene_names)})")
else:
    print("\nNot enough adFibro cells in at least one group for robust in-niche vs outside-niche DE test.")
