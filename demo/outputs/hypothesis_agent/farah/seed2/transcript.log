<execute>
import numpy as np
import pandas as pd
from pathlib import Path
from sklearn.neighbors import NearestNeighbors

data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
log_path = hyp_dir / "exploration_log.md"

print("Existing exploration_log.md:", log_path.exists())

# Re-inspect obs columns to identify cell-type and cluster labels
print("adata.obs columns:", adata.obs.columns.tolist())

# Treat 'Populations' as cell-type, 'leiden' as cluster
cell_type_col = None
cluster_col = None
if "Populations" in adata.obs.columns:
    cell_type_col = "Populations"
if "leiden" in adata.obs.columns:
    cluster_col = "leiden"

print("Selected cell_type_col:", cell_type_col)
print("Selected cluster_col:", cluster_col)

# EDA PASS 1: basic cell-type and cluster distributions
obs1_lines = []
obs1_lines.append("OBSERVATION 1:")
n_cells = adata.n_obs
obs1_lines.append(f"Total cells: {n_cells}.")
if cell_type_col is not None:
    ct_counts = adata.obs[cell_type_col].value_counts()
    obs1_lines.append(
        f"Cell-type column '{cell_type_col}' has {ct_counts.shape[0]} unique labels; "
        f"top 10 (label: count, percent of cells):"
    )
    top_ct = []
    for lbl, cnt in ct_counts.head(10).items():
        top_ct.append(f"{lbl}: {cnt} ({cnt / n_cells * 100:.2f}%)")
    obs1_lines.append(", ".join(top_ct))
else:
    obs1_lines.append("No explicit cell-type column identified.")

if cluster_col is not None:
    cl_counts = adata.obs[cluster_col].value_counts()
    obs1_lines.append(
        f"Cluster column '{cluster_col}' has {cl_counts.shape[0]} unique labels; "
        f"top 10 (label: count, percent of cells):"
    )
    top_cl = []
    for lbl, cnt in cl_counts.head(10).items():
        top_cl.append(f"{lbl}: {cnt} ({cnt / n_cells * 100:.2f}%)")
    obs1_lines.append(", ".join(top_cl))

# Also summarize batches/samples if present
for meta_col in ["Sample_ID", "Batch"]:
    if meta_col in adata.obs.columns:
        vc = adata.obs[meta_col].value_counts()
        obs1_lines.append(
            f"Metadata column '{meta_col}' has {vc.shape[0]} unique values; "
            f"top 10 (value: count, percent of cells):"
        )
        top_meta = []
        for lbl, cnt in vc.head(10).items():
            top_meta.append(f"{lbl}: {cnt} ({cnt / n_cells * 100:.2f}%)")
        obs1_lines.append(", ".join(top_meta))

obs1_text = "\n".join(obs1_lines) + "\n\n"
print("\n--- OBSERVATION 1 PREVIEW ---\n", obs1_text)

# Prepare spatial coordinates
coords = adata.obsm["spatial"]
print("Spatial coords shape:", coords.shape)

# Build KNN graph once (for k neighbors)
k = 20
nbrs = NearestNeighbors(n_neighbors=k + 1, algorithm="kd_tree").fit(coords)
distances, indices = nbrs.kneighbors(coords)
# Exclude self (first neighbor)
neighbor_indices = indices[:, 1:]
print("Neighbor_indices shape:", neighbor_indices.shape)

# EDA PASS 2: Rare-but-tight using same-label NN fraction vs global frequency (on cell_type_col if available)
obs2_lines = []
obs2_lines.append("OBSERVATION 2:")
if cell_type_col is None:
    obs2_lines.append("Cell-type column not found; rare-but-tight analysis cannot be performed on cell types.")
else:
    labels = adata.obs[cell_type_col].astype("category")
    label_names = labels.cat.categories.tolist()
    print("Number of cell-type labels:", len(label_names))

    label_array = labels.to_numpy()
    total_cells = label_array.shape[0]

    # Global frequencies
    value_counts = pd.Series(label_array).value_counts()
    global_freq = (value_counts / total_cells).to_dict()

    # Compute same-label neighbor fraction per cell
    same_label_frac_per_cell = np.zeros(total_cells, dtype=float)
    for i in range(total_cells):
        center_label = label_array[i]
        neigh_labels = label_array[neighbor_indices[i]]
        if len(neigh_labels) == 0:
            same_label_frac_per_cell[i] = np.nan
            continue
        same_label_frac_per_cell[i] = np.mean(neigh_labels == center_label)

    # Aggregate per label
    label_stats = []
    for lbl in label_names:
        mask = label_array == lbl
        if mask.sum() == 0:
            continue
        nn_same = np.nanmean(same_label_frac_per_cell[mask])
        gfreq = global_freq.get(lbl, 0.0)
        ratio = nn_same / gfreq if gfreq > 0 else np.nan
        label_stats.append(
            {
                "label": lbl,
                "n_cells": int(mask.sum()),
                "global_freq": gfreq,
                "nn_same_frac": nn_same,
                "concentration_ratio": ratio,
            }
        )

    label_stats_df = pd.DataFrame(label_stats).sort_values(
        "concentration_ratio", ascending=False
    )

    # Take top 5 labels by concentration ratio (rare-but-tight candidates)
    top_conc = label_stats_df.head(5)
    obs2_lines.append(
        "Rare-but-tight analysis on cell-type column "
        f"'{cell_type_col}' using k={k} nearest neighbors; top 5 labels by "
        "same-label neighbor fraction / global frequency:"
    )
    for _, row in top_conc.iterrows():
        obs2_lines.append(
            f"{row['label']}: cells={row['n_cells']} "
            f"({row['global_freq']*100:.2f}% of total), "
            f"same-label-NN-fraction={row['nn_same_frac']:.3f}, "
            f"concentration-ratio={row['concentration_ratio']:.2f}"
        )

    # Mandatory follow-up: for each of these labels, compute top 3 non-self neighboring labels by enrichment
    obs2_lines.append(
        "For each of these concentrated labels, the top 3 non-self neighboring "
        "cell-type labels (by enrichment over global frequency) among k-nearest neighbors are:"
    )

    # Precompute global neighbor label frequencies as baseline
    all_neighbor_labels = label_array[neighbor_indices.reshape(-1)]
    all_neighbor_vc = pd.Series(all_neighbor_labels).value_counts()
    global_neighbor_freq = (all_neighbor_vc / all_neighbor_labels.shape[0]).to_dict()

    for _, row in top_conc.iterrows():
        lbl = row["label"]
        mask = label_array == lbl
        central_indices = np.where(mask)[0]
        neigh_idx_for_label = neighbor_indices[central_indices].reshape(-1)
        neigh_labels_for_label = label_array[neigh_idx_for_label]
        # Exclude same-label neighbors
        neigh_labels_nonself = neigh_labels_for_label[neigh_labels_for_label != lbl]
        if neigh_labels_nonself.size == 0:
            obs2_lines.append(f"{lbl}: no non-self neighbors found.")
            continue
        vc = pd.Series(neigh_labels_nonself).value_counts()
        total_nonself = neigh_labels_nonself.shape[0]
        # Compute enrichment ratio vs global neighbor freq
        enrich_list = []
        for nl, cnt in vc.items():
            local_freq = cnt / total_nonself
            gfreq = global_neighbor_freq.get(nl, 0.0)
            ratio = local_freq / gfreq if gfreq > 0 else np.nan
            enrich_list.append(
                {"neighbor_label": nl, "local_freq": local_freq, "global_freq": gfreq, "enrich_ratio": ratio}
            )
        enrich_df = pd.DataFrame(enrich_list).sort_values("enrich_ratio", ascending=False)
        top3 = enrich_df.head(3)
        parts = []
        for _, er in top3.iterrows():
            parts.append(
                f"{er['neighbor_label']}: "
                f"local={er['local_freq']*100:.2f}% vs global={er['global_freq']*100:.2f}%, "
                f"enrichment-ratio={er['enrich_ratio']:.2f}"
            )
        obs2_lines.append(f"{lbl}: " + "; ".join(parts))

obs2_text = "\n".join(obs2_lines) + "\n\n"
print("\n--- OBSERVATION 2 PREVIEW ---\n", obs2_text[:1500])

# EDA PASS 3: Pairwise co-localization across all cell-type pairs using neighbor edges
obs3_lines = []
obs3_lines.append("OBSERVATION 3:")
if cell_type_col is None:
    obs3_lines.append("Cell-type column not found; pairwise co-localization across cell types not computed.")
else:
    labels = adata.obs[cell_type_col].astype("category")
    label_array = labels.to_numpy()
    total_cells = label_array.shape[0]

    # Count directed edges (center -> neighbor)
    center_labels = np.repeat(label_array, neighbor_indices.shape[1])
    neighbor_labels_flat = label_array[neighbor_indices.reshape(-1)]
    edges_df = pd.DataFrame({"center": center_labels, "neighbor": neighbor_labels_flat})
    pair_counts = edges_df.value_counts().rename("count").reset_index()

    # Global frequencies of center and neighbor labels
    center_freq = pd.Series(center_labels).value_counts() / center_labels.shape[0]
    neigh_freq = pd.Series(neighbor_labels_flat).value_counts() / neighbor_labels_flat.shape[0]

    # Compute expected count under independence: N_edges * p(center) * p(neighbor)
    n_edges = center_labels.shape[0]
    pair_records = []
    for _, row in pair_counts.iterrows():
        c = row["center"]
        n = row["neighbor"]
        obs_cnt = row["count"]
        exp_cnt = n_edges * center_freq[c] * neigh_freq[n]
        enrich = obs_cnt / exp_cnt if exp_cnt > 0 else np.nan
        pair_records.append(
            {
                "center": c,
                "neighbor": n,
                "obs_cnt": int(obs_cnt),
                "exp_cnt": float(exp_cnt),
                "enrichment_ratio": enrich,
            }
        )
    pair_df = pd.DataFrame(pair_records).sort_values("enrichment_ratio", ascending=False)

    # Report top 10 enriched pairs (excluding extreme single-count noise by requiring obs_cnt>=50)
    filtered_pairs = pair_df[pair_df["obs_cnt"] >= 50].head(10)
    obs3_lines.append(
        "Pairwise co-localization using k-nearest-neighbor edges on cell-type "
        f"column '{cell_type_col}' (k={k}); top 10 center→neighbor label pairs "
        "ranked by observed/expected edge count (require observed count ≥50):"
    )
    for _, row in filtered_pairs.iterrows():
        obs3_lines.append(
            f"{row['center']} → {row['neighbor']}: "
            f"observed_edges={row['obs_cnt']}, expected_edges={row['exp_cnt']:.1f}, "
            f"enrichment-ratio={row['enrichment_ratio']:.2f}"
        )

obs3_text = "\n".join(obs3_lines) + "\n\n"
print("\n--- OBSERVATION 3 PREVIEW ---\n", obs3_text[:1500])

# Append all observations to exploration_log.md
with open(log_path, "a") as f:
    f.write(obs1_text)
    f.write(obs2_text)
    f.write(obs3_text)

print(f"\nWritten OBSERVATION 1–3 to {log_path}")
</execute>

