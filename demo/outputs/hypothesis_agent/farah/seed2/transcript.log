from pathlib import Path
import json
import numpy as np
import pandas as pd

# Load draft hypotheses
data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
draft_path = hyp_dir / "hypotheses_draft.json"

with open(draft_path, "r") as f:
    draft_hypotheses = json.load(f)

print("Loaded hypotheses_draft.json with", len(draft_hypotheses), "entries")

# Basic objects from AnnData
pop = adata.obs["Populations"].astype("category")
pop_array = pop.to_numpy()
labels_unique = pop.cat.categories.tolist()
n_cells = adata.n_obs
print("Populations labels (n=", len(labels_unique), "):", labels_unique)

# Neighbor indices and labels (reuse if present, else recompute)
try:
    neighbor_indices
    k = neighbor_indices.shape[1]
    print("Using existing neighbor_indices with k =", k)
except NameError:
    from sklearn.neighbors import NearestNeighbors
    coords = adata.obsm["spatial"]
    k = 20
    nbrs = NearestNeighbors(n_neighbors=k + 1, algorithm="kd_tree").fit(coords)
    distances, indices = nbrs.kneighbors(coords)
    neighbor_indices = indices[:, 1:]
    print("Recomputed neighbor_indices with k =", k)

neighbor_labels_all = pop_array[neighbor_indices]  # shape (n_cells, k)

# Try to import scipy for p-values
try:
    from scipy import sparse
    from scipy import stats
    have_scipy = True
    print("Using scipy for sparse handling and statistics.")
except ImportError:
    import scipy.sparse as sparse  # may still work if scipy split
    try:
        from scipy import stats
        have_scipy = True
    except Exception:
        have_scipy = False
    print("scipy.stats availability:", have_scipy)

# Helper: compute mean expression for a boolean mask
def group_means(X, mask):
    import numpy as _np
    from scipy import sparse as _sp
    if _sp.issparse(X):
        return _np.asarray(X[mask].mean(axis=0)).ravel()
    else:
        return X[mask].mean(axis=0)


# -------------------------
# TEST H1
# -------------------------
print("\n=== Testing H1: conduction-like vs working ventricular CM environments and gene programs ===")

conduction_labels = ["ncCM-IFT-like", "ncCM-AVC-like", "vCM-His-Purkinje"]
working_labels = ["vCM-LV-Compact", "vCM-LV-Trabecular", "vCM-RV-Compact", "vCM-Proliferating"]

mask_cond = np.isin(pop_array, conduction_labels)
mask_work = np.isin(pop_array, working_labels)

n_cond = int(mask_cond.sum())
n_work = int(mask_work.sum())
print("Conduction-like cells:", n_cond, "Working-vCM cells:", n_work)

# Neighbor-type fractions
fibro_labels = ["aFibro", "vFibro", "adFibro"]
endo_labels = ["BEC", "VEC", "vEndocardial"]
neuronal_labels = ["Neuronal"]

is_fibro = np.isin(neighbor_labels_all, fibro_labels)
is_endo = np.isin(neighbor_labels_all, endo_labels)
is_neuro = np.isin(neighbor_labels_all, neuronal_labels)

fibro_frac = is_fibro.mean(axis=1)
endo_frac = is_endo.mean(axis=1)
neuro_frac = is_neuro.mean(axis=1)

def summarize_neighbor_frac(name, frac_array, mask_a, mask_b, label_a, label_b):
    import numpy as _np
    vals_a = frac_array[mask_a]
    vals_b = frac_array[mask_b]
    mean_a = float(vals_a.mean())
    mean_b = float(vals_b.mean())
    diff = mean_a - mean_b
    print(f"{name} neighbor fraction:")
    print(f"  {label_a}: mean={mean_a:.3f}, n={vals_a.shape[0]}")
    print(f"  {label_b}: mean={mean_b:.3f}, n={vals_b.shape[0]}")
    print(f"  difference ({label_a}-{label_b})={diff:.3f}")
    if have_scipy:
        try:
            stat, p = stats.mannwhitneyu(vals_a, vals_b, alternative="two-sided")
            print(f"  Mann-Whitney U p-value={p:.2e}")
        except Exception as e:
            print("  Mann-Whitney test failed:", e)

summarize_neighbor_frac("Fibroblast", fibro_frac, mask_cond, mask_work, "Conduction-like", "Working-vCM")
summarize_neighbor_frac("Endothelial", endo_frac, mask_cond, mask_work, "Conduction-like", "Working-vCM")
summarize_neighbor_frac("Neuronal", neuro_frac, mask_cond, mask_work, "Conduction-like", "Working-vCM")

# Differential expression: conduction-like vs working-vCM
X = adata.X
print("\nComputing differential expression (mean expression and log2 fold-change)...")
mean_cond = group_means(X, mask_cond)
mean_work = group_means(X, mask_work)

eps = 1e-9
log2fc = np.log2((mean_cond + eps) / (mean_work + eps))
# Rank genes by log2FC
gene_names = np.array(adata.var_names)
order = np.argsort(-log2fc)  # descending
top_up_idx = order[:20]
print("\nTop 20 genes upregulated in conduction-like vs working-vCM by log2FC:")
for i in top_up_idx:
    print(f"{gene_names[i]}: log2FC={log2fc[i]:.2f}, mean_cond={mean_cond[i]:.3f}, mean_work={mean_work[i]:.3f}")

# Count how many genes show substantial positive log2FC (e.g., >0.5 as an informal threshold)
n_pos_05 = int((log2fc > 0.5).sum())
n_pos_1 = int((log2fc > 1.0).sum())
print(f"\nNumber of genes with log2FC>0.5: {n_pos_05}, with log2FC>1.0: {n_pos_1} (out of {len(gene_names)})")


# -------------------------
# TEST H2
# -------------------------
print("\n=== Testing H2: adFibro–LEC–Epicardial niche and fibroblast programs ===")

ad_label = "adFibro"
vf_label = "vFibro"
lec_label = "LEC"
epi_label = "Epicardial"
epdc_label = "EPDC"

mask_ad = pop_array == ad_label
mask_vf = pop_array == vf_label
n_ad = int(mask_ad.sum())
n_vf = int(mask_vf.sum())
print("adFibro cells:", n_ad, "vFibro cells:", n_vf)

# Fractions of specific neighbor types
is_lec = (neighbor_labels_all == lec_label)
is_epi = (neighbor_labels_all == epi_label)
is_epdc = (neighbor_labels_all == epdc_label)
is_any_niche = np.logical_or.reduce([is_lec, is_epi, is_epdc])

lec_frac = is_lec.mean(axis=1)
epi_frac = is_epi.mean(axis=1)
epdc_frac = is_epdc.mean(axis=1)
niche_frac = is_any_niche.mean(axis=1)

def summarize_neighbor_frac_two(name, frac_array, mask_a, mask_b, label_a, label_b):
    import numpy as _np
    vals_a = frac_array[mask_a]
    vals_b = frac_array[mask_b]
    mean_a = float(vals_a.mean())
    mean_b = float(vals_b.mean())
    diff = mean_a - mean_b
    print(f"{name} neighbor fraction:")
    print(f"  {label_a}: mean={mean_a:.3f}, n={vals_a.shape[0]}")
    print(f"  {label_b}: mean={mean_b:.3f}, n={vals_b.shape[0]}")
    print(f"  difference ({label_a}-{label_b})={diff:.3f}")
    if have_scipy:
        try:
            stat, p = stats.mannwhitneyu(vals_a, vals_b, alternative='two-sided')
            print(f"  Mann-Whitney U p-value={p:.2e}")
        except Exception as e:
            print("  Mann-Whitney test failed:", e)

print("\nNeighbor-type enrichment for adFibro vs vFibro:")
summarize_neighbor_frac_two("LEC", lec_frac, mask_ad, mask_vf, "adFibro", "vFibro")
summarize_neighbor_frac_two("Epicardial", epi_frac, mask_ad, mask_vf, "adFibro", "vFibro")
summarize_neighbor_frac_two("EPDC", epdc_frac, mask_ad, mask_vf, "adFibro", "vFibro")
summarize_neighbor_frac_two("Any(LEC/Epicardial/EPDC)", niche_frac, mask_ad, mask_vf, "adFibro", "vFibro")

# Proportion of cells with at least one niche neighbor
has_lec = is_lec.any(axis=1)
has_epi = is_epi.any(axis=1)
has_epdc = is_epdc.any(axis=1)
has_any_niche = is_any_niche.any(axis=1)

def proportion(mask, base_mask):
    # proportion within base_mask that satisfy mask
    sel = np.logical_and(mask, base_mask)
    return sel.sum() / base_mask.sum() if base_mask.sum() > 0 else np.nan

print("\nProportion of cells with at least one niche neighbor:")
for name, arr in [
    ("LEC", has_lec),
    ("Epicardial", has_epi),
    ("EPDC", has_epdc),
    ("Any(LEC/Epicardial/EPDC)", has_any_niche),
]:
    pa = proportion(arr, mask_ad)
    pv = proportion(arr, mask_vf)
    print(f"{name}: adFibro={pa*100:.1f}% of adFibro, vFibro={pv*100:.1f}% of vFibro")

# Define adFibro-in-niche vs adFibro-outside-niche for expression comparison
mask_ad_niche = np.logical_and(mask_ad, has_any_niche)
mask_ad_non = np.logical_and(mask_ad, ~has_any_niche)
print("\nadFibro in niche (>=1 LEC/Epicardial/EPDC neighbor):", int(mask_ad_niche.sum()))
print("adFibro outside niche:", int(mask_ad_non.sum()))

# Gene expression: adFibro vs vFibro
print("\nDifferential expression: adFibro vs vFibro")
mean_ad = group_means(X, mask_ad)
mean_vf = group_means(X, mask_vf)
log2fc_ad_vf = np.log2((mean_ad + eps) / (mean_vf + eps))
order2 = np.argsort(-log2fc_ad_vf)
top_up_idx2 = order2[:20]
print("Top 20 genes upregulated in adFibro vs vFibro by log2FC:")
for i in top_up_idx2:
    print(f"{gene_names[i]}: log2FC={log2fc_ad_vf[i]:.2f}, mean_ad={mean_ad[i]:.3f}, mean_vf={mean_vf[i]:.3f}")
