from pathlib import Path
import ad
from anndata import AnnData

data_dir = Path(DATA_DIR)
background_path = data_dir / "briefs" / "background.md"
fallback_bg_path = data_dir / "briefs" / "paper_summary.txt"
dataset_path = data_dir / "dataset" / "dataset_farah_heart_merfish.h5ad"
inventory_path = data_dir / "tables" / "data_inventory.tsv"
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)

print("Reading background...")
if background_path.exists():
    bg_text = background_path.read_text()[:2000]
    print("Loaded background.md (first 2000 chars):\n", bg_text)
elif fallback_bg_path.exists():
    bg_text = fallback_bg_path.read_text()[:2000]
    print("background.md missing, loaded paper_summary.txt (first 2000 chars):\n", bg_text)
else:
    bg_text = ""
    print("No background file found.")

print("\nLoading AnnData from:", dataset_path)
adata = ad.read_h5ad(dataset_path)
print("AnnData loaded.")
print("Shape (cells x genes):", adata.shape)

print("\n.obs columns:", list(adata.obs.columns))
print(".var columns:", list(adata.var.columns))
print(".uns keys:", list(adata.uns.keys()))
print(".obsm keys:", list(adata.obsm.keys()))

if inventory_path.exists():
    print("\nFound data_inventory.tsv:")
    print(inventory_path.read_text()[:1000])
else:
    print("\nNo data_inventory.tsv found.")

# Basic inventory: cell type columns and counts
possible_ct_cols = [c for c in adata.obs.columns if "cell_type" in c.lower() or "annotation" in c.lower() or "cluster" in c.lower()]
print("\nCandidate cell-type / cluster columns:", possible_ct_cols)

inventory = {}
for col in possible_ct_cols:
    vc = adata.obs[col].value_counts()
    inventory[col] = {"n_levels": int(vc.shape[0]), "top_levels": vc.head(10).to_dict()}
    print(f"\nColumn {col}: {vc.shape[0]} unique labels")
    print(vc.head(10))

# Determine spatial coordinates source
coords = None
coord_source = None
if "spatial" in adata.obsm_keys():
    coords = adata.obsm["spatial"]
    coord_source = "obsm['spatial']"
else:
    # look for x/y-like columns
    x_cols = [c for c in adata.obs.columns if c.lower() in ("x", "x_coord", "x_um", "xcoord")]
    y_cols = [c for c in adata.obs.columns if c.lower() in ("y", "y_coord", "y_um", "ycoord")]
    if x_cols and y_cols:
        coords = adata.obs[[x_cols[0], y_cols[0]]].to_numpy()
        coord_source = f"obs['{x_cols[0]}','{y_cols[0]}']"
    else:
        # check obsm for 2D arrays
        for k in adata.obsm_keys():
            if adata.obsm[k].shape[1] == 2:
                coords = adata.obsm[k]
                coord_source = f"obsm['{k}']"
                break

print("\nSpatial coordinate source:", coord_source)
if coords is not None:
    print("Spatial extent (min/max per axis):")
    print("min:", coords.min(axis=0), "max:", coords.max(axis=0))

# Gene panel size
print("\nNumber of genes:", adata.n_vars)
print("First 10 gene names:", list(adata.var_names[:10]))
</execute>

