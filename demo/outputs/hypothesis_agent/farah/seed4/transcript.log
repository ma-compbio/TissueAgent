<execute>
import numpy as np
import pandas as pd
from pathlib import Path
import re

from sklearn.neighbors import NearestNeighbors

data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
exploration_log_path = hyp_dir / "exploration_log.md"

# Utility to get next OBSERVATION number
def get_next_obs_number(log_path):
    if not log_path.exists():
        return 1
    txt = log_path.read_text()
    matches = re.findall(r"OBSERVATION\s+(\d+):", txt)
    if not matches:
        return 1
    nums = [int(m) for m in matches]
    return max(nums) + 1

# Ensure adata in memory
if 'adata' not in locals():
    dataset_path = data_dir / "dataset" / "dataset_farah_heart_merfish.h5ad"
    adata = ad.read_h5ad(dataset_path)

celltype_col = 'Populations'
labels = adata.obs[celltype_col].astype('category')
adata.obs[celltype_col] = labels
label_array = labels.values
unique_labels = labels.cat.categories
n_cells = adata.n_obs

# ---- Build spatial kNN graph (shared for subsequent analyses) ----
spatial = adata.obsm["spatial"]
k = 20  # number of neighbors (excluding self)
nbrs = NearestNeighbors(n_neighbors=k+1, algorithm='ball_tree').fit(spatial)
indices = nbrs.kneighbors(spatial, return_distance=False)
# indices: (n_cells, k+1); first neighbor is self
neighbor_indices = indices[:, 1:]  # drop self
neighbor_flat = neighbor_indices.ravel()
source_flat = np.repeat(np.arange(n_cells), k)

print("kNN graph built:", source_flat.shape[0], "directed edges")

# ---- EDA PASS 2 (RARE-BUT-TIGHT): same-label NN enrichment per label ----
same_label_neighbor = (label_array[source_flat] == label_array[neighbor_flat]).astype(float)

# For each cell, fraction of same-label neighbors
same_frac_per_cell = same_label_neighbor.reshape(n_cells, k).mean(axis=1)

# Compute per-label stats
results = []
global_counts = labels.value_counts()
global_frac = global_counts / n_cells

for lab in unique_labels:
    mask = (label_array == lab)
    n_lab = int(mask.sum())
    if n_lab == 0:
        continue
    mean_same = float(same_frac_per_cell[mask].mean())
    gfrac = float(global_frac.loc[lab])
    diff = mean_same - gfrac
    ratio = mean_same / gfrac if gfrac > 0 else np.nan
    results.append({
        "label": lab,
        "n_cells": n_lab,
        "global_frac": gfrac,
        "mean_same_nn_frac": mean_same,
        "diff_vs_global": diff,
        "ratio_vs_global": ratio
    })

df_conc = pd.DataFrame(results).sort_values("diff_vs_global", ascending=False)
print("Per-label same-label neighbor enrichment (top 10 by diff):")
print(df_conc.head(10))

# Select top 5 "rare-but-tight" (by diff), require at least 200 cells to avoid noise
df_conc_filt = df_conc[df_conc["n_cells"] >= 200]
top_conc = df_conc_filt.head(5)
print("Top concentrated labels (>=200 cells):")
print(top_conc)

obs_num = get_next_obs_number(exploration_log_path)
with exploration_log_path.open("a") as f:
    f.write(f"OBSERVATION {obs_num}:\n")
    f.write(
        f"Using a spatial kNN graph (k={k}) on 2D MERFISH coordinates, I computed for each of the "
        f"{df_conc.shape[0]} {celltype_col} labels the mean fraction of same-label nearest neighbors "
        f"and compared it to the global abundance of that label. The top 5 spatially concentrated "
        f"labels (requiring at least 200 cells) by excess same-label fraction were: " +
        "; ".join([
            f"{row['label']} (n={int(row['n_cells'])}, global_frac={row['global_frac']:.3f}, "
            f"mean_same_nn_frac={row['mean_same_nn_frac']:.3f}, diff_vs_global={row['diff_vs_global']:.3f})"
            for _, row in top_conc.iterrows()
        ]) +
        ".\n\n"
    )

print(f"Logged OBSERVATION {obs_num} (rare-but-tight)")

# ---- Mandatory follow-up: top non-self neighbors for each rare-but-tight label ----
# Precompute global neighbor-type frequencies for enrichment baseline
global_neighbor_counts = pd.value_counts(label_array[neighbor_flat])
global_neighbor_frac = global_neighbor_counts / global_neighbor_counts.sum()

neighbor_obs_entries = []

for _, row in top_conc.iterrows():
    lab = row["label"]
    lab_mask = (label_array == lab)
    lab_indices = np.where(lab_mask)[0]
    # gather neighbors of these cells
    lab_neighbor_idx = neighbor_indices[lab_indices, :].ravel()
    lab_neighbor_labels = label_array[lab_neighbor_idx]
    counts = pd.value_counts(lab_neighbor_labels)
    total_neighbors = counts.sum()
    # compute enrichment vs global
    enr_rows = []
    for nb_lab, cnt in counts.items():
        if nb_lab == lab:
            continue
        p_global = float(global_neighbor_frac.get(nb_lab, 0))
        freq_local = cnt / total_neighbors
        enr = freq_local / p_global if p_global > 0 else np.nan
        enr_rows.append({
            "neighbor_label": nb_lab,
            "count": int(cnt),
            "local_frac": freq_local,
            "global_frac": p_global,
            "enrichment_ratio": enr
        })
    if not enr_rows:
        continue
    df_enr = pd.DataFrame(enr_rows).sort_values("enrichment_ratio", ascending=False)
    top3 = df_enr.head(3)
    neighbor_obs_entries.append((lab, top3, total_neighbors))

# Log a separate OBSERVATION summarizing neighbor enrichments
obs_num2 = get_next_obs_number(exploration_log_path)
with exploration_log_path.open("a") as f:
    f.write(f"OBSERVATION {obs_num2}:\n")
    for lab, top3, total_neighbors in neighbor_obs_entries:
        f.write(
            f"For the concentrated label {lab}, considering {total_neighbors} spatial neighbors "
            f"of its cells, the top 3 non-self neighboring labels enriched above global expectation "
            f"(by neighbor-type frequency) were: " +
            "; ".join([
                f"{r['neighbor_label']} (count={int(r['count'])}, local_frac={r['local_frac']:.3f}, "
                f"global_frac={r['global_frac']:.3f}, enrichment_ratio={r['enrichment_ratio']:.2f})"
                for _, r in top3.iterrows()
            ]) +
            ". "
        )
    f.write("\n\n")

print(f"Logged OBSERVATION {obs_num2} (neighbors of rare-but-tight labels)")

# ---- EDA PASS 3: Global pairwise co-localization across all label pairs ----
# Build an undirected edge list (to avoid double counting)
rows = source_flat
cols = neighbor_flat
mask_undirected = rows < cols
rows_u = rows[mask_undirected]
cols_u = cols[mask_undirected]
types_rows = label_array[rows_u]
types_cols = label_array[cols_u]

pair_labels = np.where(
    types_rows <= types_cols,
    types_rows + "|" + types_cols,
    types_cols + "|" + types_rows
)
pair_counts = pd.value_counts(pair_labels)
total_edges = pair_counts.sum()

# Compute expected counts under random mixing
p = (labels.value_counts() / n_cells).to_dict()
enrichment_records = []
for pair, obs_cnt in pair_counts.items():
    lab1, lab2 = pair.split("|")
    p1, p2 = p[lab1], p[lab2]
    if lab1 == lab2:
        expected = (p1 ** 2) * total_edges
    else:
        expected = (2 * p1 * p2) * total_edges  # unordered pair probability
    if expected <= 0:
        continue
    enr = obs_cnt / expected
    enrichment_records.append({
        "pair": pair,
        "lab1": lab1,
        "lab2": lab2,
        "obs_count": int(obs_cnt),
        "expected_count": float(expected),
        "enrichment_ratio": float(enr)
    })

df_pairs = pd.DataFrame(enrichment_records)

# Filter to reasonably frequent edges to avoid extreme ratios from tiny counts
df_pairs_filtered = df_pairs[df_pairs["obs_count"] >= 500].sort_values("enrichment_ratio", ascending=False)
top_pairs = df_pairs_filtered.head(10)

print("Top 10 enriched label pairs by spatial co-localization (obs_count>=500):")
print(top_pairs)

obs_num3 = get_next_obs_number(exploration_log_path)
with exploration_log_path.open("a") as f:
    f.write(f"OBSERVATION {obs_num3}:\n")
    f.write(
        f"Using the undirected spatial kNN graph ({int(total_edges)} edges after symmetrization), "
        f"I quantified co-localization for all {df_pairs.shape[0]} unordered label pairs by comparing "
        f"their observed edge counts to expectations under random mixing based on global label "
        f"frequencies. Restricting to pairs with at least 500 edges, the 10 most enriched pairs were: "
        + "; ".join([
            f"{row['pair']} (obs_count={int(row['obs_count'])}, expected_count={row['expected_count']:.1f}, "
            f"enrichment_ratio={row['enrichment_ratio']:.2f})"
            for _, row in top_pairs.iterrows()
        ]) +
        ".\n\n"
    )

