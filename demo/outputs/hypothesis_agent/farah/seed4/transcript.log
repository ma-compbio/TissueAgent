from pathlib import Path
import json
import numpy as np
import pandas as pd
import scanpy as sc

# ---------- Load draft hypotheses ----------
data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
draft_path = hyp_dir / "hypotheses_draft.json"

with draft_path.open() as f:
    hypotheses = json.load(f)

print("Loaded draft hypotheses:", [h["id"] for h in hypotheses])

# ---------- Ensure adata and basic annotations are loaded ----------
if 'adata' not in locals():
    dataset_path = data_dir / "dataset" / "dataset_farah_heart_merfish.h5ad"
    adata = ad.read_h5ad(dataset_path)

if 'Populations' not in adata.obs.columns:
    raise ValueError("Populations column not found in adata.obs")

labels = adata.obs['Populations'].astype('category')
adata.obs['Populations'] = labels
label_array = labels.values.astype(str)
n_cells = adata.n_obs
var_names = list(adata.var_names)

print("n_cells:", n_cells, "n_genes:", len(var_names))
print("Unique Populations labels:", list(labels.cat.categories))

# ---------- Ensure spatial neighbor graph ----------
from sklearn.neighbors import NearestNeighbors

if 'neighbor_indices' not in locals():
    spatial = adata.obsm["spatial"]
    k = 20
    nbrs = NearestNeighbors(n_neighbors=k+1, algorithm='ball_tree').fit(spatial)
    indices = nbrs.kneighbors(spatial, return_distance=False)
    neighbor_indices = indices[:, 1:]
    print("Rebuilt neighbor_indices with k=", k)
else:
    k = neighbor_indices.shape[1]
    print("Using existing neighbor_indices with k=", k)

# Helper: compute mean expression score for a list of genes
def compute_program_score(adata_obj, genes):
    if len(genes) == 0:
        return np.zeros(adata_obj.n_obs, dtype=float)
    X_sub = adata_obj[:, genes].X
    # convert to dense and mean across genes
    X_dense = np.asarray(X_sub.todense()) if hasattr(X_sub, "todense") else np.asarray(X_sub)
    return X_dense.mean(axis=1).A1 if isinstance(X_dense, np.matrix) else X_dense.mean(axis=1)

# Try to import statistical tests
try:
    from scipy.stats import mannwhitneyu, kruskal
    have_scipy = True
except Exception as e:
    print("SciPy not available or failed to import:", e)
    have_scipy = False

# Container for final hypotheses (KEEP/REFINE)
final_hypotheses = []
dropped = []

# =========================
# H1: Specialized CM microdomains
# =========================
h1 = next(h for h in hypotheses if h["id"] == "H1")

# Define specialized and bulk CM labels
specialized_labels = [
    "ncCM-IFT-like",
    "ncCM-AVC-like",
    "vCM-His-Purkinje",
    "vCM-RV-AV"
]
bulk_labels = [
    "vCM-LV-Compact",
    "vCM-LV-Trabecular",
    "vCM-RV-Compact",
    "vCM-RV-Trabecular"
]

present_specialized = [lab for lab in specialized_labels if lab in labels.cat.categories]
present_bulk = [lab for lab in bulk_labels if lab in labels.cat.categories]

print("H1 specialized_labels present:", present_specialized)
print("H1 bulk_labels present:", present_bulk)

mask_specialized = adata.obs['Populations'].isin(present_specialized).values
mask_bulk = adata.obs['Populations'].isin(present_bulk).values

n_spec = int(mask_specialized.sum())
n_bulk = int(mask_bulk.sum())
print("H1 group sizes - specialized:", n_spec, "bulk:", n_bulk)

# Define conduction and stress-response programs based on available genes
candidate_conduction = [
    "CACNA1C", "CASQ2", "CKMT2", "RYR2", "PLN", "ATP2A2", "GJA1", "GJA5",
    "SCN5A", "KCNH2", "KCNJ2", "KCNJ8", "HCN4", "NKX2-5", "TBX3", "TBX5",
    "TBX18", "ISL1"
]
conduction_genes = sorted([g for g in candidate_conduction if g in var_names])

candidate_stress = [
    "FOS", "JUN", "JUNB", "JUND", "ATF3", "DDIT3", "EGR1", "EGR2",
    "HSPB1", "HSPA1A", "HSPA1B", "HSP90AA1", "HSP90AB1", "HIF1A", "NR4A1"
]
stress_genes = sorted([g for g in candidate_stress if g in var_names])

print("H1 conduction_genes in panel:", conduction_genes)
print("H1 stress_genes in panel:", stress_genes)

h1_notes = []

if n_spec >= 50 and n_bulk >= 200 and (len(conduction_genes) >= 3 or len(stress_genes) >= 3):
    # Compute program scores for all cells
    conduction_score = compute_program_score(adata, conduction_genes) if len(conduction_genes) > 0 else np.zeros(n_cells)
    stress_score = compute_program_score(adata, stress_genes) if len(stress_genes) > 0 else np.zeros(n_cells)

    # Extract group scores
    cs_spec = conduction_score[mask_specialized]
    cs_bulk = conduction_score[mask_bulk]
    ss_spec = stress_score[mask_specialized]
    ss_bulk = stress_score[mask_bulk]

    # Summaries
    h1_notes.append(
        f"H1 conduction program (genes={conduction_genes}, n={len(conduction_genes)}): "
        f"specialized mean={cs_spec.mean():.3f}, bulk mean={cs_bulk.mean():.3f}."
    )
    h1_notes.append(
        f"H1 stress program (genes={stress_genes}, n={len(stress_genes)}): "
        f"specialized mean={ss_spec.mean():.3f}, bulk mean={ss_bulk.mean():.3f}."
    )

    if have_scipy and len(conduction_genes) > 0:
        u_c, p_c = mannwhitneyu(cs_spec, cs_bulk, alternative="two-sided")
        h1_notes.append(f"H1 conduction Mann–Whitney U={u_c:.1f}, p={p_c:.2e}.")
    else:
        u_c, p_c = np.nan, np.nan

    if have_scipy and len(stress_genes) > 0:
        u_s, p_s = mannwhitneyu(ss_spec, ss_bulk, alternative="two-sided")
        h1_notes.append(f"H1 stress Mann–Whitney U={u_s:.1f}, p={p_s:.2e}.")
    else:
        u_s, p_s = np.nan, np.nan

    # Differential expression specialized vs bulk
    mask_h1 = mask_specialized | mask_bulk
    adata_h1 = adata[mask_h1, :].copy()
    adata_h1.obs["H1_group"] = np.where(
        adata_h1.obs["Populations"].isin(present_specialized), "specialized", "bulk"
    )
    sc.tl.rank_genes_groups(
        adata_h1,
        groupby="H1_group",
        groups=["specialized"],
        reference="bulk",
        method="wilcoxon",
        n_genes=50
    )
    de = adata_h1.uns["rank_genes_groups"]
    top_genes = pd.DataFrame({
        "gene": de["names"]["specialized"][:20],
        "logfoldchange": de["logfoldchanges"]["specialized"][:20],
        "pvals_adj": de["pvals_adj"]["specialized"][:20]
    })
    print("H1 top 20 DE genes specialized vs bulk:")
    print(top_genes)

    # Check how many conduction/stress genes appear among top DE
    de_genes_list = list(top_genes["gene"])
    de_conduction_overlap = [g for g in conduction_genes if g in de_genes_list]
    de_stress_overlap = [g for g in stress_genes if g in de_genes_list]
    h1_notes.append(
        f"H1 DE overlap: conduction genes in top 20={de_conduction_overlap}, "
        f"stress genes in top 20={de_stress_overlap}."
    )

    # Decide KEEP vs REFINE
    conduction_supported = (not np.isnan(p_c)) and (p_c < 1e-5) and (cs_spec.mean() > cs_bulk.mean())
    stress_supported = (not np.isnan(p_s)) and (p_s < 1e-3) and (ss_spec.mean() > ss_bulk.mean())

    if conduction_supported and stress_supported:
        status = "KEEP"
        h1_new_statement = h1["statement"]
    elif conduction_supported and not stress_supported:
        status = "REFINE"
        h1_new_statement = (
            "Specialized non-chamber and conduction-associated cardiomyocyte microdomains "
            "(e.g. ncCM-IFT-like, ncCM-AVC-like, vCM-His-Purkinje, vCM-RV-AV) that form highly self-clustered "
            "spatial islands exhibit coordinated enrichment of conduction and ion-handling gene programs, "
            "compared to bulk ventricular compact and trabecular cardiomyocytes that occupy more mixed regions; "
            "stress-response programs are not consistently elevated across these microdomains."
        )
    else:
        status = "DROP"
        h1_new_statement = h1["statement"]

    print("H1 decision:", status)
else:
    h1_notes.append(
        "H1 not fully testable: insufficient specialized/bulk cells or too few program genes in panel."
    )
    status = "DROP"
    h1_new_statement = h1["statement"]
    print("H1 decision: DROP (insufficient data / genes)")

if status != "DROP":
    h1["statement"] = h1_new_statement
    h1["narrowing_notes"] = " ".join(h1_notes)
    h1["status"] = status
    final_hypotheses.append(h1)
else:
    h1["narrowing_notes"] = " ".join(h1_notes)
    h1["status"] = "DROP"
    dropped.append(h1)

# =========================
# H2: Fibroblast niches & ECM programs
# =========================
h2 = next(h for h in hypotheses if h["id"] == "H2")

# Identify fibroblast labels
fibro_labels = [lab for lab in labels.cat.categories if "Fibro" in lab]
print("H2 fibro_labels:", fibro_labels)

mask_fibro = adata.obs["Populations"].isin(fibro_labels).values
n_fibro = int(mask_fibro.sum())
print("H2 n_fibro:", n_fibro)

h2_notes = []

if n_fibro >= 200:
    # Broad type mapping based on label names
    pop_array = adata.obs["Populations"].astype(str).values

    def broad_type(lab):
        if "Fibro" in lab:
            return "Fibro"
        if "CM-" in lab or "CM" in lab or "His-Purkinje" in lab:
            return "CM"
        if "Endocardial" in lab or lab in ["VEC", "BEC", "LEC"]:
            return "Endothelial"
        if lab in ["VSMC", "Pericyte"]:
            return "Vascular_support"
        if any(x in lab for x in ["Macrophage", "Monocyte", "Tcell", "Bcell"]):
            return "Immune"
        return "Other"

    # Precompute broad types for all cells
    broad_types = np.array([broad_type(lab) for lab in pop_array])

    # For each fibroblast, compute dominant neighbor broad_type
    fib_indices = np.where(mask_fibro)[0]
    neighbor_cats = []

    for idx in fib_indices:
        neigh = neighbor_indices[idx]
        neigh_types = broad_types[neigh]
        # Count excluding self fibro type vs including – we allow Fibro-dominated explicitly
        vals, counts = np.unique(neigh_types, return_counts=True)
        dominant = vals[np.argmax(counts)]
        neighbor_cats.append(dominant)

    neighbor_cats = np.array(neighbor_cats)
    cat_counts = pd.value_counts(neighbor_cats)
    print("H2 fibro neighbor broad-type counts:")
    print(cat_counts)

    # Map broad types into categories
    cat_map = {
        "CM": "CM_enriched",
        "Endothelial": "Endothelium_enriched",
        "Fibro": "Fibro_dominated",
        "Vascular_support": "Vascular_support_enriched",
        "Immune": "Immune_enriched",
        "Other": "Other"
    }
    neighbor_cat_mapped = np.array([cat_map.get(c, "Other") for c in neighbor_cats])

    # ECM / remodeling gene program from panel
    candidate_ecm = [
        "COL1A1", "COL1A2", "COL3A1", "COL5A1", "COL5A2", "COL6A1", "COL6A2", "COL14A1",
        "FN1", "LAMA2", "LAMB1", "LAMB2", "LAMC1",
        "POSTN", "VCAN", "DCN", "BGN", "SPARC", "THBS1", "THBS2", "THBS4",
        "MMP2", "MMP14", "TNC"
    ]
    ecm_genes = sorted([g for g in candidate_ecm if g in var_names])
    print("H2 ECM genes in panel:", ecm_genes)

    if len(ecm_genes) >= 3:
        ecm_score_all = compute_program_score(adata, ecm_genes)
        ecm_scores_fibro = ecm_score_all[fib_indices]

        # Summarize by neighbor category
        df_h2 = pd.DataFrame({
            "ecm_score": ecm_scores_fibro,
            "neighbor_cat": neighbor_cat_mapped
        })
        summary = df_h2.groupby("neighbor_cat")["ecm_score"].agg(["count", "mean", "std"])
        print("H2 ECM score by fibro neighbor category:")
        print(summary)

        # Focus on main categories with reasonable size
        main_cats = [c for c in ["CM_enriched", "Endothelium_enriched", "Fibro_dominated"] if c in summary.index and summary.loc[c, "count"] >= 50]
        h2_notes.append(f"H2 ECM program (genes={ecm_genes}, n={len(ecm_genes)}); main neighbor categories with >=50 fibro cells: {main_cats}.")

        # Global Kruskal-Wallis across all categories with >=50 cells
        if have_scipy:
            groups_for_kw = []
            labels_for_kw = []
            for cat, row in summary.iterrows():
                if row["count"] >= 50:
                    vals = df_h2.loc[df_h2["neighbor_cat"] == cat, "ecm_score"].values
                    groups_for_kw.append(vals)
                    labels_for_kw.append(cat)
            if len(groups_for_kw) >= 2:
                kw_stat, kw_p = kruskal(*groups_for_kw)
                h2_notes.append(f"H2 Kruskal-Wallis across neighbor categories {labels_for_kw}: H={kw_stat:.2f}, p={kw_p:.2e}.")
            else:
                kw_p = np.nan
        else:
            kw_p = np.nan

        # Pairwise comparison CM_enriched vs Fibro_dominated if both exist
        if have_scipy and "CM_enriched" in main_cats and "Fibro_dominated" in main_cats:
            cm_vals = df_h2.loc[df_h2["neighbor_cat"] == "CM_enriched", "ecm_score"].values
            fb_vals = df_h2.loc[df_h2["neighbor_cat"] == "Fibro_dominated", "ecm_score"].values
            u_ecm, p_ecm = mannwhitneyu(cm_vals, fb_vals, alternative="two-sided")
            h2_notes.append(
                f"H2 ECM CM_enriched vs Fibro_dominated: mean_CM={cm_vals.mean():.3f}, "
                f"mean_Fibro={fb_vals.mean():.3f}, U={u_ecm:.1f}, p={p_ecm:.2e}."
            )
        else:
            p_ecm = np.nan

        # Decide KEEP / REFINE / DROP
        # We look for a significant difference and at least ~10% relative difference in means
        if (not np.isnan(p_ecm)) and (p_ecm < 1e-5):
            status = "KEEP"
            h2_new_statement = h2["statement"]
        elif (not np.isnan(kw_p)) and (kw_p < 1e-3):
            status = "REFINE"
            h2_new_statement = (
                "Fibroblast subtypes in the developing heart show neighborhood-dependent variation in extracellular "
                "matrix gene program activity, with fibroblasts in cardiomyocyte-enriched or endothelial-enriched "
                "regions differing in ECM scores from those in fibroblast-dominated niches."
            )
        else:
            status = "DROP"
            h2_new_statement = h2["statement"]

        print("H2 decision:", status)
    else:
        h2_notes.append("Too few ECM genes from the candidate list are present in the panel to construct a robust program.")
        status = "DROP"
        h2_new_statement = h2["statement"]
        print("H2 decision: DROP (insufficient ECM genes)")
else:
    h2_notes.append("Insufficient fibroblast cells to test neighborhood-dependent ECM programs.")
    status = "DROP"
    h2_new_statement = h2["statement"]
    print("H2 decision: DROP (too few fibroblasts)")

if status != "DROP":
    h2["statement"] = h2_new_statement
    h2["narrowing_notes"] = " ".join(h2_notes)
    h2["status"] = status
    final_hypotheses.append(h2)
else:
    h2["narrowing_notes"] = " ".join(h2_notes)
    h2["status"] = "DROP"
    dropped.append(h2)

# =========================
# H3: LEC / vascular endothelial microdomains
# =========================
h3 = next(h for h in hypotheses if h["id"] == "H3")

h3_notes = []

# Identify endothelial labels
endo_labels = [lab for lab in labels.cat.categories if ("Endocardial" in lab) or (lab in ["VEC", "BEC", "LEC"])]
print("H3 endothelial-related labels:", endo_labels)

# Focus groups: LEC vs VEC
has_LEC = "LEC" in labels.cat.categories
has_VEC = "VEC" in labels.cat.categories

if has_LEC and has_VEC:
    mask_lec = (adata.obs["Populations"] == "LEC").values
    mask_vec = (adata.obs["Populations"] == "VEC").values
    n_lec = int(mask_lec.sum())
    n_vec = int(mask_vec.sum())
    print("H3 n_LEC:", n_lec, "n_VEC:", n_vec)

    if n_lec >= 50 and n_vec >= 200:
        # Vascular/lymphangiogenesis program
        candidate_vasc = [
            "ANGPT1", "ANGPT2", "KDR", "FLT1", "FLT4", "VEGFA", "VEGFC",
            "PDPN", "PROX1", "NRP1", "NRP2", "ACKR1", "CXCL12"
        ]
        vasc_genes = sorted([g for g in candidate_vasc if g in var_names])
        print("H3 vascular/lymphangiogenesis genes in panel:", vasc_genes)

        if len(vasc_genes) >= 3:
            vasc_score_all = compute_program_score(adata, vasc_genes)
            vs_lec = vasc_score_all[mask_lec]
            vs_vec = vasc_score_all[mask_vec]

            h3_notes.append(
                f"H3 vascular program (genes={vasc_genes}, n={len(vasc_genes)}): "
                f"LEC mean={vs_lec.mean():.3f}, VEC mean={vs_vec.mean():.3f}."
            )

            if have_scipy:
                u_v, p_v = mannwhitneyu(vs_lec, vs_vec, alternative="two-sided")
                h3_notes.append(f"H3 LEC vs VEC Mann–Whitney U={u_v:.1f}, p={p_v:.2e}.")
            else:
                p_v = np.nan

            # DE between LEC and VEC
            mask_h3 = mask_lec | mask_vec
            adata_h3 = adata[mask_h3, :].copy()
            adata_h3.obs["H3_group"] = np.where(
                adata_h3.obs["Populations"] == "LEC", "LEC", "VEC"
            )
            sc.tl.rank_genes_groups(
                adata_h3,
                groupby="H3_group",
                groups=["LEC"],
                reference="VEC",
                method="wilcoxon",
                n_genes=50
            )
            de3 = adata_h3.uns["rank_genes_groups"]
            top_h3 = pd.DataFrame({
                "gene": de3["names"]["LEC"][:20],
                "logfoldchange": de3["logfoldchanges"]["LEC"][:20],
                "pvals_adj": de3["pvals_adj"]["LEC"][:20]
            })
            print("H3 top 20 DE genes LEC vs VEC:")
            print(top_h3)

            de3_genes_list = list(top_h3["gene"])
            de_vasc_overlap = [g for g in vasc_genes if g in de3_genes_list]
            h3_notes.append(f"H3 DE overlap with vascular program genes in top 20: {de_vasc_overlap}.")

            # Decision
            if (not np.isnan(p_v)) and (p_v < 1e-5) and (vs_lec.mean() > vs_vec.mean()):
                status = "KEEP"
                # Slightly refine to focus on LEC vs VEC, since we did not explicitly test VSMC-associated endothelium
                h3_new_statement = (
                    "Endothelial microdomains dominated by lymphatic endothelial cells (LEC) in the developing heart "
                    "exhibit coordinated enrichment of lymphangiogenic and vascular signaling gene programs relative "
                    "to generic vascular endothelial clusters (VEC) that are less spatially restricted."
                )
            else:
                status = "REFINE"
                h3_new_statement = (
                    "Lymphatic endothelial cells and vascular endothelial cells in the developing heart form distinct "
                    "endothelial compartments with detectable, but more modest, differences in lymphangiogenic and "
                    "vascular signaling gene programs than initially anticipated."
                )
            print("H3 decision:", status)
        else:
            h3_notes.append("Too few vascular/lymphangiogenic genes from the candidate list are present in the panel.")
            status = "DROP"
            h3_new_statement = h3["statement"]
            print("H3 decision: DROP (insufficient vascular genes)")
    else:
        h3_notes.append("Too few LEC or VEC cells to robustly compare endothelial microdomains.")
        status = "DROP"
        h3_new_statement = h3["statement"]
        print("H3 decision: DROP (insufficient cells)")
else:
    h3_notes.append("LEC or VEC label missing from Populations; cannot test this endothelial microdomain contrast.")
    status = "DROP"
    h3_new_statement = h3["statement"]
    print("H3 decision: DROP (missing LEC/VEC)")

if status != "DROP":
    h3["statement"] = h3_new_statement
    h3["narrowing_notes"] = " ".join(h3_notes)
    h3["status"] = status
    final_hypotheses.append(h3)
else:
    h3["narrowing_notes"] = " ".join(h3_notes)
    h3["status"] = "DROP"
    dropped.append(h3)

# ---------- Write final hypotheses.json (KEEP/REFINE only) ----------
final_path = hyp_dir / "hypotheses.json"
with final_path.open("w") as f:
    json.dump(final_hypotheses, f, indent=2)

print(f"Wrote final hypotheses ({len(final_hypotheses)} kept/refined) to {final_path}")

# ---------- Write human-readable brief ----------
brief_path = hyp_dir / "hypothesis_brief.md"
lines = []
lines.append("# Hypothesis Brief — Farah developing human heart MERFISH\n\n")
lines.append(f"Total cells: {n_cells}, genes: {len(var_names)}, Populations: {len(labels.cat.categories)}.\n\n")

lines.append("## Retained hypotheses\n\n")
for h in final_hypotheses:
    lines.append(f"### {h['id']}: {h['statement']}\n\n")
    lines.append(f"- Grounded in: {', '.join(h.get('grounded_in', []))}\n")
    lines.append(f"- Status after narrowing: {h.get('status', 'NA')}\n")
    qs = h.get("quality_scores", {})
    if qs:
        lines.append(
            f"- Quality scores: Derivable={qs.get('derivable','NA')}, "
            f"Novel={qs.get('novel','NA')}, Feasible={qs.get('feasible','NA')}, "
            f"Specific={qs.get('specific','NA')}, Falsifiable={qs.get('falsifiable','NA')}.\n"
        )
    if "narrowing_notes" in h:
        lines.append(f"- Evidence notes: {h['narrowing_notes']}\n")
    lines.append("\n")

if dropped:
    lines.append("## Dropped hypotheses\n\n")
    for h in dropped:
        lines.append(f"- {h['id']}: {h['statement']} (status={h.get('status','DROP')}).\n")
        if "narrowing_notes" in h:
            lines.append(f"  Notes: {h['narrowing_notes']}\n")
        lines.append("\n")

with brief_path.open("w") as f:
    f.writelines(lines)

print(f"Wrote human-readable brief to {brief_path}")
