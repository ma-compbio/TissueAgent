import numpy as np
import pandas as pd
import scanpy as sc
import re

from pathlib import Path

data_dir = Path(DATA_DIR)
hyp_dir = data_dir / "hypotheses"
hyp_dir.mkdir(exist_ok=True, parents=True)
exploration_log_path = hyp_dir / "exploration_log.md"

# Helper: determine next OBSERVATION number
def get_next_obs_number(log_path):
    if not log_path.exists():
        return 1
    txt = log_path.read_text()
    matches = re.findall(r"OBSERVATION\s+(\d+):", txt)
    if not matches:
        return 1
    nums = [int(m) for m in matches]
    return max(nums) + 1

# Ensure we still have adata loaded (in case of REPL reset)
if 'adata' not in locals():
    dataset_path = data_dir / "dataset" / "dataset_farah_heart_merfish.h5ad"
    adata = ad.read_h5ad(dataset_path)

# Make sure key obs fields are categorical where appropriate
if 'Populations' in adata.obs.columns:
    adata.obs['Populations'] = adata.obs['Populations'].astype('category')
if 'leiden' in adata.obs.columns:
    adata.obs['leiden'] = adata.obs['leiden'].astype('category')

# ---- EDA PASS 1: Global inventory of cell populations and samples ----
n_cells = adata.n_obs
n_genes = adata.n_vars

celltype_col = 'Populations' if 'Populations' in adata.obs.columns else 'leiden'
celltype_counts = adata.obs[celltype_col].value_counts().sort_values(ascending=False)

sample_col = 'Sample_ID' if 'Sample_ID' in adata.obs.columns else None
if sample_col:
    sample_counts = adata.obs[sample_col].value_counts().sort_values(ascending=False)
else:
    sample_counts = None

# Spatial extent
if "spatial" in adata.obsm_keys():
    spatial = adata.obsm["spatial"]
    x_min, x_max = float(np.min(spatial[:,0])), float(np.max(spatial[:,0]))
    y_min, y_max = float(np.min(spatial[:,1])), float(np.max(spatial[:,1]))
else:
    x_min = x_max = y_min = y_max = np.nan

print("Inventory:")
print(" n_cells:", n_cells, " n_genes:", n_genes)
print(" Cell type column:", celltype_col)
print(celltype_counts.head())
if sample_counts is not None:
    print("Sample counts (top 5):")
    print(sample_counts.head())
print("Spatial extent x:[", x_min, ",", x_max, "] y:[", y_min, ",", y_max, "]")

# Prepare text for OBSERVATION 1
top5_ct = celltype_counts.head(5)
top5_ct_str = ", ".join([f"{idx}={int(cnt)}" for idx, cnt in top5_ct.items()])
n_celltypes = celltype_counts.shape[0]
if sample_counts is not None:
    n_samples = sample_counts.shape[0]
    top3_samples = sample_counts.head(3)
    top3_samples_str = ", ".join([f"{idx}={int(cnt)}" for idx, cnt in top3_samples.items()])
else:
    n_samples = 0
    top3_samples_str = "NA"

obs_num = get_next_obs_number(exploration_log_path)
with exploration_log_path.open("a") as f:
    f.write(f"OBSERVATION {obs_num}:\n")
    f.write(
        f"The dataset contains {n_cells} cells and {n_genes} genes with {n_celltypes} distinct {celltype_col} labels; "
        f"the most abundant populations are {top5_ct_str}. "
        f"Cells are distributed across {n_samples} samples ({sample_col}), with top samples {top3_samples_str}. "
        f"Spatial coordinates in `.obsm['spatial']` span x={x_min:.1f}–{x_max:.1f} and y={y_min:.1f}–{y_max:.1f}.\n\n"
    )

print(f"Logged OBSERVATION {obs_num} to {exploration_log_path}")
</execute>

