from pathlib import Path
import json, os, textwrap

import numpy as np
import pandas as pd

# Ensure hypotheses dir exists
hyp_dir = Path(DATA_DIR) / "hypotheses"
hyp_dir.mkdir(parents=True, exist_ok=True)

# Read limited background
briefs_dir = Path(DATA_DIR) / "briefs"
bg_path_md = briefs_dir / "background.md"
bg_path_txt = briefs_dir / "paper_summary.txt"

background_path = bg_path_md if bg_path_md.exists() else bg_path_txt
print("Using background file:", background_path)

background_text = ""
if background_path.exists():
    with open(background_path, "r") as f:
        background_text = f.read()
    print("Background preview:\n", "\n".join(background_text.splitlines()[:20]))
else:
    print("No background file found.")

# Load AnnData
from anndata import read_h5ad
data_path = Path(DATA_DIR) / "dataset" / "dataset_farah_heart_merfish.h5ad"
print("Loading AnnData from:", data_path)

adata = read_h5ad(data_path)
print("AnnData loaded.")
print("Shape (cells x genes):", adata.n_obs, "x", adata.n_vars)

print("\n.obs columns:")
print(adata.obs.columns.tolist())

print("\nFirst few rows of .obs:")
print(adata.obs.head())

print("\n.obsm keys:", list(adata.obsm.keys()))
print(".uns keys:", list(adata.uns.keys())[:20])

# Inspect potential cell-type label fields
candidate_obs_cols = []
for col in adata.obs.columns:
    if pd.api.types.is_categorical_dtype(adata.obs[col]) or adata.obs[col].dtype == object:
        nunique = adata.obs[col].nunique()
        if 1 < nunique < 1000:
            candidate_obs_cols.append((col, nunique))

print("\nCandidate categorical obs columns (name, n_unique):")
for name, nu in candidate_obs_cols:
    print(f"  {name}: {nu} categories")

# Show value counts for top few candidate columns
for name, nu in candidate_obs_cols[:5]:
    print(f"\nValue counts for {name}:")
    print(adata.obs[name].value_counts().head(20))

# Inspect for spatial coordinates
spatial_keys = []
if "spatial" in adata.obsm:
    spatial_keys.append("spatial")
for key in adata.obsm.keys():
    if key.lower() in ["spatial", "x_y", "xy", "spatial_coords"]:
        if key not in spatial_keys:
            spatial_keys.append(key)

print("\nPotential spatial .obsm keys:", spatial_keys)

# Also check for coordinate-like columns in .obs
coord_like_cols = [c for c in adata.obs.columns if c.lower() in ["x", "y", "pxl_col_in_fullres", "pxl_row_in_fullres", "x_centroid", "y_centroid"]]
print("Coordinate-like .obs columns:", coord_like_cols)
