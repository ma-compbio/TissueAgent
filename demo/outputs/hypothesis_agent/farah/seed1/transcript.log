from pathlib import Path
import json
import numpy as np
import pandas as pd

# Try to import scipy for statistical tests
try:
    from scipy import stats
    have_scipy = True
except Exception as e:
    print("Scipy not available:", repr(e))
    have_scipy = False

print("Phase 3: reading draft hypotheses...")
hyp_draft_path = Path(DATA_DIR) / "hypotheses" / "hypotheses_draft.json"
with open(hyp_draft_path, "r") as f:
    hypotheses = json.load(f)

print("Loaded hypotheses:", [h["id"] for h in hypotheses])

# ---------- Shared preprocessing: normalization ----------
print("Preparing normalized expression matrix...")

X = adata.X
# Handle sparse / dense
try:
    import scipy.sparse as sp
    if sp.issparse(X):
        X = X.tocsr()
        X_dense = X.astype(np.float32).toarray()
    else:
        X_dense = np.asarray(X, dtype=np.float32)
except Exception:
    X_dense = np.asarray(X, dtype=np.float32)

# Library-size normalization to counts per 10k and log1p
libsize = X_dense.sum(axis=1, keepdims=True)
libsize[libsize == 0] = 1.0
X_norm = X_dense / libsize * 1e4
X_norm = np.log1p(X_norm).astype(np.float32)
gene_names = np.array(adata.var_names)
print("Normalized matrix shape:", X_norm.shape)

# Helper: differential expression between two index sets
def differential_expression(idx_a, idx_b, label_a="A", label_b="B", min_cells=20):
    idx_a = np.array(idx_a, dtype=int)
    idx_b = np.array(idx_b, dtype=int)
    res = []
    if idx_a.size < min_cells or idx_b.size < min_cells:
        print(f"Warning: small group sizes for DE ({label_a}={idx_a.size}, {label_b}={idx_b.size})")
    Xa = X_norm[idx_a, :]
    Xb = X_norm[idx_b, :]
    mean_a = Xa.mean(axis=0)
    mean_b = Xb.mean(axis=0)
    # Add small pseudocount before ratio
    eps = 1e-5
    log2_fc = np.log2((mean_a + eps) / (mean_b + eps))

    if have_scipy:
        pvals = []
        for g in range(X_norm.shape[1]):
            try:
                stat, p = stats.mannwhitneyu(Xa[:, g], Xb[:, g], alternative="two-sided")
            except Exception:
                p = 1.0
            pvals.append(p)
        pvals = np.array(pvals)
        # Benjamini–Hochberg FDR
        order = np.argsort(pvals)
        ranked_p = pvals[order]
        m = len(pvals)
        bh = ranked_p * m / (np.arange(m) + 1)
        # enforce monotonicity
        for i in range(m - 2, -1, -1):
            if bh[i] > bh[i + 1]:
                bh[i] = bh[i + 1]
        fdr = np.empty_like(bh)
        fdr[order] = bh
    else:
        pvals = np.ones(X_norm.shape[1], dtype=float)
        fdr = np.ones_like(pvals)
    df = pd.DataFrame({
        "gene": gene_names,
        "mean_" + label_a: mean_a,
        "mean_" + label_b: mean_b,
        "log2_fc_" + label_a + "_vs_" + label_b: log2_fc,
        "pval": pvals,
        "fdr": fdr
    })
    return df

# Convenience structures from Phase 1
pop_series = adata.obs["Populations"].astype("category")
pop_cat = pop_series.cat
label_names = list(pop_cat.categories)
label_codes = pop_cat.codes.to_numpy()
n_labels = len(label_names)

label_to_idx = {name: i for i, name in enumerate(label_names)}

print("Available Populations labels:", label_names)

# neighbor_idx, neighbor_label_codes already computed earlier; verify
print("neighbor_idx shape:", neighbor_idx.shape if 'neighbor_idx' in globals() else "MISSING")
print("neighbor_label_codes shape:", neighbor_label_codes.shape if 'neighbor_label_codes' in globals() else "MISSING")

# ---------- Run H1 test plan ----------
print("\n=== Testing H1 ===")
H1 = next(h for h in hypotheses if h["id"] == "H1")

# Identify adFibro, LEC, EPDC indices
for name in ["adFibro", "LEC", "EPDC"]:
    if name not in label_to_idx:
        print(f"Label {name} not found in Populations!")
print("Indices:", {k: label_to_idx.get(k, None) for k in ["adFibro","LEC","EPDC"]})

adFibro_idx = label_to_idx.get("adFibro", None)
LEC_idx = label_to_idx.get("LEC", None)
EPDC_idx = label_to_idx.get("EPDC", None)

adFibro_cells = np.where(label_codes == adFibro_idx)[0]
print("Total adFibro cells:", adFibro_cells.size)

# Define interface: at least one LEC or EPDC neighbor among 14 nearest
neighbors_adFibro = neighbor_label_codes[adFibro_cells]
is_interface = np.any(
    (neighbors_adFibro == LEC_idx) | (neighbors_adFibro == EPDC_idx),
    axis=1
)

interface_adFibro = adFibro_cells[is_interface]
non_interface_adFibro = adFibro_cells[~is_interface]

print("Interface adFibro cells:", interface_adFibro.size)
print("Non-interface adFibro cells:", non_interface_adFibro.size)

# Differential expression: interface vs non-interface
de_H1 = differential_expression(interface_adFibro, non_interface_adFibro,
                                label_a="interface_adFibro", label_b="non_interface_adFibro")

# Identify interface-up genes: FDR < 0.05 and log2 FC > 0.25
up_H1 = de_H1[(de_H1["fdr"] < 0.05) & (de_H1["log2_fc_interface_adFibro_vs_non_interface_adFibro"] > 0.25)]
up_H1_sorted = up_H1.sort_values("log2_fc_interface_adFibro_vs_non_interface_adFibro", ascending=False)
top_up_H1 = up_H1_sorted.head(15)

print("\nH1: number of significantly upregulated genes in interface vs non-interface adFibro:", up_H1.shape[0])
print("Top 10 interface-up genes (gene, log2FC, FDR):")
print(top_up_H1[["gene", "log2_fc_interface_adFibro_vs_non_interface_adFibro", "fdr"]].head(10))

# For comparison, check whether these genes are similarly upregulated in other fibroblast types
other_fibro_labels = [lbl for lbl in ["aFibro", "vFibro"] if lbl in label_to_idx]
fibro_comp = {}
for lbl in other_fibro_labels:
    li = label_to_idx[lbl]
    cells_lbl = np.where(label_codes == li)[0]
    de_tmp = differential_expression(interface_adFibro, cells_lbl,
                                     label_a="interface_adFibro", label_b=lbl)
    # subset to the H1 interface-up genes
    de_tmp_sub = de_tmp[de_tmp["gene"].isin(up_H1_sorted["gene"].head(20))]
    fibro_comp[lbl] = de_tmp_sub.sort_values("log2_fc_interface_adFibro_vs_" + lbl, ascending=False)[
        ["gene", "log2_fc_interface_adFibro_vs_" + lbl, "fdr"]
    ].head(10)

print("\nH1: comparison of interface adFibro vs other fibroblast types (top genes among the interface-up set):")
for lbl, df_tmp in fibro_comp.items():
    print(f"\nInterface adFibro vs {lbl}:")
    print(df_tmp)

# ---------- Run H2 test plan ----------
print("\n=== Testing H2 ===")
H2 = next(h for h in hypotheses if h["id"] == "H2")

# Define conduction-like and working-ventricular groups
conduction_like_labels = [lbl for lbl in ["ncCM-IFT-like", "ncCM-AVC-like", "vCM-His-Purkinje"] if lbl in label_to_idx]
working_vm_labels = [lbl for lbl in ["vCM-LV-Compact", "vCM-RV-Compact",
                                     "vCM-LV-Trabecular", "vCM-RV-Trabecular",
                                     "vCM-LV-AV", "vCM-RV-AV"] if lbl in label_to_idx]

print("Conduction-like labels:", conduction_like_labels)
print("Working-ventricular labels:", working_vm_labels)

conduction_cells = np.concatenate([np.where(label_codes == label_to_idx[lbl])[0] for lbl in conduction_like_labels]) \
    if conduction_like_labels else np.array([], dtype=int)
working_cells = np.concatenate([np.where(label_codes == label_to_idx[lbl])[0] for lbl in working_vm_labels]) \
    if working_vm_labels else np.array([], dtype=int)

print("Total conduction-like cells:", conduction_cells.size)
print("Total working-ventricular cells:", working_cells.size)

# DE: conduction-like vs working-ventricular
de_H2_main = differential_expression(conduction_cells, working_cells,
                                     label_a="conduction_like", label_b="working_vm")

# Identify conduction-up genes: FDR < 0.05 and log2 FC > 0.25
up_H2_main = de_H2_main[(de_H2_main["fdr"] < 0.05) & (de_H2_main["log2_fc_conduction_like_vs_working_vm"] > 0.25)]
up_H2_main_sorted = up_H2_main.sort_values("log2_fc_conduction_like_vs_working_vm", ascending=False)
top_up_H2 = up_H2_main_sorted.head(15)

print("\nH2: number of significantly upregulated genes in conduction-like vs working-ventricular:", up_H2_main.shape[0])
print("Top 10 conduction-up genes (gene, log2FC, FDR):")
print(top_up_H2[["gene", "log2_fc_conduction_like_vs_working_vm", "fdr"]].head(10))

# Within conduction-like group: split by neighbor composition
neuronal_idx = label_to_idx.get("Neuronal", None)
fibro_indices = [label_to_idx[lbl] for lbl in ["aFibro", "adFibro", "vFibro"] if lbl in label_to_idx]

neighbors_conduction = neighbor_label_codes[conduction_cells]
has_neuron_or_fibro = np.any(
    (neighbors_conduction == neuronal_idx) if neuronal_idx is not None else False,
    axis=1
)
if fibro_indices:
    fibro_mask_any = np.any(np.isin(neighbors_conduction, fibro_indices), axis=1)
    has_neuron_or_fibro = has_neuron_or_fibro | fibro_mask_any

conduction_adjacent = conduction_cells[has_neuron_or_fibro]
conduction_nonadjacent = conduction_cells[~has_neuron_or_fibro]

print("Conduction-like cells with Neuronal/fibroblast neighbors:", conduction_adjacent.size)
print("Conduction-like cells without Neuronal/fibroblast neighbors:", conduction_nonadjacent.size)

# Restrict DE within conduction-like to genes up in conduction vs working
genes_of_interest_H2 = up_H2_main_sorted["gene"].tolist()
de_H2_within = differential_expression(conduction_adjacent, conduction_nonadjacent,
                                       label_a="cond_adjacent", label_b="cond_nonadjacent")
de_H2_within_sub = de_H2_within[de_H2_within["gene"].isin(genes_of_interest_H2)]
de_H2_within_sub_sorted = de_H2_within_sub.sort_values("log2_fc_cond_adjacent_vs_cond_nonadjacent", ascending=False)

print("\nH2: within conduction-like, DE for conduction-up genes (adjacent vs nonadjacent):")
print(de_H2_within_sub_sorted[["gene", "log2_fc_cond_adjacent_vs_cond_nonadjacent", "fdr"]].head(15))

# ---------- Run H3 test plan ----------
print("\n=== Testing H3 ===")
H3 = next(h for h in hypotheses if h["id"] == "H3")

WBC_idx = label_to_idx.get("WBC", None)
if WBC_idx is None:
    print("Label WBC not found in Populations!")
wbc_cells = np.where(label_codes == WBC_idx)[0]
print("Total WBC cells:", wbc_cells.size)

neighbors_wbc = neighbor_label_codes[wbc_cells]
# Niche-associated if at least one neighbor is adFibro or LEC
niche_mask = np.any(
    (neighbors_wbc == adFibro_idx) | (neighbors_wbc == LEC_idx),
    axis=1
)
wbc_niche = wbc_cells[niche_mask]
wbc_non_niche = wbc_cells[~niche_mask]

print("Niche-associated WBC cells:", wbc_niche.size)
print("Non-niche WBC cells:", wbc_non_niche.size)

de_H3 = differential_expression(wbc_niche, wbc_non_niche,
                                label_a="wbc_niche", label_b="wbc_non_niche")

# Up in niche: FDR < 0.05 and log2 FC > 0.25
up_H3 = de_H3[(de_H3["fdr"] < 0.05) & (de_H3["log2_fc_wbc_niche_vs_wbc_non_niche"] > 0.25)]
up_H3_sorted = up_H3.sort_values("log2_fc_wbc_niche_vs_wbc_non_niche", ascending=False)
top_up_H3 = up_H3_sorted.head(15)

print("\nH3: number of significantly upregulated genes in niche-associated vs non-niche WBC:", up_H3.shape[0])
print("Top 10 niche-up genes (gene, log2FC, FDR):")
print(top_up_H3[["gene", "log2_fc_wbc_niche_vs_wbc_non_niche", "fdr"]].head(10))

# ---------- Decide KEEP / REFINE / DROP and add narrowing_notes ----------
final_hypotheses = []

# H1 decision
if up_H1.shape[0] >= 5:
    decision_H1 = "KEEP"
    note_H1 = (
        f"H1 supported: interface adFibro (n={interface_adFibro.size}) vs non-interface adFibro "
        f"(n={non_interface_adFibro.size}) showed {up_H1.shape[0]} genes significantly upregulated "
        f"in the interface group at FDR<0.05 and log2FC>0.25. The top interface-enriched genes included "
        f"{', '.join(top_up_H1['gene'].head(5))}. Comparison against aFibro and vFibro indicated that many of "
        "these genes are also higher in interface adFibro than in other fibroblast types, consistent with a "
        "distinct interface-associated stromal program."
    )
    # Slightly strengthen statement but keep system-level
    H1["statement"] = (
        "Fibroblasts at lymphatic–epicardial interface regions, defined as adventitial fibroblast (adFibro) "
        "cells whose nearest spatial neighbors include lymphatic endothelial cells (LEC) or epicardial-derived "
        "cells (EPDC), exhibit a distinct, multi-gene extracellular-matrix and stromal-interaction expression "
        "program compared with adFibro cells lacking such neighbors and with other fibroblast populations."
    )
else:
    decision_H1 = "DROP"
    note_H1 = (
        f"H1 not supported: interface adFibro (n={interface_adFibro.size}) vs non-interface adFibro "
        f"(n={non_interface_adFibro.size}) yielded only {up_H1.shape[0]} interface-upregulated genes under "
        "FDR<0.05 and log2FC>0.25, insufficient evidence for a coherent interface-specific program."
    )

H1["narrowing_notes"] = {
    "decision": decision_H1,
    "details": note_H1
}
if decision_H1 in ["KEEP", "REFINE"]:
    final_hypotheses.append(H1)

# H2 decision
if up_H2_main.shape[0] >= 5:
    # Check if conduction-up genes are also biased within conduction-like (adjacent vs nonadjacent)
    n_modulated = (de_H2_within_sub["fdr"] < 0.05).sum()
    if n_modulated >= 5:
        decision_H2 = "KEEP"
        note_H2 = (
            f"H2 supported: conduction-like cardiomyocytes (n={conduction_cells.size}) vs working-ventricular "
            f"(n={working_cells.size}) showed {up_H2_main.shape[0]} significantly upregulated genes in the "
            "conduction-like group (FDR<0.05, log2FC>0.25), with top genes such as "
            f"{', '.join(top_up_H2['gene'].head(5))}. Within the conduction-like population, "
            f"{n_modulated} of these conduction-enriched genes were further upregulated in cells adjacent to "
            "Neuronal and/or fibroblast neighbors compared with conduction-like cells lacking such neighbors, "
            "indicating spatial modulation of the conduction-associated expression program."
        )
        H2["statement"] = (
            "Conduction-system–like cardiomyocytes, including ncCM-IFT-like, ncCM-AVC-like and His–Purkinje–like "
            "populations, express a distinct multi-gene transcriptional program relative to working ventricular "
            "cardiomyocytes, and this conduction-enriched program is further elevated in conduction-like cells "
            "that are spatially co-localized with neuronal and fibroblast neighbors."
        )
    else:
        decision_H2 = "REFINE"
        note_H2 = (
            f"H2 partially supported: conduction-like vs working-ventricular cardiomyocytes showed "
            f"{up_H2_main.shape[0]} conduction-upregulated genes (FDR<0.05, log2FC>0.25), but only "
            f"{n_modulated} of these genes were significantly modulated by the presence of Neuronal/fibroblast "
            "neighbors within the conduction-like group. This supports a distinct conduction-specific program, "
            "but with weaker evidence for strong spatial modulation by neighbor composition."
        )
        H2["statement"] = (
            "Conduction-system–like cardiomyocytes, including ncCM-IFT-like, ncCM-AVC-like and His–Purkinje–like "
            "populations, exhibit a distinct multi-gene transcriptional program relative to working ventricular "
            "cardiomyocytes, while spatial variation of this program with local neuronal and fibroblast neighbors "
            "is present but less pronounced."
        )
else:
    decision_H2 = "DROP"
    note_H2 = (
        f"H2 not supported: conduction-like vs working-ventricular cardiomyocytes showed only "
        f"{up_H2_main.shape[0]} conduction-upregulated genes under FDR<0.05 and log2FC>0.25, "
        "insufficient to define a robust conduction-specific module."
    )

H2["narrowing_notes"] = {
    "decision": decision_H2,
    "details": note_H2
}
if decision_H2 in ["KEEP", "REFINE"]:
    final_hypotheses.append(H2)

# H3 decision
if up_H3.shape[0] >= 5:
    decision_H3 = "KEEP"
    note_H3 = (
        f"H3 supported: niche-associated WBC (n={wbc_niche.size}) vs non-niche WBC (n={wbc_non_niche.size}) "
        f"showed {up_H3.shape[0]} significantly upregulated genes in the niche group (FDR<0.05, log2FC>0.25). "
        "Top niche-enriched genes included "
        f"{', '.join(top_up_H3['gene'].head(5))}, consistent with a coordinated activation program in "
        "fibroblast–lymphatic niches."
    )
    H3["statement"] = (
        "Immune cells (WBC) located in fibroblast–lymphatic niche regions, defined by spatial proximity to "
        "adventitial fibroblasts (adFibro) and lymphatic endothelial cells (LEC), display a multi-gene immune "
        "activation program that is upregulated relative to WBC residing outside such niches."
    )
else:
    decision_H3 = "DROP"
    note_H3 = (
        f"H3 not supported: niche-associated WBC (n={wbc_niche.size}) vs non-niche WBC (n={wbc_non_niche.size}) "
        f"yielded only {up_H3.shape[0]} upregulated genes in niche WBC at FDR<0.05 and log2FC>0.25, providing "
        "insufficient evidence for a coherent niche-specific activation program."
    )

H3["narrowing_notes"] = {
    "decision": decision_H3,
    "details": note_H3
}
if decision_H3 in ["KEEP", "REFINE"]:
    final_hypotheses.append(H3)

print("\nDecisions:")
for H in [H1, H2, H3]:
    print(H["id"], "->", H["narrowing_notes"]["decision"])

# ---------- Write final files ----------
hyp_final_path = Path(DATA_DIR) / "hypotheses" / "hypotheses.json"
with open(hyp_final_path, "w") as f:
    json.dump(final_hypotheses, f, indent=2)
print("\nFinal hypotheses written to:", hyp_final_path)

# Also write a brief human-readable summary
brief_path = Path(DATA_DIR) / "hypotheses" / "hypothesis_brief.md"

lines = []
lines.append("# Hypothesis brief — Farah developing human heart MERFISH\n")
lines.append(f"Total cells: {adata.n_obs}, genes: {adata.n_vars}, Populations labels: {len(label_names)}.\n")
lines.append(f"Phase 1 observations are logged in `exploration_log.md`.\n")

lines.append("## Retained hypotheses (KEEP/REFINE)\n")
for H in final_hypotheses:
    lines.append(f"### {H['id']}\n")
    lines.append(f"**Statement (narrowed):** {H['statement']}\n")
    lines.append(f"**Grounded in:** {', '.join(H['grounded_in'])}\n")
    lines.append(f"**Decision:** {H['narrowing_notes']['decision']}\n")
    lines.append(f"**Evidence summary:** {H['narrowing_notes']['details']}\n")
    qs = H.get("quality_scores", {})
    if qs:
        lines.append(
            "Quality scores — "
            f"Derivable: {qs.get('derivable','NA')}, "
            f"Novel: {qs.get('novel','NA')}, "
            f"Feasible: {qs.get('feasible','NA')}, "
            f"Specific: {qs.get('specific','NA')}, "
            f"Falsifiable: {qs.get('falsifiable','NA')}.\n"
        )

# Mention dropped hypotheses briefly
lines.append("## Dropped hypotheses\n")
for H in [H1, H2, H3]:
    if H["narrowing_notes"]["decision"] == "DROP":
        lines.append(f"- {H['id']}: {H['statement']} — dropped because {H['narrowing_notes']['details']}\n")

with open(brief_path, "w") as f:
    f.write("\n".join(lines))

print("Hypothesis brief written to:", brief_path)
