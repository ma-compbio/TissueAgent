<execute>
import numpy as np
import pandas as pd
from pathlib import Path
from sklearn.neighbors import NearestNeighbors

# Confirm basic structures again (idempotent if re-run)
print("AnnData shape:", adata.n_obs, "x", adata.n_vars)
print("obs columns:", adata.obs.columns.tolist())
print("obsm keys:", list(adata.obsm.keys()))
print("obsp keys:", list(adata.obsp.keys()) if hasattr(adata, "obsp") else "no .obsp")

# Inspect dataset_provenance in .uns if present
if "dataset_provenance" in adata.uns:
    print("\n.uns['dataset_provenance']:")
    print(adata.uns["dataset_provenance"])
else:
    print("\nNo 'dataset_provenance' in .uns")

# ---------- Set up exploration log ----------
exploration_log_path = Path(DATA_DIR) / "hypotheses" / "exploration_log.md"
print("\nWriting exploration log to:", exploration_log_path)

# Start a fresh log
with open(exploration_log_path, "w") as f:
    f.write("# Exploration log — Farah heart MERFISH\n\n")

# ---------- OBSERVATION 1: Dataset inventory ----------
n_cells = adata.n_obs
n_genes = adata.n_vars
genes_example = adata.var_names[:10].tolist()

pop_series = adata.obs["Populations"].astype("category")
pop_counts = pop_series.value_counts()
n_pop = pop_counts.shape[0]

sample_counts = adata.obs["Sample_ID"].value_counts()
n_samples = sample_counts.shape[0]

coords = adata.obsm["spatial"]
x_min, y_min = coords.min(axis=0)
x_max, y_max = coords.max(axis=0)

obs1_lines = []
obs1_lines.append("OBSERVATION 1:")
obs1_lines.append(
    f"The MERFISH developing human heart dataset contains {n_cells} cells and {n_genes} genes."
)
obs1_lines.append(
    f"The 'Populations' column has {n_pop} cell-type / subtype categories; "
    f"the 10 most abundant are: "
)
top10 = pop_counts.head(10)
for name, count in top10.items():
    frac = count / n_cells
    obs1_lines.append(f"- {name}: {count} cells ({frac:.3%} of all cells)")
obs1_lines.append(
    f"There are {n_samples} samples/sections (Sample_ID): " +
    ", ".join([f"{idx} ({cnt} cells)" for idx, cnt in sample_counts.items()])
)
obs1_lines.append(
    f"Spatial coordinates in `.obsm['spatial']` have shape {coords.shape} with "
    f"x ranging from {x_min:.1f} to {x_max:.1f} and y from {y_min:.1f} to {y_max:.1f}."
)
obs1_lines.append(
    "Example gene symbols in the panel include: " + ", ".join(genes_example) + "."
)
obs1_text = "\n".join(obs1_lines) + "\n\n"

with open(exploration_log_path, "a") as f:
    f.write(obs1_text)

print("\n=== OBSERVATION 1 logged ===")
print(obs1_text)

# ---------- Build spatial k-NN graph ----------
print("Building spatial k-NN graph on `.obsm['spatial']`...")
coords = np.asarray(adata.obsm["spatial"], dtype=float)
n_neighbors = 15  # total including self
nn = NearestNeighbors(n_neighbors=n_neighbors, algorithm="kd_tree", n_jobs=-1)
nn.fit(coords)
nn_indices = nn.kneighbors(coords, return_distance=False)
print("k-NN indices shape:", nn_indices.shape)

# Exclude self-neighbor at column 0; work with k_eff neighbors
neighbor_idx = nn_indices[:, 1:]
k_eff = neighbor_idx.shape[1]
print("Using", k_eff, "non-self nearest neighbors per cell.")

# Label encoding
pop_cat = pop_series.cat
label_names = list(pop_cat.categories)
label_codes = pop_cat.codes.to_numpy()
n_labels = len(label_names)
print("Number of Populations labels:", n_labels)

neighbor_label_codes = label_codes[neighbor_idx]

# Per-cell same-label neighbor fraction
same_label_counts = (neighbor_label_codes == label_codes[:, None]).sum(axis=1)
same_label_frac = same_label_counts / k_eff

# Global label stats
label_counts = np.bincount(label_codes, minlength=n_labels)
global_freq = label_counts / n_cells

# ---------- OBSERVATION 2: Rare-but-tight concentration ranking ----------
rows = []
for li, name in enumerate(label_names):
    n_li = int(label_counts[li])
    if n_li == 0:
        continue
    mask = (label_codes == li)
    mean_same = float(same_label_frac[mask].mean())
    gfreq = float(global_freq[li])
    ratio = mean_same / gfreq if gfreq > 0 else np.nan
    rows.append({
        "label": name,
        "idx": li,
        "n_cells": n_li,
        "global_freq": gfreq,
        "mean_same_label_frac": mean_same,
        "clustering_enrichment": ratio,
    })

concentration_df = pd.DataFrame(rows).sort_values("clustering_enrichment", ascending=False)

# For stability, highlight top 5 labels with at least 500 cells
stable_df = concentration_df[concentration_df["n_cells"] >= 500]
top5_conc = stable_df.head(5)

obs2_lines = []
obs2_lines.append("OBSERVATION 2:")
obs2_lines.append(
    "Spatial concentration of each 'Populations' label was quantified using a "
    "same-label neighbor fraction (mean fraction of the 14 nearest non-self neighbors "
    "sharing the same label) divided by that label's global frequency."
)
obs2_lines.append(
    f"Across all {n_labels} labels, the 5 most spatially concentrated (restricted to labels with ≥500 cells) are:"
)
for _, row in top5_conc.iterrows():
    obs2_lines.append(
        f"- {row['label']}: {row['n_cells']} cells (global frequency {row['global_freq']:.3%}), "
        f"mean same-label neighbor fraction {row['mean_same_label_frac']:.3f}, "
        f"clustering enrichment index {row['clustering_enrichment']:.2f}."
    )
obs2_lines.append(
    "Across all labels (no minimum size filter), the median clustering enrichment index is "
    f"{concentration_df['clustering_enrichment'].median():.2f}, and the maximum is "
    f"{concentration_df['clustering_enrichment'].max():.2f}."
)
obs2_text = "\n".join(obs2_lines) + "\n\n"

with open(exploration_log_path, "a") as f:
    f.write(obs2_text)

print("\n=== OBSERVATION 2 logged ===")
print(obs2_text)

# ---------- OBSERVATION 3: Neighbor enrichment for rare-but-tight labels ----------
# Use the same top5_conc as the rare-but-tight set
obs3_lines = []
obs3_lines.append("OBSERVATION 3:")
obs3_lines.append(
    "For each of the 5 most spatially concentrated 'Populations' labels from OBSERVATION 2, "
    "non-self neighbor composition was quantified by pooling the 14 nearest non-self neighbors "
    "around all cells of that label and comparing to global label frequencies."
)

for _, row in top5_conc.iterrows():
    li = int(row["idx"])
    label_name = row["label"]
    mask = (label_codes == li)
    neigh_codes_L = neighbor_label_codes[mask].ravel()
    nonself_mask = (neigh_codes_L != li)
    neigh_codes_nonself = neigh_codes_L[nonself_mask]
    total_nonself = int(neigh_codes_nonself.size)
    if total_nonself == 0:
        continue
    counts_L = np.bincount(neigh_codes_nonself, minlength=n_labels)
    obs_frac = counts_L / total_nonself
    enrich = obs_frac / global_freq
    # exclude self just in case
    enrich[li] = 0.0

    # Build table, filter labels with at least some minimal neighbor count
    df_L = pd.DataFrame({
        "neighbor_label": label_names,
        "neighbor_idx": np.arange(n_labels),
        "neighbor_count": counts_L,
        "neighbor_fraction": obs_frac,
        "expected_fraction": global_freq,
        "enrichment": enrich,
    })
    df_L = df_L[df_L["neighbor_count"] > 0]
    top3_neighbors = df_L.sort_values("enrichment", ascending=False).head(3)

    obs3_lines.append(
        f"For focal label {label_name} (n={row['n_cells']} cells, clustering enrichment {row['clustering_enrichment']:.2f}), "
        f"there are {total_nonself} pooled non-self neighbor positions."
    )
    for _, nr in top3_neighbors.iterrows():
        obs3_lines.append(
            f"- Neighbor {nr['neighbor_label']}: {int(nr['neighbor_count'])} occurrences "
            f"({nr['neighbor_fraction']:.3%} of non-self neighbors) vs global frequency "
            f"{nr['expected_fraction']:.3%}, enrichment {nr['enrichment']:.2f}."
        )

obs3_text = "\n".join(obs3_lines) + "\n\n"
with open(exploration_log_path, "a") as f:
    f.write(obs3_text)

print("\n=== OBSERVATION 3 logged ===")
print(obs3_text)

# ---------- OBSERVATION 4: Global pairwise co-localization ----------
neighbor_counts_matrix = np.zeros((n_labels, n_labels), dtype=np.int64)
for li in range(n_labels):
    mask = (label_codes == li)
    if not np.any(mask):
        continue
    neigh_codes_i = neighbor_label_codes[mask].ravel()
    counts_i = np.bincount(neigh_codes_i, minlength=n_labels)
    neighbor_counts_matrix[li, :] = counts_i

pair_rows = []
for li in range(n_labels):
    total_from_li = neighbor_counts_matrix[li, :].sum()
    if total_from_li == 0:
        continue
    obs_frac_i = neighbor_counts_matrix[li, :] / total_from_li
    enrich_i = obs_frac_i / global_freq
    for lj in range(n_labels):
        if li == lj:
            continue
        count_ij = neighbor_counts_matrix[li, lj]
        if count_ij < 100:  # stability filter
            continue
        pair_rows.append({
            "source_label": label_names[li],
            "target_label": label_names[lj],
            "count": int(count_ij),
            "obs_fraction": float(obs_frac_i[lj]),
            "expected_fraction": float(global_freq[lj]),
            "enrichment": float(enrich_i[lj]),
        })

pair_df = pd.DataFrame(pair_rows)
if not pair_df.empty:
    top_pairs = pair_df.sort_values("enrichment", ascending=False).head(10)
else:
    top_pairs = pd.DataFrame(columns=["source_label","target_label","count","obs_fraction","expected_fraction","enrichment"])

obs4_lines = []
obs4_lines.append("OBSERVATION 4:")
obs4_lines.append(
    "Pairwise cell-type co-localization was profiled by counting, for each 'Populations' label, "
    "the labels of all 14 nearest non-self neighbors and comparing these neighbor label fractions "
    "to global label frequencies. Only source–target pairs with at least 100 neighbor occurrences "
    "were considered."
)
if not top_pairs.empty:
    obs4_lines.append("The 10 most enriched directed source–target neighbor pairs (by observed/expected ratio) are:")
    for _, pr in top_pairs.iterrows():
        obs4_lines.append(
            f"- {pr['source_label']} → {pr['target_label']}: "
            f"{pr['count']} neighbor occurrences, observed neighbor fraction {pr['obs_fraction']:.3%} "
            f"vs global frequency {pr['expected_fraction']:.3%}, enrichment {pr['enrichment']:.2f}."
        )
else:
    obs4_lines.append("No source–target pairs met the minimum of 100 neighbor occurrences for this analysis.")

obs4_text = "\n".join(obs4_lines) + "\n\n"
with open(exploration_log_path, "a") as f:
    f.write(obs4_text)

print("\n=== OBSERVATION 4 logged ===")
print(obs4_text)

# Count how many OBSERVATION entries are in the log
with open(exploration_log_path, "r") as f:
    log_text = f.read()
num_observations = log_text.count("OBSERVATION ")
print(f"\nTotal OBSERVATION entries logged: {num_observations}")
</execute>

