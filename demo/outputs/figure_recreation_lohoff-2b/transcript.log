  1. {'name': 'write_file', 'args': {'file_path': '/project/outputs/scripts/inspect_inputs.py', 'content': "#!/usr/bin/env python3\nimport json, os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\nimport anndata as ad\n\nh5 = Path('library/datasets/dataset_lohoff_et_al_seqfish.h5ad')\nfig = Path('project/uploads/Fig2b.jpg')\nprint('paths_exist', h5.exists(), fig.exists())\nimg = Image.open(fig).convert('RGB')\nprint('target_size', img.size)\n# rough non-white bbox\narr=np.asarray(img)\nmask=np.any(arr<245, axis=2)\nys,xs=np.where(mask)\nprint('target_nonwhite_bbox', (int(xs.min()), int(ys.min()), int(xs.max()+1), int(ys.max()+1)), 'nonwhite_px', int(mask.sum()))\n# component-ish coarse: left plot vs legend by x split\nfor name, box in [('tissue_main',(0,0,295,420)),('legend',(295,0,img.width,img.height)),('bottom_extra',(0,420,120,img.height))]:\n    x0,y0,x1,y1=box\n    m=mask[y0:y1,x0:x1]\n    if m.any():\n        yy,xx=np.where(m); print(name+'_bbox_rel', (int(xx.min()+x0),int(yy.min()+y0),int(xx.max()+x0+1),int(yy.max()+y0+1)), 'nonwhite', int(m.sum()))\n    else:\n        print(name+'_bbox_rel', None)\n\nadata = ad.read_h5ad(h5, backed='r')\nprint('adata_shape', adata.shape)\nprint('obs_columns', list(map(str, adata.obs.columns)))\nprint('obsm_keys', list(adata.obsm.keys()))\nprint('layers', list(adata.layers.keys()))\nprint('uns_keys', list(adata.uns.keys()))\nfor k in adata.obsm.keys():\n    try:\n        arrk = adata.obsm[k]\n        print('obsm', k, 'shape', getattr(arrk,'shape',None), 'dtype', getattr(arrk,'dtype',None), 'first3', np.asarray(arrk[:3]).tolist())\n    except Exception as e:\n        print('obsm', k, 'ERR', repr(e))\nfor col in adata.obs.columns:\n    s=adata.obs[col]\n    dtype=str(s.dtype)\n    nunique=s.nunique(dropna=True)\n    if dtype=='category' or nunique<=60 or any(t in col.lower() for t in ['cell','type','annotation','cluster','batch','embryo','slice']):\n        vals=list(s.dropna().unique()[:30])\n        print('obs_col', col, 'dtype', dtype, 'nunique', int(nunique), 'values_first', [str(v) for v in vals])\n        if dtype=='category':\n            print('  categories', [str(c) for c in s.cat.categories])\nfor key in adata.uns.keys():\n    if 'color' in str(key).lower() or 'cell' in str(key).lower() or 'type' in str(key).lower():\n        try:\n            v=adata.uns[key]\n            if isinstance(v, np.ndarray):\n                vv=v.tolist()\n            else:\n                vv=v\n            print('uns_candidate', key, type(v).__name__, str(vv)[:1000])\n        except Exception as e:\n            print('uns_candidate', key, 'ERR', repr(e))\nadata.file.close()\n"}, 'id': 'call_Ww5cO2KbI0RO96LqbVLo5Q40', 'type': 'tool_call'}

