  1  #!/usr/bin/env python3
  2  """extract_reference_spec.py -- read the target figure's *symbolic* spec before plotting.
  3  
  4  Part of the 'figure-reproduce' skill. Portable and self-contained: it imports NO
  5  project package. numpy + Pillow are the only hard requirements; pytesseract (OCR)
  6  and matplotlib (colormap matching) are optional and degrade with an install hint.
  7  
  8  WHY THIS EXISTS
  9      Color, category order, and on-panel text are *discrete, symbolic* properties,
 10      but a vision model reads them out of a downsampled raster and guesses: it names
 11      a color ("blue") instead of measuring it, scrambles which category maps to which
 12      swatch, and paraphrases axis labels. Those three failure modes are invisible to
 13      SSIM/pHash/ORB (all grayscale), so nothing downstream catches them.
 14  
 15      This script measures them from pixels instead:
 16        * legend swatches -> ORDERED [(label, #hex)] ... palette + binding + order
 17        * axis tick strips -> ORDERED tick labels     ... row/column/bar order
 18        * colorbar strip   -> best-matching cmap name ... including "_r" reversal
 19  
 20      The emitted YAML is meant to be treated as ground truth by the plotting code:
 21      take `palette`, `order`, and label text FROM IT rather than from library
 22      defaults or from eyeballing the image.
 23  
 24  USAGE
 25      python extract_reference_spec.py TARGET_IMAGE [-o spec.yaml] [--json]
 26                                       [--legend-box x0,y0,x1,y1]
 27                                       [--colorbar-box x0,y0,x1,y1]
 28                                       [--xtick-box x0,y0,x1,y1]
 29                                       [--ytick-box x0,y0,x1,y1]
 30                                       [--max-colors N] [--debug-crops DIR]
 31  
 32      Boxes are pixel coordinates on the *target* image. All are optional: with none
 33      given the script auto-detects a legend region and reports what it found. Auto-
 34      detection is a heuristic -- when a crop looks wrong, pass the box explicitly
 35      (use --debug-crops to see exactly what was read).
 36  
 37  EXAMPLES
 38      python extract_reference_spec.py fig2b.png -o spec.yaml
 39      python extract_reference_spec.py fig2b.png --legend-box 820,60,1000,400 -o spec.yaml
 40      python extract_reference_spec.py heat.png --colorbar-box 900,100,930,500 --json
 41  """
 42  
 43  from __future__ import annotations
 44  
 45  import argparse
 46  import json
 47  import os
 48  import sys
 49  
 50  try:
 51      import numpy as np
 52      from PIL import Image
 53  except ImportError as exc:  # pragma: no cover - hard requirement
 54      sys.stderr.write(
 55          f"FATAL: this script needs numpy and Pillow ({exc}). "
 56          "Install with: pip install numpy Pillow\n"
 57      )
 58      sys.exit(2)
 59  
 60  
 61  # Pixels this close to white/black are chrome (background, axes, text), not data.
 62  WHITE_CUT = 242
 63  BLACK_CUT = 28
 64  # A swatch candidate must be at least this saturated OR this far from gray.
 65  MIN_CHROMA = 18
 66  # Colormaps papers actually use, in rough order of frequency. Both directions are
 67  # tested, so listing the base name also covers its "_r" reverse.
 68  CMAP_CANDIDATES = (
 69      "viridis", "magma", "inferno", "plasma", "cividis",
 70      "RdBu", "coolwarm", "bwr", "seismic", "Spectral", "RdYlBu",
 71      "Reds", "Blues", "Greens", "Purples", "Oranges", "Greys",
 72      "YlOrRd", "YlGnBu", "BuPu", "GnBu", "OrRd", "PuBu",
 73      "jet", "rainbow", "turbo", "hot", "afmhot", "gray",
 74  )
 75  
 76  
 77  def hint(pkg: str) -> str:
 78      """One-line install hint for a missing optional dependency."""
 79      return f"[degraded] optional dependency '{pkg}' not installed - try: pip install {pkg}"
 80  
 81  
 82  # --------------------------------------------------------------------------- #
 83  # Color helpers -- comparisons happen in CIELAB, never in RGB
 84  # --------------------------------------------------------------------------- #
 85  def to_hex(rgb) -> str:
 86      r, g, b = (int(round(float(v))) for v in rgb[:3])
 87      return "#%02x%02x%02x" % (max(0, min(255, r)), max(0, min(255, g)), max(0, min(255, b)))
 88  
 89  
 90  def srgb_to_lab(rgb: np.ndarray) -> np.ndarray:
 91      """sRGB [0,255] -> CIELAB (D65). Accepts (...,3); returns the same leading shape.
 92  
 93      RGB distance correlates poorly with 'looks wrong' -- two colors 30 apart in RGB
 94      can be indistinguishable or obviously different depending where they sit. LAB is
 95      roughly perceptually uniform, so a single dE threshold means the same thing
 96      everywhere in the space.
 97      """
 98      arr = np.asarray(rgb, dtype=np.float64).reshape(-1, 3) / 255.0
 99      # inverse sRGB companding
100      lin = np.where(arr <= 0.04045, arr / 12.92, ((arr + 0.055) / 1.055) ** 2.4)
101      m = np.array([
102          [0.4124564, 0.3575761, 0.1804375],
103          [0.2126729, 0.7151522, 0.0721750],
104          [0.0193339, 0.1191920, 0.9503041],
105      ])
106      xyz = lin @ m.T
107      white = np.array([0.95047, 1.00000, 1.08883])
108      t = xyz / white
109      d = 6.0 / 29.0
110      f = np.where(t > d ** 3, np.cbrt(t), t / (3 * d * d) + 4.0 / 29.0)
111      lab = np.stack([
112          116.0 * f[:, 1] - 16.0,
113          500.0 * (f[:, 0] - f[:, 1]),
114          200.0 * (f[:, 1] - f[:, 2]),
115      ], axis=1)
116      return lab.reshape(np.asarray(rgb).shape)
117  
118  
119  def delta_e(a, b) -> float:
120      """CIE76 dE between two sRGB triples. ~2.3 = just-noticeable difference."""
121      la, lb = srgb_to_lab(np.asarray(a, float)), srgb_to_lab(np.asarray(b, float))
122      return float(np.sqrt(np.sum((la - lb) ** 2)))
123  
124  
125  def is_chrome(px: np.ndarray) -> np.ndarray:
126      """Boolean mask of 'not data' pixels: near-white, near-black, or near-gray."""
127      mx, mn = px.max(axis=-1), px.min(axis=-1)
128      chroma = mx.astype(np.int16) - mn.astype(np.int16)
129      return (mn > WHITE_CUT) | (mx < BLACK_CUT) | (chroma < MIN_CHROMA)
130  
131  
132  # --------------------------------------------------------------------------- #
133  # Palette extraction
134  # --------------------------------------------------------------------------- #
135  def quantize_colors(px: np.ndarray, max_colors: int = 16, min_share: float = 0.004):
136      """Return [(hex, share, rgb)] of dominant non-chrome colors, most common first.
137  
138      Two-stage. An exact-value histogram alone only works on flat-rendered vector
139      output: a JPEG-compressed scatter of small anti-aliased markers can have ~as many
140      distinct RGBs as it has data pixels (measured: 59k colors over 72k pixels), so
141      every individual share falls under min_share and nothing survives. So:
142  
143        1. exact-value histogram -- cheap, and exact on flat/vector figures;
144        2. if that yields little, cluster the pixels in CIELAB and use the cluster
145           centroids, which is robust to compression noise and anti-aliasing.
146  
147      Stage 2 reports the centroid nearest an actual observed pixel rather than the raw
148      mean, so the returned hex is a color that genuinely appears in the figure.
149      """
150      flat = px.reshape(-1, 3)
151      keep = ~is_chrome(flat)
152      data = flat[keep]
153      if data.size == 0:
154          return []
155  
156      # ---- stage 1: exact-value histogram (flat / vector figures) ----
157      packed = (data[:, 0].astype(np.uint32) << 16) | (data[:, 1].astype(np.uint32) << 8) | data[:, 2]
158      vals, counts = np.unique(packed, return_counts=True)
159      order = np.argsort(-counts)
160      total = float(counts.sum())
161  
162      out: list[tuple[str, float, tuple[int, int, int]]] = []
163      for i in order:
164          if len(out) >= max_colors:
165              break
166          share = counts[i] / total
167          if share < min_share:
168              break
169          v = int(vals[i])
170          rgb = ((v >> 16) & 255, (v >> 8) & 255, v & 255)
171          # merge into an existing entry if perceptually the same color (anti-aliasing)
172          if any(delta_e(rgb, prev) < 6.0 for _, _, prev in out):
173              continue
174          out.append((to_hex(rgb), round(share, 5), rgb))
175  
176      # A well-quantized figure gives several colors covering most of the ink. If the
177      # histogram is that diffuse, the image is compressed/anti-aliased -> cluster.
178      if sum(s for _, s, _ in out) >= 0.25 and len(out) >= 2:
179          return out
180      return _cluster_colors_lab(data, max_colors=max_colors, min_share=min_share)
181  
182  
183  def _cluster_colors_lab(data: np.ndarray, max_colors: int = 16, min_share: float = 0.004,
184                          iters: int = 12, sample_cap: int = 60000):
185      """k-means in CIELAB over non-chrome pixels -> [(hex, share, rgb)].
186  
187      Plain numpy (no sklearn dependency), seeded deterministically by k-means++ style
188      farthest-point selection so repeated runs on the same figure agree -- a spec that
189      changed between runs would be useless as ground truth.
190      """
191      if len(data) == 0:
192          return []
193      # deterministic subsample for speed on large panels
194      if len(data) > sample_cap:
195          step = len(data) // sample_cap + 1
196          sample = data[::step]
197      else:
198          sample = data
199      lab = srgb_to_lab(sample.astype(np.float64))
200      k = int(max(2, min(max_colors, len(np.unique(sample, axis=0)))))
201  
202      # farthest-point init (deterministic: always start from the darkest pixel)
203      centers = [lab[np.argmin(lab[:, 0])]]
204      for _ in range(k - 1):
205          d = np.min(np.stack([np.sum((lab - c) ** 2, axis=1) for c in centers]), axis=0)
206          centers.append(lab[int(np.argmax(d))])
207      C = np.stack(centers)
208  
209      assign = np.zeros(len(lab), dtype=np.int64)
210      for _ in range(iters):
211          d2 = ((lab[:, None, :] - C[None, :, :]) ** 2).sum(axis=2)
212          new = d2.argmin(axis=1)
213          if np.array_equal(new, assign):
214              break
215          assign = new
216          for j in range(len(C)):
217              m = assign == j
218              if m.any():
219                  C[j] = lab[m].mean(axis=0)
220  

