[2] (function_call) {'type': 'function_call', 'name': 'write_file', 'arguments': '{"file_path":"/project/outputs/scripts/render_fig2b.py","content":"#!/usr/bin/env python3\\n\\"\\"\\"Render Lohoff et al. seqFISH Fig. 2b spatial cell-type scatter reproduction.\\"\\"\\"\\nfrom __future__ import annotations\\nimport argparse\\nfrom pathlib import Path\\nimport re\\nimport numpy as np\\nimport pandas as pd\\nimport anndata as ad\\nimport matplotlib\\nmatplotlib.use(\'Agg\')\\nimport matplotlib.pyplot as plt\\nfrom matplotlib.lines import Line2D\\nfrom matplotlib import transforms\\n\\nDATA = Path(\'library/datasets/dataset_lohoff_et_al_seqfish.h5ad\')\\nOUT = Path(\'project/outputs\')\\nFIG = OUT/\'figures\'\\nTAB = OUT/\'tables\'\\n\\n# Reference legend order/text from project/uploads/Fig2b.jpg measured/read from target.\\nTARGET_LEGEND = [\\n    (\'Allantois\', \'Allantois\'),\\n    (\'Anterior somitic tissues\', \'Anterior somitic tissues\'),\\n    (None, \'Blood progenitors\'),\\n    (\'Cardiomyocytes\', \'Cardiomyocytes\'),\\n    (None, \'Caudal mesoderm\'),\\n    (\'Cranial mesoderm\', \'Cranial mesoderm\'),\\n    (\'Definitive endoderm\', \'Definitive endoderm\'),\\n    (\'Dermomyotome\', \'Dermomyotome\'),\\n    (\'Endothelium\', \'Endothelium\'),\\n    (\'Erythroid\', \'Erythroid\'),\\n    (None, \'ExE endoderm\'),\\n    (\'Forebrain/Midbrain/Hindbrain\', \'Forebrain/midbrain/hindbrain\'),\\n    (\'Gut tube\', \'Gut tube\'),\\n    (\'Haematoendothelial progenitors\', \'Hematoendothelial progenitors\'),\\n    (\'Intermediate mesoderm\', \'Intermediate mesoderm\'),\\n    (\'Lateral plate mesoderm\', \'Lateral plate mesoderm\'),\\n    (\'Mixed mesenchymal mesoderm\', \'Mixed mesenchymal mesoderm\'),\\n    (\'Neural crest\', \'Neural crest\'),\\n    (\'NMP\', \'NMP\'),\\n    (\'Presomitic mesoderm\', \'Presomitic mesoderm\'),\\n    (\'Sclerotome\', \'Sclerotome\'),\\n    (\'Spinal cord\', \'Spinal cord\'),\\n    (\'Splanchnic mesoderm\', \'Splanchnic mesoderm\'),\\n    (\'Surface ectoderm\', \'Surface ectoderm\'),\\n]\\n# Extra legend entries visible in the reference but absent from this AnnData object.\\n# Colors are measured from swatch pixels in project/uploads/Fig2b.jpg.\\nREFERENCE_ONLY_COLORS = {\\n    \'Blood progenitors\': \'#eeded2\',\\n    \'Caudal mesoderm\': \'#6482a4\',\\n    \'ExE endoderm\': \'#766770\',\\n}\\n\\n\\ndef read_colormap(path: Path) -> dict[str, str]:\\n    mapping = {}\\n    for line in path.read_text().splitlines():\\n        s = line.strip()\\n        if not s or s.startswith(\'#\') or \':\' not in s:\\n            continue\\n        k, v = s.split(\':\', 1)\\n        v = v.strip().strip(\'\\"\').strip(\\"\'\\")\\n        if re.match(r\'^#[0-9A-Fa-f]{6}$\', v):\\n            mapping[k.strip()] = v\\n    return mapping\\n\\n\\ndef add_reference_annotations(fig):\\n    # panel label\\n    fig.text(17/592, 0.992, \'b\', ha=\'left\', va=\'top\', fontsize=14, fontweight=\'bold\', family=\'DejaVu Sans\')\\n    # scale bar matching reference placement (annotation only; source coordinates are normalized)\\n    y_bar = 1 - 345/784\\n    x0, x1 = 223/592, 276/592\\n    fig.add_artist(Line2D([x0, x1], [y_bar, y_bar], transform=fig.transFigure,\\n                          color=\'black\', lw=4, solid_capstyle=\'butt\'))\\n    fig.text((x0+x1)/2, 1 - 332/784, \'250 µm\', ha=\'center\', va=\'bottom\', fontsize=11, color=\'black\')\\n    # orientation compass visible in the provided reference crop\\n    cx, cy = 74/592, 724/784  # in image pixels from top; convert y below\\n    cx_fig, cy_fig = cx, 1 - cy\\n    dx, dy = 20/592, 22/784\\n    fig.add_artist(Line2D([cx_fig-dx, cx_fig+dx], [cy_fig, cy_fig], transform=fig.transFigure,\\n                          color=\'black\', lw=1.6, solid_capstyle=\'butt\'))\\n    fig.add_artist(Line2D([cx_fig, cx_fig], [cy_fig-dy, cy_fig+dy], transform=fig.transFigure,\\n                          color=\'black\', lw=1.6, solid_capstyle=\'butt\'))\\n    fig.text(cx_fig, cy_fig+dy+0.006, \'A\', ha=\'center\', va=\'bottom\', fontsize=11)\\n    fig.text(cx_fig, cy_fig-dy-0.006, \'P\', ha=\'center\', va=\'top\', fontsize=11)\\n    fig.text(cx_fig-dx-0.008, cy_fig, \'D\', ha=\'right\', va=\'center\', fontsize=11)\\n    fig.text(cx_fig+dx+0.008, cy_fig, \'V\', ha=\'left\', va=\'center\', fontsize=11)\\n\\n\\ndef render(attempt: int, scatter_size: float, alpha: float, axes_box: tuple[float,float,float,float], xpad: float, ypad: float, include_compass_scale=True):\\n    FIG.mkdir(parents=True, exist_ok=True)\\n    TAB.mkdir(parents=True, exist_ok=True)\\n    palette = read_colormap(TAB/\'colormap.yaml\')\\n    adata = ad.read_h5ad(DATA)\\n    xy = np.asarray(adata.obsm[\'spatial\'])\\n    ct = adata.obs[\'celltype_mapped_refined\'].astype(str).to_numpy()\\n    df = pd.DataFrame({\'x\': xy[:,0], \'y\': xy[:,1], \'celltype\': ct})\\n    # The supplied reference legend contains no \\"Low quality\\" class; exclude it from the panel.\\n    plotted = df[df[\'celltype\'] != \'Low quality\'].copy()\\n    missing = sorted(set(plotted[\'celltype\']) - set(palette))\\n    assert not missing, f\\"no resolved colour for: {missing}\\"\\n    plotted[\'color\'] = plotted[\'celltype\'].map(palette)\\n    plotted.to_csv(TAB/f\'fig2b_spatial_scatter_plot_data_attempt{attempt}.csv\', index=False)\\n\\n    # Match provided target raster canvas (592 x 784 px) exactly at 100 dpi.\\n    fig = plt.figure(figsize=(5.92, 7.84), dpi=100, facecolor=\'white\')\\n    ax = fig.add_axes(axes_box, facecolor=\'white\')\\n\\n    # Draw in target legend order where available, so overlaps resemble the reference.\\n    ordered_cats = [cat for cat, lab in TARGET_LEGEND if cat in palette]\\n    extras = [c for c in plotted[\'celltype\'].unique() if c not in ordered_cats]\\n    for cat in ordered_cats + sorted(extras):\\n        sub = plotted[plotted[\'celltype\'] == cat]\\n        if len(sub):\\n            ax.scatter(sub[\'x\'], sub[\'y\'], s=scatter_size, c=palette[cat], marker=\'o\',\\n                       linewidths=0, alpha=alpha, rasterized=True)\\n    xmin, xmax = plotted[\'x\'].min(), plotted[\'x\'].max()\\n    ymin, ymax = plotted[\'y\'].min(), plotted[\'y\'].max()\\n    ax.set_xlim(xmin-xpad, xmax+xpad)\\n    ax.set_ylim(ymin-ypad, ymax+ypad)\\n    ax.invert_yaxis()\\n    ax.set_aspect(\'equal\', adjustable=\'box\')\\n    ax.set_axis_off()\\n\\n    # Legend: target order/text, including reference-only classes as empty legend entries.\\n    handles, labels = [], []\\n    for cat, label in TARGET_LEGEND:\\n        color = palette.get(cat) if cat is not None else REFERENCE_ONLY_COLORS[label]\\n        handles.append(Line2D([0], [0], marker=\'o\', linestyle=\'None\', markersize=17,\\n                              markerfacecolor=color, markeredgecolor=\'none\'))\\n        labels.append(label)\\n    fig.legend(handles, labels, loc=\'upper left\', bbox_to_anchor=(0.505, 0.965),\\n               frameon=False, borderaxespad=0, handlelength=1.0, handletextpad=0.55,\\n               labelspacing=0.62, fontsize=12)\\n    if include_compass_scale:\\n        add_reference_annotations(fig)\\n\\n    png = FIG/f\'fig2b_spatial_scatter_attempt{attempt}.png\'\\n    pdf = FIG/f\'fig2b_spatial_scatter_attempt{attempt}.pdf\'\\n    fig.savefig(png, dpi=100, facecolor=\'white\')\\n    fig.savefig(pdf, facecolor=\'white\')\\n    plt.close(fig)\\n    print(f\'wrote {png} and {pdf}\')\\n    print(f\'plotted cells: {len(plotted)} (excluded Low quality: {(df.celltype == \\"Low quality\\").sum()})\')\\n    print(f\'coordinate range x=({xmin:.3f},{xmax:.3f}) y=({ymin:.3f},{ymax:.3f}); inverted y-axis\')\\n\\n\\nif __name__ == \'__main__\':\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\'--attempt\', type=int, required=True)\\n    ap.add_argument(\'--scatter-size\', type=float, default=2.0)\\n    ap.add_argument(\'--alpha\', type=float, default=1.0)\\n    ap.add_argument(\'--axes-box\', default=\'0.030,0.542,0.441,0.435\', help=\'left,bottom,width,height in figure fraction\')\\n    ap.add_argument(\'--xpad\', type=float, default=0.08)\\n    ap.add_argument(\'--ypad\', type=float, default=0.08)\\n    args = ap.parse_args()\\n    render(args.attempt, args.scatter_size, args.alpha, tuple(map(float,args.axes_box.split(\',\'))), args.xpad, args.ypad)\\n"}', 'call_id': 'call_IO48217cFg34qWjNAjOfDkWP', 'id': 'fc_024bb976f67ed26d006aa44a44efc487d29c92d32089c08ef5', 'index': 1}
