  1  #!/usr/bin/env python3
  2  """compare_figures.py -- fidelity self-evaluation for the 'figure-reproduce' skill.
  3  
  4  WHAT IT DOES
  5      Compares a reproduced figure against the target (original) figure and returns a
  6      similarity verdict. This is the numeric feedback that drives the agent's
  7      reflect-and-retry loop: if the reproduction is far from the target, the agent
  8      should inspect *why* and try again.
  9  
 10      Metrics computed (each degrades gracefully if an optional dep is missing):
 11        * pHash Hamming distance  -- perceptual hash difference (0 = identical layout).
 12        * SSIM                     -- structural similarity on 512x512 grayscale (0..1).
 13        * ORB good-match count     -- number of robust keypoint matches (higher = better).
 14        * Palette dE               -- CIELAB distance between the two palettes (color).
 15        * Text diff                -- OCR'd on-panel strings present/missing/near-miss.
 16        * B-level prior            -- a coarse B1..B5 bucket, floored by ALL of the above.
 17  
 18      WHY THE COLOR/TEXT METRICS EXIST
 19          pHash, SSIM and ORB are all computed on GRAYSCALE, so they are blind to the
 20          three most common reproduction errors: a wrong palette, a wrong category
 21          order, and paraphrased axis/legend text. A figure with the wrong colormap and
 22          rewritten labels can score SSIM 0.96 and land at "B5" on a SSIM-only ladder.
 23          The palette-dE and text-diff metrics below exist to catch exactly that, and
 24          the B-level is the MINIMUM across every available signal -- so a strong
 25          structural match can no longer paper over a color or label failure.
 26  
 27      The B-level remains a prior, not a verdict: the agent's visual judgment against
 28      the B1..B5 rubric is still authoritative (a correct reproduction can score low on
 29      a stochastic embedding; a wrong one can score high). But it now fails in the safe
 30      direction.
 31  
 32  USAGE
 33      python compare_figures.py <original_image> <reproduced_image> [--attempt N] [--json]
 34                                [--out compare_figures_attemptN.png] [--no-color] [--no-text]
 35  
 36      --attempt   Render-attempt number. Used for distinct default output names. When
 37                  omitted, it is inferred from a reproduced filename containing attemptN.
 38      --out       Where to write the three-panel (target | reproduced | overlay) PNG.
 39                  Default: beside the reproduction as compare_figures_attemptN.png.
 40      --json      Emit all metrics as machine-readable JSON instead of prose.
 41      --no-color  Skip the palette comparison (e.g. an intentionally grayscale target).
 42      --no-text   Skip the OCR text diff (faster; also silences the tesseract hint).
 43  
 44  PORTABILITY
 45      Part of the 'figure-reproduce' skill: a single self-contained file with NO
 46      dependency on any project package. It runs anywhere Pillow + numpy are present.
 47      scikit-image (SSIM), opencv (ORB), and imagehash (pHash) are optional enhancers;
 48      when absent the script uses built-in numpy fallbacks or skips that metric with a
 49      one-line install hint.
 50  """
 51  
 52  from __future__ import annotations
 53  
 54  import argparse
 55  import json
 56  import re
 57  import sys
 58  from pathlib import Path
 59  
 60  # --- Mandatory deps: Pillow + numpy. Everything else is optional. -----------------
 61  try:
 62      import numpy as np
 63      from PIL import Image
 64  except ImportError as exc:  # pragma: no cover - hard requirement
 65      sys.stderr.write(
 66          f"FATAL: this script needs numpy and Pillow ({exc}). "
 67          "Install with: pip install numpy Pillow\n"
 68      )
 69      sys.exit(2)
 70  
 71  
 72  # ---------------------------------------------------------------------------------
 73  # Image loading helpers
 74  # ---------------------------------------------------------------------------------
 75  def load_rgb(path: str) -> Image.Image:
 76      """Open an image as RGB, or exit non-zero on a real usage error (bad path)."""
 77      try:
 78          return Image.open(path).convert("RGB")
 79      except (FileNotFoundError, OSError) as exc:
 80          sys.stderr.write(f"ERROR: cannot read image '{path}': {exc}\n")
 81          sys.exit(2)
 82  
 83  
 84  def to_gray_array(img: Image.Image, size: int = 512) -> np.ndarray:
 85      """Grayscale, resized to size x size, as float64 in [0, 255]."""
 86      gray = img.convert("L").resize((size, size), Image.BILINEAR)
 87      return np.asarray(gray, dtype=np.float64)
 88  
 89  
 90  # ---------------------------------------------------------------------------------
 91  # pHash: prefer imagehash, else a compact 8x8 DCT perceptual hash
 92  # ---------------------------------------------------------------------------------
 93  def _dct_1d(matrix: np.ndarray) -> np.ndarray:
 94      """Type-II DCT applied along the last axis (no scipy needed)."""
 95      n = matrix.shape[-1]
 96      k = np.arange(n)
 97      # basis[u, x] = cos(pi/N * (x + 0.5) * u)
 98      basis = np.cos(np.pi / n * (k[:, None] + 0.5) * k[None, :])
 99      return matrix @ basis.T
100  
101  
102  def phash_bits(img: Image.Image, hash_size: int = 8, highfreq_factor: int = 4) -> np.ndarray:
103      """Compact DCT-based 64-bit perceptual hash returned as a boolean array."""
104      img_size = hash_size * highfreq_factor
105      pixels = np.asarray(
106          img.convert("L").resize((img_size, img_size), Image.BILINEAR),
107          dtype=np.float64,
108      )
109      # 2D DCT = 1D DCT on rows then on columns.
110      dct = _dct_1d(_dct_1d(pixels).T).T
111      low = dct[:hash_size, :hash_size]  # keep the low-frequency top-left block
112      med = np.median(low[1:, 1:])  # exclude the DC term (low[0,0]) from the median
113      return (low > med).flatten()
114  
115  
116  def phash_hamming(orig: Image.Image, repro: Image.Image) -> tuple[int, str]:
117      """Return (hamming_distance, path_label). Prefers the imagehash library."""
118      try:
119          import imagehash
120  
121          h1 = imagehash.phash(orig)
122          h2 = imagehash.phash(repro)
123          return int(h1 - h2), "imagehash"
124      except ImportError:
125          b1 = phash_bits(orig)
126          b2 = phash_bits(repro)
127          return int(np.count_nonzero(b1 != b2)), "numpy-dct-fallback"
128  
129  
130  # ---------------------------------------------------------------------------------
131  # SSIM: prefer skimage, else a windowed numpy fallback
132  # ---------------------------------------------------------------------------------
133  def _ssim_numpy(a: np.ndarray, b: np.ndarray, win: int = 7) -> float:
134      """Windowed mean/variance/covariance SSIM (Wang et al. 2004) in pure numpy.
135  
136      Uses a uniform (box) sliding window of size `win`; constants match the standard
137      SSIM formulation for an 8-bit dynamic range (L=255).
138      """
139      c1 = (0.01 * 255) ** 2
140      c2 = (0.03 * 255) ** 2
141  
142      # Sliding local statistics via a box filter implemented with cumulative sums.
143      def box_mean(x: np.ndarray) -> np.ndarray:
144          pad = win // 2
145          xp = np.pad(x, pad, mode="reflect")
146          # integral image for O(1) window sums
147          cs = np.cumsum(np.cumsum(xp, axis=0), axis=1)
148          cs = np.pad(cs, ((1, 0), (1, 0)), mode="constant")
149          h, w = x.shape
150          s = (
151              cs[win:win + h, win:win + w]
152              - cs[0:h, win:win + w]
153              - cs[win:win + h, 0:w]
154              + cs[0:h, 0:w]
155          )
156          return s / (win * win)
157  
158      mu_a = box_mean(a)
159      mu_b = box_mean(b)
160      mu_a2, mu_b2, mu_ab = mu_a * mu_a, mu_b * mu_b, mu_a * mu_b

