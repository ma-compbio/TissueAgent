705          print(f"  panel strings  : {len(spec['text']['items'])}  [{spec['text']['status']}]")
706          if spec["legend"]["box_source"].startswith("autodetected"):
707              print("  NOTE: the legend box was GUESSED. Check it with --debug-crops and")
708              print("        pass --legend-box explicitly if the entries look wrong.")
709      else:
