530  def _parse_box(s: str | None):
531      if not s:
532          return None
533      try:
534          parts = [int(round(float(v))) for v in s.split(",")]
535      except ValueError:
536          sys.stderr.write(f"ERROR: bad box '{s}' - expected x0,y0,x1,y1\n")
537          sys.exit(2)
538      if len(parts) != 4:
539          sys.stderr.write(f"ERROR: bad box '{s}' - expected 4 comma-separated numbers\n")
540          sys.exit(2)
541      x0, y0, x1, y1 = parts
542      if x1 <= x0 or y1 <= y0:
543          sys.stderr.write(f"ERROR: bad box '{s}' - need x0<x1 and y0<y1\n")
544          sys.exit(2)
545      return (x0, y0, x1, y1)
