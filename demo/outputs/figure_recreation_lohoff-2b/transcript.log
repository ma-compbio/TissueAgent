479          if labeled and order and len(labeled) != len(order):
480              # Counts differ, but labels exist: pair them by NORMALISED label rather
481              # than refusing. A near-miss is the common case (a scale bar or an
482              # orientation compass read as an extra swatch, or the figure showing
483              # classes the dataset lacks), and the paired colors are still measured.
484              by_norm = {_norm_label(e["label"]): e["hex"] for e in labeled}
485              matched = {c: by_norm[_norm_label(c)] for c in order if _norm_label(c) in by_norm}
486              if len(matched) >= max(1, int(0.8 * len(order))):
487                  mapping = matched
488                  tier, how = "3-legend", f"legend swatches in {args.reference} (matched by label)"
489                  missing = [c for c in order if c not in matched]
490                  extra = [e["label"] for e in labeled
491                           if _norm_label(e["label"]) not in {_norm_label(c) for c in order}]
492                  if missing:
493                      warnings.append(
494                          "no legend swatch matched these dataset categories: %s -- they "
495                          "are absent from colormap.yaml; plot them explicitly or exclude "
496                          "them." % ", ".join(missing))
497                  if extra:
498                      warnings.append(
499                          "legend entries with no dataset category: %s (figure shows "
