Content:
  1  #!/usr/bin/env python3
  2  """Inspect a dataset before reproducing a figure from it.
  3  
  4  Part of the 'figure-reproduce' skill. This script is portable and self-contained:
  5  it imports NO project package and has no hard dependency on any third-party library.
  6  Optional readers (pandas, anndata, pyarrow, openpyxl) are imported lazily and, when
  7  missing, the script prints a one-line install hint and degrades gracefully instead
  8  of crashing.
  9  
 10  WHAT IT DOES
 11      The "inspect the dataset" step of figure reproduction: before you plot, confirm
 12      that the fields the target figure needs actually exist. Given a dataset path, it
 13      prints the structure so you know what you can color / plot by, and explicitly
 14      flags CANDIDATE COLOR / CATEGORY / COORDINATE / EMBEDDING fields.
 15  
 16  SUPPORTED FORMATS (detected by extension)
 17      .h5ad            AnnData  (needs `anndata`)
 18      .csv/.tsv/.txt   table    (pandas if present, else stdlib csv)
 19      .parquet         table    (needs pandas + pyarrow)
 20      .xlsx            workbook (needs pandas + openpyxl)
 21  
 22  USAGE
 23      python inspect_dataset.py DATA_PATH [--max-rows N] [--json]
 24  
 25      python inspect_dataset.py data/umap.csv
 26      python inspect_dataset.py source_data.xlsx --max-rows 3
 27      python inspect_dataset.py adata.h5ad --json
 28  """
 29  
 30  from __future__ import annotations
 31  
 32  import argparse
 33  import json
 34  import os
 35  import sys
 36  
 37  # A column whose name matches one of these is a likely plot coordinate.
 38  COORD_HINTS = ("x", "y", "umap", "tsne", "t-sne", "pca", "spatial", "coord", "dim")
 39  # .obsm keys matching these are likely 2D embeddings you can scatter-plot.
 40  EMBED_HINTS = ("umap", "tsne", "pca", "spatial", "diffmap", "phate")
 41  # Categorical columns with at most this many distinct values are good color fields.
 42  LOW_CARD_MAX = 50
 43  
 44  
 45  def hint(pkg: str) -> str:
 46      """One-line install hint for a missing optional dependency."""
 47      return f"[degraded] optional dependency '{pkg}' not installed - try: pip install {pkg}"
 48  
 49  
 50  def name_matches(name: str, hints: tuple[str, ...]) -> bool:
 51      low = str(name).lower()
 52      return any(h in low for h in hints)
 53  
 54  
 55  # --------------------------------------------------------------------------- #
 56  # AnnData (.h5ad)
 57  # --------------------------------------------------------------------------- #
 58  def inspect_h5ad(path: str, max_rows: int) -> dict:
 59      try:
 60          import anndata  # noqa: F401
 61      except ImportError:
 62          return {"format": "h5ad", "warning": hint("anndata")}
 63  
 64      import anndata as ad
 65  
 66      adata = ad.read_h5ad(path, backed="r")
 67      obs = adata.obs
 68  
 69      obs_cols = []
 70      color_fields = []
 71      for col in obs.columns:
 72          series = obs[col]
 73          dtype = str(series.dtype)
 74          info = {"name": col, "dtype": dtype}
 75          is_cat = dtype == "category" or series.dtype == object
 76          # Only compute cardinality for categorical / low-signal columns.
 77          if is_cat or series.nunique(dropna=True) <= LOW_CARD_MAX:
 78              uniques = series.dropna().unique()
 79              info["n_unique"] = int(len(uniques))
 80              info["examples"] = [str(u) for u in list(uniques)[:6]]
 81              if info["n_unique"] <= LOW_CARD_MAX:
 82                  color_fields.append(col)
 83          obs_cols.append(info)
 84  
 85      obsm_keys = list(adata.obsm.keys())
 86      embeddings = [k for k in obsm_keys if name_matches(k, EMBED_HINTS)]
 87  
 88      return {
 89          "format": "h5ad",
 90          "shape": {"n_obs": int(adata.n_obs), "n_vars": int(adata.n_vars)},
 91          "obs_columns": obs_cols,
 92          "var_names_sample": [str(v) for v in list(adata.var_names[:10])],
 93          "obsm_keys": obsm_keys,
 94          "layers": list(adata.layers.keys()),
 95          "uns_keys": list(adata.uns.keys()),
 96          "candidate_color_fields": color_fields,
 97          "candidate_embeddings": embeddings,
 98      }
 99  
100  
101  # --------------------------------------------------------------------------- #
102  # Tables (.csv / .tsv / .txt / .parquet / .xlsx)
103  # --------------------------------------------------------------------------- #
104  def _dataframe_summary(df, max_rows: int) -> dict:
105      """Summarise a single pandas DataFrame (shape, columns, head, candidates)."""
106      coord_cols = [c for c in df.columns if name_matches(c, COORD_HINTS)]
107      category_cols = []
108      columns = []
109      for col in df.columns:
110          dtype = str(df[col].dtype)
111          columns.append({"name": str(col), "dtype": dtype})
112          is_stringy = dtype == "object" or dtype.startswith("category")
113          if is_stringy or df[col].nunique(dropna=True) <= LOW_CARD_MAX:
114              if df[col].nunique(dropna=True) <= LOW_CARD_MAX:
115                  category_cols.append(str(col))
116      head = df.head(max_rows).astype(str).values.tolist()
117      return {
118          "shape": {"rows": int(df.shape[0]), "cols": int(df.shape[1])},
119          "columns": columns,
120          "head": {"header": [str(c) for c in df.columns], "rows": head},
121          "candidate_coordinate_columns": coord_cols,
122          "candidate_category_columns": category_cols,
123      }
124  
125  
126  def inspect_table_pandas(path: str, ext: str, max_rows: int) -> dict:
127      import pandas as pd
128  
129      if ext == ".parquet":
130          try:
131              df = pd.read_parquet(path)
132          except ImportError:
133              return {"format": "parquet", "warning": hint("pyarrow")}
134          out = _dataframe_summary(df, max_rows)
135          out["format"] = "parquet"
136          return out
137  
138      if ext == ".xlsx":
139          try:
140              book = pd.read_excel(path, sheet_name=None)  # dict of {sheet: df}
141          except ImportError:
142              return {"format": "xlsx", "warning": hint("openpyxl")}
143          sheets = {name: _dataframe_summary(df, max_rows) for name, df in book.items()}
144          return {"format": "xlsx", "sheet_names": list(book.keys()), "sheets": sheets}
145  
146      sep = "\t" if ext in (".tsv", ".txt") else ","
147      df = pd.read_csv(path, sep=sep)
148      out = _dataframe_summary(df, max_rows)
149      out["format"] = "delimited"
150      return out
151  
152  
153  def inspect_table_stdlib(path: str, ext: str, max_rows: int) -> dict:
154      """Fallback CSV/TSV reader using only the standard library (no pandas)."""
155      import csv
156  
157      delim = "\t" if ext in (".tsv", ".txt") else ","
158      with open(path, newline="", encoding="utf-8", errors="replace") as fh:
159          reader = csv.reader(fh, delimiter=delim)
160          rows = list(reader)

