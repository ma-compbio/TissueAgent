# workspace/: keep the high-level folder skeleton tracked (via .gitkeep),
# but ignore everything users / agents put inside at runtime — project
# runs, library uploads, scratch drafts, in-flight plan files.
projects/
plan_scratch/
workspace/**
!workspace/
!workspace/library/
!workspace/library/datasets/
!workspace/library/files/
!workspace/projects/
!workspace/scratch/
!workspace/scratch/uploads/
!workspace/scratch/attachments/
!workspace/plan_scratch/
!workspace/notebook/
!workspace/**/.gitkeep
eval/
temp/
test/
sessions/

